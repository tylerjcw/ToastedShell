<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Toast.Stdlib\Toast.Stdlib.csproj" />
    <ProjectReference Include="..\Tosh.Language\Tosh.Language.csproj" />
    <ProjectReference Include="..\Tosh.Runtime\Tosh.Runtime.csproj" />
    <ProjectReference Include="..\Tosh.Tui\Tosh.Tui.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tosh.Stdlib</RootNamespace>
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Tosh.Stdlib</PackageId>
    <Description>Built-in command library for TōSh — filesystem, text, data, networking, and shell builtins registered via the runtime.</Description>
  </PropertyGroup>

</Project>
