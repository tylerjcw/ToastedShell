<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tome</AssemblyName>
    <RootNamespace>Tosh.Tome</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Tōme — a terminal text editor built on TōSh's TUI primitives. Pairs with the TōSh shell but ships as its own binary.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Tui\Tosh.Tui.csproj" />
    <ProjectReference Include="..\Tosh.Language\Tosh.Language.csproj" />
    <ProjectReference Include="..\Tosh.LanguageServices\Tosh.LanguageServices.csproj" />
  </ItemGroup>

</Project>
