<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Language\Tosh.Language.csproj" />
    <ProjectReference Include="..\Tosh.Runtime\Tosh.Runtime.csproj" />
    <ProjectReference Include="..\Tosh.Stdlib\Tosh.Stdlib.csproj" />
    <ProjectReference Include="..\Tosh.Tui\Tosh.Tui.csproj" />
    <ProjectReference Include="..\Tosh.Compiler\Tosh.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Reflection.MetadataLoadContext"
               HintPath="$(MSBuildSDKsPath)\..\System.Reflection.MetadataLoadContext.dll"
               Private="true" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Runs the ToastScript sync with the binary this build just produced, which is
    the point: the shell's own tooling is written in its own language, and a
    build exercises it. It replaces a Python script that did the same work —
    both existed and both were live, the Python reached from here and the port
    reached from `build.tosh`, so the two ran from different entry points and
    could drift without anything noticing (`TS-P2-10`).
  -->
  <Target Name="SyncVsCodeExtension"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(DisableToshVsCodeExtensionSync)' != 'true' and Exists('$(MSBuildProjectDirectory)/../../scripts/sync_vscode_extension.tosh')">
    <Exec Command="&quot;$(TargetDir)$(AssemblyName)&quot; --safe &quot;$(MSBuildProjectDirectory)/../../scripts/sync_vscode_extension.tosh&quot; --quiet"
          WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

</Project>
