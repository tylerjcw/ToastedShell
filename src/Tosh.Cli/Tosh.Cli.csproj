<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Language\Tosh.Language.csproj" />
    <ProjectReference Include="..\Tosh.Runtime\Tosh.Runtime.csproj" />
    <ProjectReference Include="..\Tosh.Stdlib\Tosh.Stdlib.csproj" />
    <ProjectReference Include="..\Tosh.Tui\Tosh.Tui.csproj" />
    <ProjectReference Include="..\Tosh.Compiler\Tosh.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.HostModel" Version="5.0.0-preview.1.20120.5" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ToshPythonCommand Condition="'$(OS)' == 'Windows_NT'">py -3</ToshPythonCommand>
    <ToshPythonCommand Condition="'$(OS)' != 'Windows_NT'">python3</ToshPythonCommand>
  </PropertyGroup>

  <Target Name="SyncVsCodeExtension"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(DisableToshVsCodeExtensionSync)' != 'true' and Exists('$(MSBuildProjectDirectory)/../../scripts/sync_vscode_extension.py')">
    <Exec Command="$(ToshPythonCommand) &quot;$(MSBuildProjectDirectory)/../../scripts/sync_vscode_extension.py&quot; --quiet"
          WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

</Project>
