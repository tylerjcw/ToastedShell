<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>crumb</AssemblyName>
    <RootNamespace>Tosh.Crumb</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Crumb — a TōSh-native pacman + AUR wrapper. Speaks pretty tables to TTYs and NDJSON to pipes so it slots into ToSh pipelines.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Client\Tosh.Client.csproj" />
    <!-- The config file is ToastScript, so Crumb evaluates it with the real engine
         rather than parsing a format of its own. ~3.5 MB against an 80 MB
         self-contained binary, and the tool is a TōSh companion already. -->
    <ProjectReference Include="..\Tosh.Language\Tosh.Language.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tosh.Tests" />
  </ItemGroup>

</Project>
