<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>crumb</AssemblyName>
    <RootNamespace>Tosh.Crumb</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Crumb — a TōSh-native pacman + AUR wrapper. Speaks pretty tables to TTYs and NDJSON to pipes so it slots into ToSh pipelines.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Client\Tosh.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tosh.Tests" />
  </ItemGroup>

</Project>
