<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Compiler.IR\Tosh.Compiler.IR.csproj" />
    <ProjectReference Include="..\Tosh.Runtime\Tosh.Runtime.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test project assert on internal semantic primitives —
         notably the annotated-conversion drift guard, which runs one
         corpus through both the sync and async conversion paths
         (TS-P1-24). Matches Tosh.Client / Tosh.Cli / Tosh.Crumb. -->
    <InternalsVisibleTo Include="Tosh.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Tosh.Language</PackageId>
    <Description>TōSh language frontend: lexer, parser, evaluator (ToshEngine), and AST. Used for embedding tosh evaluation or building tooling.</Description>
  </PropertyGroup>

</Project>
