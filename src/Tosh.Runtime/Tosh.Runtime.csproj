<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `TOAST-0006`. The shell half of what used to be one assembly: display, help, jobs,
    session configuration and the composition root. It references the language half; nothing
    goes back the other way, and that direction is now enforced by this project reference
    rather than by inspection.

    Consumers that want both keep referencing this project and get `Toast.Runtime`
    transitively, so the split cost them no change. `Tosh.Language` references
    `Toast.Runtime` directly, which is the whole point of the division.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Toast.Runtime\Toast.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tosh.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tosh.Runtime</RootNamespace>
    <AssemblyName>Tosh.Runtime</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Tosh.Runtime</PackageId>
    <Description>TōSh shell services: the display engine, help catalog, job table, session configuration and the runtime composition root.</Description>
  </PropertyGroup>

</Project>
