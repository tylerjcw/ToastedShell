<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Tui\Tosh.Tui.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tosh.Runtime</RootNamespace>
    <AssemblyName>Tosh.Runtime</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Tosh.Runtime</PackageId>
    <Description>Core runtime types and services for TōSh: object model, pipelines, environment, and host APIs consumed by compiled tosh assemblies.</Description>
  </PropertyGroup>

</Project>
