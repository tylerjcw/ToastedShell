<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Compiler.IR\Tosh.Compiler.IR.csproj" />
    <ProjectReference Include="..\Tosh.Language\Tosh.Language.csproj" />
    <ProjectReference Include="..\Tosh.Runtime\Tosh.Runtime.csproj" />
    <ProjectReference Include="..\Tosh.Compiler.Runtime\Tosh.Compiler.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Still the host SDK's copy, because there is no alternative: Microsoft.NET.HostModel
      stops at 5.0.0-preview on nuget.org and is shipped only inside the SDK. It therefore
      carries the cross-RID defect TOSH-0008 describes, narrowed to the apphost and bundle
      paths in ToshPublisher rather than to every compile. See that item.
    -->
    <Reference Include="Microsoft.NET.HostModel"
               HintPath="$(MSBuildSDKsPath)\..\Microsoft.NET.HostModel.dll"
               Private="true" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
