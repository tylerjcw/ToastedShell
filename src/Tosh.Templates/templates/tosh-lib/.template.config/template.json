{
    "$schema": "http://json.schemastore.org/template",
    "author": "Tosh contributors",
    "classifications": [
        "Tosh",
        "ToastedShell",
        "Library"
    ],
    "name": "TōSh Library",
    "description": "A TōSh class library that compiles to a .NET assembly via Tosh.Sdk.",
    "identity": "Tosh.Templates.Lib",
    "groupIdentity": "Tosh.Templates.Lib",
    "shortName": "tosh-lib",
    "tags": {
        "language": "tosh",
        "type": "project"
    },
    "sourceName": "ToshLibrary1",
    "preferNameDirectory": true,
    "primaryOutputs": [
        {
            "path": "ToshLibrary1.toshproj"
        },
        {
            "path": "Library.tosh"
        }
    ],
    "symbols": {
        "Framework": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "net10.0",
                    "description": ".NET 10"
                }
            ],
            "defaultValue": "net10.0",
            "description": "The target framework for the project.",
            "replaces": "net10.0"
        },
        "ToshSdkVersion": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "26.5.2.10",
            "description": "Version of the Tosh.Sdk MSBuild SDK to reference.",
            "replaces": "TOSH_SDK_VERSION"
        }
    }
}