<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `dotnet new` template package that ships the `tosh-lib` and `tosh-app`
    templates. Installed by users via:

        dotnet new install Tosh.Templates

    after which `dotnet new tosh-lib` and `dotnet new tosh-app` scaffold
    new projects backed by Tosh.Sdk.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128;NU5100;CS2008;CS8021</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Tosh.Templates</PackageId>
    <PackageType>Template</PackageType>
    <!-- Template pack: content-only, no code DLL of its own to symbolise. -->
    <IncludeSymbols>false</IncludeSymbols>
    <Description>`dotnet new` templates for TōSh: `tosh-lib` (library) and `tosh-app` (executable).</Description>
    <PackageTags>tosh;toastedshell;template;dotnet-new</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack every file under templates/ into content/templates/ inside the nupkg. -->
    <Content Include="templates\**\*"
             Exclude="templates\**\bin\**;templates\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <!--
    A scaffolded project targets whatever these template files say, and they are read by
    `dotnet new` outside this repo where Directory.Build.props does not reach — so, like the
    shipped SDK's own defaults, the value has to be written out rather than derived.

    Written out and then forgotten is the failure this prevents. `dotnet new tosh-app` would
    go on scaffolding projects for a framework the repository had left, and nothing would say
    so until someone tried to build one. Change ToshDotNetMajor and the build names the file
    that is behind instead.
  -->
  <Target Name="_ToshTemplatesCheckTargetFramework" BeforeTargets="Build">
    <ItemGroup>
      <_ToshTemplateFrameworkFile Include="templates\tosh-app\ToshApp1.toshproj" />
      <_ToshTemplateFrameworkFile Include="templates\tosh-lib\ToshLibrary1.toshproj" />
      <_ToshTemplateFrameworkFile Include="templates\tosh-app\.template.config\template.json" />
      <_ToshTemplateFrameworkFile Include="templates\tosh-lib\.template.config\template.json" />
    </ItemGroup>
    <!-- ErrorAndContinue so one build names every file that is behind. Stopping at the
         first turns one bump into four builds. -->
    <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\%(_ToshTemplateFrameworkFile.Identity)').Contains('$(ToshTargetFramework)'))"
           ContinueOnError="ErrorAndContinue"
           Text="%(_ToshTemplateFrameworkFile.Identity) does not mention $(ToshTargetFramework). ToshDotNetMajor moved and this template did not: `dotnet new` would keep scaffolding projects for a framework this repository has left." />
  </Target>

</Project>
