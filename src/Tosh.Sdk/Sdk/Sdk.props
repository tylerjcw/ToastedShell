<Project DefaultTargets="Build">

  <!-- ════════════════════════════════════════════════════════════
       Tosh.Sdk — MSBuild SDK for compiling .tosh source files into
       .NET assemblies via the toshc compiler.

       Usage (in a .toshproj):

         <Project Sdk="Tosh.Sdk">
           <PropertyGroup>
             <TargetFramework>net10.0</TargetFramework>
           </PropertyGroup>
         </Project>

       By default, every .tosh file alongside the project is
       automatically included as a compile input. Disable with
       <EnableDefaultToshItems>false</EnableDefaultToshItems>.
       ════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <ToshSdkRoot>$(MSBuildThisFileDirectory)..\</ToshSdkRoot>
    <DefaultLanguageSourceExtension>.tosh</DefaultLanguageSourceExtension>
    <EnableDefaultToshItems Condition="'$(EnableDefaultToshItems)' == ''">true</EnableDefaultToshItems>
    <OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath Condition="'$(AppendTargetFrameworkToOutputPath)' == ''">true</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">bin\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj\</BaseIntermediateOutputPath>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath Condition="'$(OutputPath)' == ''">$(MSBuildProjectDirectory)\$(BaseOutputPath)$(Configuration)\$(TargetFramework)\</OutputPath>
    <IntermediateOutputPath Condition="'$(IntermediateOutputPath)' == ''">$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <PublishDir Condition="'$(PublishDir)' == ''">$(OutputPath)publish\</PublishDir>

    <!-- Compile profile passed to toshc. permissive | runtime | pure -->
    <ToshCompileProfile Condition="'$(ToshCompileProfile)' == ''">permissive</ToshCompileProfile>

    <!-- When true, suppress tosh.compile.implicit_dynamic errors. -->
    <ToshAllowDynamic Condition="'$(ToshAllowDynamic)' == ''">false</ToshAllowDynamic>

    <!-- When true, emit a sibling reference assembly
         (<AssemblyName>.ref.dll) stamped with [ReferenceAssembly]. -->
    <ToshEmitReferenceAssembly Condition="'$(ToshEmitReferenceAssembly)' == '' and '$(ToshEmitRefasm)' != ''">$(ToshEmitRefasm)</ToshEmitReferenceAssembly>
    <ToshEmitReferenceAssembly Condition="'$(ToshEmitReferenceAssembly)' == ''">false</ToshEmitReferenceAssembly>

    <!-- When true (default for OutputType=Exe), emit an apphost wrapper
         executable alongside the DLL. The wrapper is <name>.exe on Windows,
         <name> (no extension, marked executable) on Unix. -->
    <ToshEmitAppHost Condition="'$(ToshEmitAppHost)' == '' and '$(OutputType)' == 'Exe'">true</ToshEmitAppHost>
    <ToshEmitAppHost Condition="'$(ToshEmitAppHost)' == ''">false</ToshEmitAppHost>

    <!-- When true, bundle the apphost with all .dll files into a single
         self-contained executable (~70MB+ with .NET runtime). Requires
         ToshEmitAppHost=true. -->
    <ToshPublishSingleFile Condition="'$(ToshPublishSingleFile)' == ''">false</ToshPublishSingleFile>
    <ToshEmitAppHost Condition="'$(ToshPublishSingleFile)' == 'true'">true</ToshEmitAppHost>

    <!--
      Version of the Tosh.* runtime library NuGets that pack/restore
      flows depend on. Tosh.Sdk and Tosh.Runtime/Tosh.Stdlib/etc. ship
      together in lock-step, so this normally matches the SDK's own
      version. The shipped Sdk.props is rewritten by the Tosh.Sdk pack
      pipeline to set this default to the matching runtime version
      (TOSH_RUNTIME_VERSION_PLACEHOLDER below). Override per-project
      with <ToshRuntimeVersion>...</ToshRuntimeVersion>.
    -->
    <ToshRuntimeVersion Condition="'$(ToshRuntimeVersion)' == ''">TOSH_RUNTIME_VERSION_PLACEHOLDER</ToshRuntimeVersion>

    <!--
      Standard NuGet packing knobs. Defaults: pack the implementation
      DLL into lib/$(TargetFramework)/, pack the reference assembly
      (when ToshEmitReferenceAssembly=true) into ref/$(TargetFramework)/,
      and emit dependency entries for every Tosh.* runtime library so a
      consumer's `<PackageReference Include="<lib>" />` transitively pulls
      the runtime in.

      IsPackable + PackageId are finalised in Sdk.targets (after the
      project body has had a chance to set OutputType / AssemblyName).
    -->
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\</PackageOutputPath>
    <ToshIncludeRuntimeDependencies Condition="'$(ToshIncludeRuntimeDependencies)' == ''">true</ToshIncludeRuntimeDependencies>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableDefaultToshItems)' == 'true'">
    <ToshCompile Include="**\*.tosh"
                 Exclude="$(BaseOutputPath)**;$(BaseIntermediateOutputPath)**;**\bin\**;**\obj\**" />
  </ItemGroup>

</Project>
