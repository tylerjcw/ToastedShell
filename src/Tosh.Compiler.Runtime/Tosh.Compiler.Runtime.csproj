<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tosh.Runtime\Tosh.Runtime.csproj" />
    <ProjectReference Include="..\Tosh.Stdlib\Tosh.Stdlib.csproj" />
    <ProjectReference Include="..\Tosh.Language\Tosh.Language.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tosh.Compiler.Runtime</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Tosh.Compiler.Runtime</PackageId>
    <Description>Runtime support library required by IL emitted from the TōSh compiler: pipeline glue, dispatch helpers, and host bindings used by compiled .tosh assemblies.</Description>
  </PropertyGroup>

</Project>
