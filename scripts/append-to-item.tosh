## Append text to a table cell for one item. Writes to an output path; never in place.
##
## Cell indices count real separators: an escaped `\|` is content and does not open a new cell,
## and pipes in the appended text are escaped on the way in (`TS-P3-13`).
##
## Usage: append.tosh <doc> <out> <id> <cell-index> <text>
var doc  = $tosh.Script.Args[0]
var out  = $tosh.Script.Args[1]
var id   = $tosh.Script.Args[2]
var cell = ($tosh.Script.Args[3] | cast int)
var text = $tosh.Script.Args[4]

var out_lines = []
var touched = 0

for line in (read-file $doc | lines) {
    var updated = $line
    if ($line.StartsWith($"| `" + $id + "` |")) {
        # `TS-P3-13`. Split on real separators only: a `\|` inside a cell is content, and
        # splitting on it too shifted every later cell index by one — so appending to cell 3
        # wrote into the middle of a description that happened to quote a pipeline.
        var parts = (($updated.Replace("\\|", "\u0001")).Split("|"))
        $parts[$cell] = ($parts[$cell].TrimEnd() + " " + ($text.Replace("\\|", "|")).Replace("|", "\\|") + " ")
        $updated = (($parts | join "|").Replace("\u0001", "\\|"))
        $touched = ($touched + 1)
    }
    $out_lines = ($out_lines + [$updated])
}

if ($touched != 1) { throw $"expected 1 match for {$id}, found {$touched}" }
write-file $out (($out_lines | join "\n") + "\n") | ignore
echo $"touched={$touched}"
