#!/usr/bin/env tosh

## @summary TōSh Unified build system
## @example build.tosh publish
## @example build.tosh test --group lsp
## @example build.tosh --help

const DefaultDotnetMajor = 10

module Build {
    ## @summary Types for the build system
    module Types {
        ## @summary Refinement type guaranteeing a non-null, non-empty string.
        type NonEmptyString = string where (not String.IsNullOrEmpty(_))

        ## @summary Refinement type for paths that must already exist as a directory.
        type DirectoryPath = string where (is-dir _).IsDirectory

        ## @summary Refinement type for paths that must already exist as a file.
        type FilePath = string where (is-file _).IsFile
    }

    ## @summary Helper functions for the build system
    module Helpers {
        ## @summary Prints a success message with a green checkmark.
        ## @param=msg The message to display.
        ## @example Build.Helpers.Ok("Build succeeded")
        func Ok(msg: Types.NonEmptyString) => styled $"  ✓ {$msg}" --fg bright-green | writeline
            
        ## @summary Prints an informational message in dim gray.
        ## @param=msg The message to display.
        ## @example Build.Helpers.Info("Skipping cached step")
        func Info(msg: Types.NonEmptyString) => styled $"  {$msg}" --fg gray --dim | writeline
            
        ## @summary Prints a warning message with a yellow ⚠ symbol.
        ## @param=msg The message to display.
        ## @example Build.Helpers.Warn("Cap_net_raw could not be set")
        func Warn(msg: Types.NonEmptyString) => styled $"  ⚠ {$msg}" --fg yellow | writeline
            
        ## @summary Prints an error message with a red ✗ symbol.
        ## @param=msg The message to display.
        ## @example Build.Helpers.Fail("makepkg returned non-zero")
        func Fail(msg: Types.NonEmptyString) => styled $"  ✗ {$msg}" --fg bright-red --bold | writeline

        ## @summary Prints a centred, bracketed section header in bright cyan.
        ## @remarks
        ##   Output looks like `────────[ BUILD ]────────`. The total width is
        ##   constrained around 56 columns; callers with very long labels will
        ##   simply get the minimum padding (`──[ … ]──`).
        ## @param=label The text shown between the brackets.
        ## @example Build.Helpers.Sep("PUBLISH")
        func Sep(label: Types.NonEmptyString) {
            var pad = (28 - (($label | count) // 2))
            if ($pad < 2) { $pad = 2 }
            var line = $"{'─' * $pad}[ {$label} ]{'─' * $pad}"
            styled $line --fg bright-cyan --bold | writeline
        }
            
        ## @summary Asserts that the most-recent external command exited with code 0.
        ## @param=label Human-readable name of the step being asserted.
        ## @exception When `$tosh.Last.ExitCode != 0`. The thrown string embeds both the label and the numeric exit code.
        func AssertOk(label: Types.NonEmptyString) { if ($tosh.Last.ExitCode != 0) { throw $"{$label} failed (exit {$tosh.Last.ExitCode})" } }

        ## @summary Resolves the absolute path of the repository root.
        ## @returns The repository root directory as a `DirectoryPath`.
        func RepoRoot() -> Types.DirectoryPath {
            var result = (spawn git rev-parse --show-toplevel | wait-for | first)
            if ($result.ExitCode != 0) {
                throw "Run this command from inside the TōSh repository."
            }
            return ($result.Output | first).ToString().Trim()
        }

        ## @summary MSBuild switches that keep validation deterministic and side-effect free.
        func MsbuildSafetyArgs() -> array => [
            "-m:1",
            "-p:DisableToshSpecBuild=true",
            "-p:DisableToshParityCheck=true",
            "-p:DisableToshVsCodeExtensionSync=true",
        ]

        ## @summary Returns the current UTC timestamp formatted as ISO 8601.
        ## @returns Timestamp in `yyyy-MM-ddTHH:mm:ssZ` form, suitable for use as a `ts` field in JSONL history entries.
        ## @example var ts = ts_now    ## "2026-05-07T17:42:13Z"
        func TimestampNow() -> string => System.DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ")
    }

    ## Safety boundaries for paths supplied to destructive build operations.
    module Safety {
        const RuntimeIdPattern = "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"

        ## @summary Validates a Runtime Identifier before it is used in a path.
        func ValidateRuntimeId(runtimeId: string) -> string {
            if (System.String.IsNullOrWhiteSpace($runtimeId)
                or $runtimeId.Length > 100
                or not System.Text.RegularExpressions.Regex.IsMatch($runtimeId, $RuntimeIdPattern)) {
                throw $"Invalid RID '{$runtimeId}'. Use lowercase letters, digits, dots, underscores, and hyphens only."
            }
            return $runtimeId
        }

        shy func RejectUnsafeComponents(anchor: string, candidate: string) {
            var probe = $candidate
            while (true) {
                if ((is-link $probe).IsLink) {
                    throw $"Managed build path crosses a symbolic link: {$probe}"
                }
                if ((is-file $probe).IsFile) {
                    throw $"Managed build directory crosses a file: {$probe}"
                }

                if (System.IO.Path.GetRelativePath($anchor, $probe) == ".") { break }
                var parent = System.IO.Path.GetDirectoryName($probe)
                if ($parent == null or $parent == $probe) {
                    throw $"Could not prove managed-path containment for '{$candidate}'."
                }
                $probe = $parent
            }
        }

        shy func ValidateManagedDirectory(root: string, path: string, area: string) -> string {
            var artifacts = System.IO.Path.GetFullPath(($root | join -p "artifacts"))
            var allowed = System.IO.Path.GetFullPath(($artifacts | join -p $area))
            var candidate = System.IO.Path.GetFullPath($path)
            var relative = System.IO.Path.GetRelativePath($allowed, $candidate)
            var separator = System.IO.Path.DirectorySeparatorChar.ToString()
            var altSeparator = System.IO.Path.AltDirectorySeparatorChar.ToString()

            if ($relative == "."
                or $relative == ".."
                or ($relative starts-with $"..{$separator}")
                or ($relative starts-with $"..{$altSeparator}")
                or System.IO.Path.IsPathRooted($relative)) {
                throw $"Refusing unmanaged build path '{$candidate}'. Expected a child of '{$allowed}'."
            }

            RejectUnsafeComponents($artifacts, $candidate)
            return $candidate
        }

        ## @summary Returns a safe, canonical publish destination below artifacts/publish.
        func ValidatePublishDirectory(root: string, path: string) -> string {
            return ValidateManagedDirectory($root, $path, "publish")
        }

        ## @summary Returns a safe, canonical transaction directory below artifacts/staging.
        func ValidateStagingDirectory(root: string, path: string) -> string {
            return ValidateManagedDirectory($root, $path, "staging")
        }

        ## @summary Validates the stable artifacts directory used by workspace locks.
        func ValidateArtifactsDirectory(root: string) -> string {
            var artifacts = System.IO.Path.GetFullPath(($root | join -p "artifacts"))
            if ((is-link $artifacts).IsLink) {
                throw $"Refusing symbolic-link artifacts directory: {$artifacts}"
            }
            if ((is-file $artifacts).IsFile) {
                throw $"Artifacts directory is a file: {$artifacts}"
            }
            return $artifacts
        }

        func DeleteStagingDirectory(root: string, path: string) {
            var safePath = ValidateStagingDirectory($root, $path)
            if ((is-dir $safePath).IsDirectory) {
                System.IO.Directory.Delete($safePath, true)
            }
        }
    }

    ## A process-tree-aware, OS-backed lock for workspace-mutating operations.
    module WorkspaceLock {
        func OwnerPath(root: string) -> string => $root | join -p "artifacts" ".build.lock.owner"

        func CreateOwnerToken() -> string {
            var pid = System.Environment.ProcessId
            var started = System.Diagnostics.Process.GetProcessById($pid).StartTime.ToUniversalTime().Ticks
            return $"{$pid}:{$started}:{System.Guid.NewGuid().ToString("N")}"
        }

        func IsActiveInheritedLease(root: string, token: string) -> bool {
            if ($token == "") { return false }
            var ownerPath = OwnerPath($root)
            if (not (is-file $ownerPath).IsFile or (is-link $ownerPath).IsLink) { return false }

            try {
                var activeToken = System.IO.File.ReadAllText($ownerPath).Trim()
                if ($activeToken == "" or $activeToken != $token) { return false }

                var parts = $activeToken.Split(":".ToCharArray())
                if ($parts.Length != 3) { return false }
                var ownerPid = System.Convert.ToInt32($parts[0])
                var ownerStarted = System.Convert.ToInt64($parts[1])
                var process = System.Diagnostics.Process.GetProcessById($ownerPid)
                var startDelta = ($process.StartTime.ToUniversalTime().Ticks - $ownerStarted)
                if ($startDelta < 0) { $startDelta = -$startDelta }
                return (not $process.HasExited and $startDelta <= System.TimeSpan.TicksPerSecond)
            } catch {
                return false
            }
        }

        sealed class Lease {
            prop Handle: object? = null
            prop OwnsLock: bool = false
            prop PreviousToken: string = ""
            prop Token: string = ""
            prop OwnerFile: string = ""

            Lease(root: string, operation: string) {
                var artifacts = Safety.ValidateArtifactsDirectory($root)
                mkdir -p $artifacts | ignore
                Safety.ValidateArtifactsDirectory($root) | ignore

                $this.PreviousToken = ($env.TOSH_REWRITTEN_BUILD_LOCK_TOKEN ?? "")
                if (not (IsActiveInheritedLease($root, $this.PreviousToken))) {
                    # Keep this sentinel permanently: unlinking a held lock can split ownership across inodes.
                    var lockPath = $artifacts | join -p ".build.lock"
                    $this.OwnerFile = OwnerPath($root)
                    mkdir -p (dirname $lockPath) | ignore
                    if ((is-link $lockPath).IsLink or (is-link $this.OwnerFile).IsLink) {
                        throw $"Refusing symbolic-link build lock state under {dirname $lockPath}."
                    }
                    try {
                        $this.Handle = new System.IO.FileStream(
                            $lockPath,
                            System.IO.FileMode.OpenOrCreate,
                            System.IO.FileAccess.ReadWrite,
                            System.IO.FileShare.None)
                        $this.Token = CreateOwnerToken()
                        System.IO.File.WriteAllText($this.OwnerFile, $this.Token)
                    } catch ($error) {
                        if ($this.Handle != null) { $this.Handle.Dispose() | ignore }
                        $this.Handle = null
                        throw $"Could not acquire the build lock for '{$operation}' at '{$lockPath}'. Another build may be running, or the lock path is unavailable."
                    }

                    $this.OwnsLock = true
                    $env.TOSH_REWRITTEN_BUILD_LOCK_TOKEN = $this.Token
                }
            }

            func Dispose() {
                if (not $this.OwnsLock) { return }
                try {
                    $env.TOSH_REWRITTEN_BUILD_LOCK_TOKEN = $this.PreviousToken
                    try {
                        if ((is-file $this.OwnerFile).IsFile
                            and not (is-link $this.OwnerFile).IsLink
                            and System.IO.File.ReadAllText($this.OwnerFile).Trim() == $this.Token) {
                            System.IO.File.WriteAllText($this.OwnerFile, "")
                        }
                    } catch { }
                } finally {
                    if ($this.Handle != null) { $this.Handle.Dispose() | ignore }
                    $this.OwnsLock = false
                }
            }
        }

        func Acquire(root: string, operation: string) -> Lease {
            return new Lease($root, $operation)
        }
    }

    ## Functions that deal with build script history
    module History {
        ## @summary Resolves the absolute path of the JSONL history file.
        ## @param=root The repository root.
        ## @returns Absolute path to `<root>/artifacts/history.jsonl`.
        ##   The file is *not* created by this call — `AppendLine` is
        ##   responsible for ensuring the parent directory exists.
        func GetPath(root: Types.DirectoryPath) -> string => $root | join -p "artifacts" "history.jsonl"

        ## @summary Appends a single JSONL line to the build history file.
        ## @param=root The repository root.
        ## @param=line A single line of JSON (no embedded newlines).
        ## @example Build.History.AppendLine($root, ($entry | to json).Replace("\n", ""))
        func AppendLine(root: Types.DirectoryPath, line: Types.NonEmptyString) {
            var path = GetPath $root
            mkdir -p (dirname $path) | ignore
            echo $line out>> $path
        }

        ## @summary Reads the most-recent history entry of a given kind.
        ## @param=root The repository root.
        ## @param=kind The record kind to filter on (e.g. `"test"`, `"bench"`).
        ## @returns The matching JSONL line, or `null` when no history file exists or when no entry of the given kind has been recorded yet.
        func ReadLast(root: Types.DirectoryPath, kind: Types.NonEmptyString) -> string? {
            var path = (GetPath $root)
            if (not ((is-file $path).IsFile)) { return null }

            var last = null
            for line in (cat $path | lines) {
                if ($line =~ $"\"kind\":\\s*\"{$kind}\"") { $last = $line }
            }

            return $last
        }
    }

    module Publish {
        record State(CalVer: string, Publish: int, DotnetMajor: int)

        func ReadState(path: string) -> State {
            var line = (cat $path | lines | first)
            var parts = ($line.Split(":"))
            if ($parts.Length < 2) { throw $".tosh-publish-state is corrupt: {$line}" }
            var calver = $parts[0]
            var num = System.Convert.ToInt32($parts[1])
            var dotnet = ($parts.Length >= 3 ? System.Convert.ToInt32($parts[2]) : $DefaultDotnetMajor)
            return new State($calver, $num, $dotnet)
        }

        func WriteState(path: string, calver: string, num: int, dotnet: int) {
            write-file $path $"{$calver}:{$num}:{$dotnet}" | ignore
        }

        func GetVersion(state: State) -> string => $"{$state.CalVer}.{$state.Publish}.{$state.DotnetMajor}"

        func GetSemver(state: State) -> string => $"{$state.CalVer}.{$state.Publish}"

        func CurrentCalVer() -> string => System.DateTime.UtcNow.ToString("yy.M")

        func ParseCalVer(calver: string) -> array {
            var parts = ($calver.Split(".".ToCharArray()))
            if ($parts.Length != 2) { throw $"calver '{$calver}' is not in YY.M form" }
            return [System.Convert.ToInt32($parts[0]), System.Convert.ToInt32($parts[1])]
        }

        func UpdatePkgbuild(path: string, version: string) {
            read-file $path
                | replace -r "pkgver=.*" $"pkgver={$version}"
                | write-file $path
                | ignore
        }

        func ExtensionPackagePath(root: string) -> string {
            return $root | join -p "editor" "vscode" "tosh.tosh-lang" "package.json"
        }

        func ExtensionPackageLockPath(root: string) -> string {
            return $root | join -p "editor" "vscode" "tosh.tosh-lang" "package-lock.json"
        }

        func UpdateExtensionVersion(root: string, state: State) {
            var packageJson = ExtensionPackagePath($root)
            if (not (is-file $packageJson).IsFile) {
                throw $"Extension package.json not found at {$packageJson}."
            }
            var packageLock = ExtensionPackageLockPath($root)
            if (not (is-file $packageLock).IsFile) {
                throw $"Extension package-lock.json not found at {$packageLock}."
            }

            var desired = GetSemver($state)
            var package = read-file $packageJson | from json
            var lockDocument = System.Text.Json.JsonDocument.Parse((read-file $packageLock))
            var lockVersion = ""
            var lockRootVersion = ""
            try {
                $lockVersion = $lockDocument.RootElement.GetProperty("version").GetString()
                var lockPackages = $lockDocument.RootElement.GetProperty("packages")
                var lockRootPackage = $lockPackages.GetProperty("")
                $lockRootVersion = $lockRootPackage.GetProperty("version").GetString()
            } finally {
                $lockDocument.Dispose() | ignore
            }
            if ($package.version == $desired
                and $lockVersion == $desired
                and $lockRootVersion == $desired) { return }

            var previous = (pwd).FullName
            cd (dirname $packageJson) | ignore
            try {
                npm pkg set $"version={$desired}" | ignore
                Helpers.AssertOk("npm pkg set version")
                # npm 12 no longer updates package-lock.json as a side effect of
                # `npm pkg set`; explicitly reconcile both lockfile version fields.
                npm install --package-lock-only --ignore-scripts --no-audit --no-fund | ignore
                Helpers.AssertOk("npm package-lock version sync")
            } finally {
                cd $previous | ignore
            }
            Helpers.Ok($"Synced extension version → {$desired}")
        }

        func VerifyReleaseMetadata(root: string, expectedState: State) {
            var expectedVersion = GetVersion($expectedState)
            var statePath = $root | join -p ".tosh-publish-state"
            var actualState = ReadState($statePath)
            var actualVersion = GetVersion($actualState)
            if ($actualVersion != $expectedVersion) {
                throw $"Publish state does not contain expected version {$expectedVersion}."
            }

            var pkgbuildPath = $root | join -p "packaging" "archlinux" "PKGBUILD"
            var pkgverLines = cat $pkgbuildPath
                | lines
                | where { ($_ as string) starts-with "pkgver=" }
                | collect
            if (($pkgverLines | count) != 1
                or ($pkgverLines | first).ToString().Trim() != $"pkgver={$expectedVersion}") {
                throw $"PKGBUILD does not contain exactly one pkgver={$expectedVersion} declaration."
            }

            var expectedExtension = GetSemver($expectedState)
            var packageJson = ExtensionPackagePath($root)
            var packageLock = ExtensionPackageLockPath($root)
            var package = read-file $packageJson | from json
            if ($package.version != $expectedExtension) {
                throw $"Extension package.json version is '{$package.version}', expected '{$expectedExtension}'."
            }

            var lockDocument = System.Text.Json.JsonDocument.Parse((read-file $packageLock))
            try {
                var lockVersion = $lockDocument.RootElement.GetProperty("version").GetString()
                var lockPackages = $lockDocument.RootElement.GetProperty("packages")
                var lockRootPackage = $lockPackages.GetProperty("")
                var lockRootVersion = $lockRootPackage.GetProperty("version").GetString()
                if ($lockVersion != $expectedExtension or $lockRootVersion != $expectedExtension) {
                    throw $"Extension lock versions do not both equal '{$expectedExtension}'."
                }
            } finally {
                $lockDocument.Dispose() | ignore
            }
        }

        sealed class Plan {
            prop Trimmed: bool = false
            prop SelfContained: bool = true
            prop NoInstall: bool = false
            prop NoBump: bool = false
            prop PublishReadyToRun: bool = true
            prop BuildArtifactsDirectory: string = ""

            shy prop _runtimeId: string? = null
            shy prop _directory: string? = null
            shy prop _workingDirectory: string? = null
            shy prop _binary: string? = null

            prop RepoRoot: string { get => Helpers.RepoRoot() }

            prop RuntimeId: string {
                get => ($this._runtimeId ?? System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier)
                set => $this._runtimeId = $value
            }

            prop ModeDirectory: string {
                get => ($this.Trimmed
                    ? "single-file-trimmed"
                    : ($this.SelfContained ? "single-file" : "single-file-framework-dependent"))
            }

            prop Directory: string {
                get => $this.ResolveDirectory()
                set => $this._directory = $value
            }

            prop WorkingDirectory: string {
                get => ($this._workingDirectory ?? $this.Directory)
                set => $this._workingDirectory = $value
            }

            prop Binary: string? {
                get => $this._binary
                set => $this._binary = $value
            }

            Plan() {}

            func PublishArgs(project: string) -> array {
                return $this.MakePublishArgs($project)
            }

            shy func ResolveDirectory() -> string {
                if ($this._directory != null and $this._directory != "") {
                    return System.IO.Path.GetFullPath($this._directory)
                }
                return $this.RepoRoot
                    | join -p "artifacts" "publish" $this.RuntimeId $this.ModeDirectory
            }

            shy func MakePublishArgs(project: string) -> array {
                if (System.String.IsNullOrWhiteSpace($this.BuildArtifactsDirectory)) {
                    throw "Publish build artifacts directory has not been configured."
                }
                var safetyArgs = Helpers.MsbuildSafetyArgs()
                var args = [
                    "publish", $"{$this.RepoRoot}/src/{$project}/{$project}.csproj",
                    "-c", "Release", "-r", $this.RuntimeId,
                    "-o", $this.WorkingDirectory,
                    "--artifacts-path", $this.BuildArtifactsDirectory,
                    "--no-restore",
                    "-p:PublishSingleFile=true",
                    $"-p:PublishReadyToRun={$this.PublishReadyToRun}",
                    "-p:IncludeAllContentForSelfExtract=true",
                    "-p:EnableCompressionInSingleFile=false",
                    "-p:DebugType=None",
                    "-p:DebugSymbols=false",
                    $"-p:SelfContained={$this.SelfContained}",
                    ...$safetyArgs,
                ]
                if ($this.Trimmed) {
                    $args = [...$args, "-p:PublishTrimmed=true", "-p:TrimMode=partial"]
                }
                return $args
            }
        }

        const BundleManifestName = ".tosh-publish-manifest"

        record Artifact(
            Key: string,
            Project: string,
            PublishedName: string,
            FileName: string)

        func ReleaseArtifacts(runtimeId: string) -> array {
            var suffix = (($runtimeId starts-with "win-") ? ".exe" : "")
            return [
                new Artifact("tosh", "Tosh.Cli", $"Tosh.Cli{$suffix}", $"tosh{$suffix}"),
                new Artifact("lsp", "Tosh.Lsp", $"Tosh.Lsp{$suffix}", $"Tosh.Lsp{$suffix}"),
                new Artifact("mcp", "Tosh.Mcp", $"Tosh.Mcp{$suffix}", $"Tosh.Mcp{$suffix}"),
                new Artifact("tome", "Tosh.Tome", $"tome{$suffix}", $"tome{$suffix}"),
                new Artifact("crumb", "Tosh.Crumb", $"crumb{$suffix}", $"crumb{$suffix}"),
            ]
        }

        func NormalizePublishedArtifact(directory: string, artifact: Artifact) -> string {
            var target = $directory | join -p $artifact.FileName
            if ((is-file $target).IsFile) { return $target }

            var published = $directory | join -p $artifact.PublishedName
            if (not (is-file $published).IsFile) {
                throw $"Publish produced no {$artifact.Project} executable at {$published}."
            }
            System.IO.File.Move($published, $target, true)
            return $target
        }

        func FileSha256(path: string) -> string {
            var stream = System.IO.File.OpenRead($path)
            defer { $stream.Dispose() | ignore }
            var digest = System.Security.Cryptography.SHA256.HashData($stream)
            return System.Convert.ToHexString($digest).ToLowerInvariant()
        }

        func VerifyReleaseArtifacts(directory: string, artifacts: array) {
            for artifact in $artifacts {
                var path = $directory | join -p $artifact.FileName
                if (not (is-file $path).IsFile or (is-link $path).IsLink) {
                    throw $"Release artifact is missing or unsafe: {$path}"
                }
                var info = ls $path | first
                if ($info.Size.Bytes <= 0) { throw $"Release artifact is empty: {$path}" }
            }
        }

        func VerifyRuntimeRestore(buildArtifactsDirectory: string, runtimeId: string, artifacts: array) {
            var expectedTarget = $"net{$DefaultDotnetMajor}.0/{$runtimeId}"
            for artifact in $artifacts {
                var assetsPath = $buildArtifactsDirectory
                    | join -p "obj" $artifact.Project "project.assets.json"
                if (not (is-file $assetsPath).IsFile) {
                    throw $"Isolated restore produced no assets file for {$artifact.Project}: {$assetsPath}"
                }

                var document = System.Text.Json.JsonDocument.Parse((read-file $assetsPath))
                var found = false
                try {
                    var targets = $document.RootElement.GetProperty("targets")
                    for target in $targets.EnumerateObject() {
                        if ($target.Name == $expectedTarget) {
                            $found = true
                            break
                        }
                    }
                } finally {
                    $document.Dispose() | ignore
                }
                if (not $found) {
                    throw $"Restore assets for {$artifact.Project} do not contain '{$expectedTarget}'."
                }
            }
            Helpers.Ok($"Isolated restore assets cover all {($artifacts | count)} publish projects")
        }

        func WriteBundleManifest(directory: string, version: string, plan: Plan, artifacts: array) {
            var lines = [
                "format=2",
                $"version={$version}",
                $"rid={$plan.RuntimeId}",
                $"mode={$plan.ModeDirectory}",
                $"self_contained={$plan.SelfContained.ToString().ToLowerInvariant()}",
                $"trimmed={$plan.Trimmed.ToString().ToLowerInvariant()}",
                $"ready_to_run={$plan.PublishReadyToRun.ToString().ToLowerInvariant()}",
                "include_all_content_for_self_extract=true",
                $"dotnet_major={$DefaultDotnetMajor}",
                $"artifact_count={($artifacts | count)}",
            ]
            for artifact in $artifacts {
                var path = $directory | join -p $artifact.FileName
                var digest = FileSha256($path)
                $lines = [...$lines, $"{$artifact.Key}_sha256={$digest}"]
            }
            write-file ($directory | join -p $BundleManifestName) (($lines | join "\n") + "\n") | ignore
        }

        ## Owns the transient and rollback paths for one publish operation.
        sealed class OutputTransaction {
            prop RepoRoot: string = ""
            prop FinalDirectory: string = ""
            prop StagingRoot: string = ""
            prop StagingDirectory: string = ""
            prop PreviousDirectory: string = ""
            prop FailedDirectory: string = ""
            prop Promoted: bool = false
            prop PreviousMoved: bool = false
            prop RetainForRecovery: bool = false

            OutputTransaction(root: string, finalDirectory: string) {
                $this.RepoRoot = $root
                $this.FinalDirectory = Safety.ValidatePublishDirectory($root, $finalDirectory)

                var runId = System.Guid.NewGuid().ToString("N")
                var stagingRoot = $root | join -p "artifacts" "staging" $"publish-{$runId}"
                $this.StagingRoot = Safety.ValidateStagingDirectory($root, $stagingRoot)
                $this.StagingDirectory = $this.StagingRoot | join -p "output"
                $this.PreviousDirectory = $this.StagingRoot | join -p "previous"
                $this.FailedDirectory = $this.StagingRoot | join -p "failed-output"

                if ((is-file $this.StagingRoot).IsFile
                    or (is-dir $this.StagingRoot).IsDirectory
                    or (is-link $this.StagingRoot).IsLink) {
                    throw $"Publish transaction path already exists: {$this.StagingRoot}"
                }
                System.IO.Directory.CreateDirectory($this.StagingDirectory) | ignore
            }

            func Promote() {
                Safety.ValidatePublishDirectory($this.RepoRoot, $this.FinalDirectory) | ignore
                Safety.ValidateStagingDirectory($this.RepoRoot, $this.StagingRoot) | ignore

                if ((is-file $this.FinalDirectory).IsFile) {
                    throw $"Publish destination is a file: {$this.FinalDirectory}"
                }
                if (not (is-dir $this.StagingDirectory).IsDirectory) {
                    throw $"Publish staging output is missing: {$this.StagingDirectory}"
                }

                var parent = System.IO.Path.GetDirectoryName($this.FinalDirectory)
                if ($parent == null) { throw $"Publish destination has no parent: {$this.FinalDirectory}" }
                System.IO.Directory.CreateDirectory($parent) | ignore

                if ((is-dir $this.FinalDirectory).IsDirectory) {
                    System.IO.Directory.Move($this.FinalDirectory, $this.PreviousDirectory)
                    $this.PreviousMoved = true
                }

                try {
                    System.IO.Directory.Move($this.StagingDirectory, $this.FinalDirectory)
                    $this.Promoted = true
                } catch ($promotionError) {
                    if ($this.PreviousMoved) {
                        try {
                            System.IO.Directory.Move($this.PreviousDirectory, $this.FinalDirectory)
                            $this.PreviousMoved = false
                        } catch ($restoreError) {
                            $this.RetainForRecovery = true
                            throw $"Publish promotion failed and the previous output could not be restored. Previous: {$this.PreviousDirectory}; destination: {$this.FinalDirectory}; restore error: {$restoreError}"
                        }
                    }
                    throw $promotionError
                }
            }

            func Rollback() -> bool {
                if (not $this.Promoted and not $this.PreviousMoved) { return true }

                try {
                    if ($this.Promoted) {
                        if ((is-link $this.FinalDirectory).IsLink or (is-file $this.FinalDirectory).IsFile) {
                            throw $"Committed publish destination changed type: {$this.FinalDirectory}"
                        }
                        if ((is-dir $this.FailedDirectory).IsDirectory
                            or (is-file $this.FailedDirectory).IsFile
                            or (is-link $this.FailedDirectory).IsLink) {
                            throw $"Recovery path already exists: {$this.FailedDirectory}"
                        }

                        if ((is-dir $this.FinalDirectory).IsDirectory) {
                            System.IO.Directory.Move($this.FinalDirectory, $this.FailedDirectory)
                        }
                        $this.Promoted = false
                    }

                    if ($this.PreviousMoved) {
                        if ((is-dir $this.FinalDirectory).IsDirectory
                            or (is-file $this.FinalDirectory).IsFile
                            or (is-link $this.FinalDirectory).IsLink) {
                            throw $"Cannot restore the previous output because the destination is occupied: {$this.FinalDirectory}"
                        }
                        var finalParent = System.IO.Path.GetDirectoryName($this.FinalDirectory)
                        if ($finalParent == null) {
                            throw $"Publish destination has no parent: {$this.FinalDirectory}"
                        }
                        System.IO.Directory.CreateDirectory($finalParent) | ignore
                        System.IO.Directory.Move($this.PreviousDirectory, $this.FinalDirectory)
                        $this.PreviousMoved = false
                    }
                    $this.RetainForRecovery = false
                    return true
                } catch ($error) {
                    $this.RetainForRecovery = true
                    Helpers.Warn($"Could not restore the previous publish output: {$error}")
                    Helpers.Warn($"Recovery data retained at {$this.StagingRoot}")
                    return false
                }
            }

            func Commit() {
                if ($this.PreviousMoved and (is-dir $this.PreviousDirectory).IsDirectory) {
                    try {
                        System.IO.Directory.Delete($this.PreviousDirectory, true)
                        $this.PreviousMoved = false
                    } catch ($error) {
                        $this.RetainForRecovery = true
                        Helpers.Warn($"Release committed, but the previous output could not be removed: {$error}")
                    }
                }
            }

            func Cleanup() {
                if ($this.PreviousMoved) {
                    $this.RetainForRecovery = true
                    Helpers.Warn($"Previous publish output still needs recovery: {$this.PreviousDirectory}")
                }
                if ($this.RetainForRecovery) {
                    Helpers.Warn($"Publish transaction retained for recovery: {$this.StagingRoot}")
                    return
                }
                try {
                    Safety.DeleteStagingDirectory($this.RepoRoot, $this.StagingRoot)
                } catch ($error) {
                    Helpers.Warn($"Could not remove publish staging directory '{$this.StagingRoot}': {$error}")
                }
            }
        }

        func VerifyStagedBinary(binary: string, runtimeId: string, version: string) -> StorageSize {
            if (not (is-file $binary).IsFile) { throw $"Staged binary does not exist: {$binary}" }
            var info = ls $binary | first
            if ($info.Size.Bytes <= 0) { throw $"Staged binary is empty: {$binary}" }

            var hostRuntimeId = System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier
            if ($runtimeId == $hostRuntimeId) {
                var probe = spawn $binary --version | wait-for | first
                if ($probe.ExitCode != 0) {
                    throw $"Staged binary smoke test failed (exit {$probe.ExitCode}): {$binary}"
                }
                var versionParts = $version.Split(".".ToCharArray())
                if ($versionParts.Length == 4) {
                    var expected = $"{$versionParts[0]}.{$versionParts[1]}-{$versionParts[2]}-{$versionParts[3]}"
                    var reported = ($probe.Output | first).ToString().Trim()
                    if (not ($reported ends-with $expected)) {
                        throw $"Staged binary reports '{$reported}', expected release {$expected}."
                    }
                }
                Helpers.Ok("Staged binary smoke test passed")
            } else {
                Helpers.Info($"Skipping executable smoke test for cross-RID output {$runtimeId} (host: {$hostRuntimeId}).")
            }
            return $info.Size
        }

        record Result(
            Binary: string,
            Size: StorageSize,
            RID: string,
            Output: string,
            SelfContained: bool,
            Trimmed: bool,
            Duration: string,
            Version: string)

        func Run(
            rid: string,
            output: string,
            trimmed: bool,
            frameworkDependent: bool,
            noInstall: bool,
            noBump: bool,
            packageTargets) -> Result {

            var plan = new Plan()
            if ($rid != "") { $plan.RuntimeId = $rid }
            if ($output != "") { $plan.Directory = $output }
            $plan.Trimmed = $trimmed
            $plan.SelfContained = (not $frameworkDependent)
            $plan.NoInstall = $noInstall
            $plan.NoBump = $noBump

            var root = $plan.RepoRoot
            var workspaceLock = WorkspaceLock.Acquire($root, "publish")
            defer { $workspaceLock.Dispose() | ignore }

            $plan.RuntimeId = Safety.ValidateRuntimeId($plan.RuntimeId)
            var hostRuntimeId = System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier
            if (not $plan.NoInstall
                and ($plan.RuntimeId != "linux-x64"
                    or $hostRuntimeId != "linux-x64"
                    or not System.OperatingSystem.IsLinux())) {
                throw $"Arch package installation supports only a linux-x64 host and target. Use --noInstall for RID '{$plan.RuntimeId}'."
            }
            if (not $plan.NoInstall and (not $plan.SelfContained or $plan.Trimmed)) {
                throw "Arch package installation requires the standard self-contained, untrimmed bundle. Use --noInstall for other publish modes."
            }
            if (not $plan.NoInstall) {
                var selectedPackages = Packaging.NormalizeTargets($packageTargets)
                if (($selectedPackages | count) == 0) {
                    throw "No valid package targets were selected."
                }
                if ("devcompanion" in $selectedPackages) {
                    throw "DevCompanion is not part of the release bundle. Install it separately with the install command."
                }
            }
            $plan.Directory = Safety.ValidatePublishDirectory($root, $plan.Directory)
            var transaction = new OutputTransaction($root, $plan.Directory)
            defer { $transaction.Cleanup() }
            $plan.WorkingDirectory = $transaction.StagingDirectory
            # Version-state changes can trigger an IDE restore into src/*/obj.
            # Keep RID assets private so --no-restore publishes cannot be raced.
            $plan.BuildArtifactsDirectory = Safety.ValidateStagingDirectory(
                $root,
                ($transaction.StagingRoot | join -p "build"))
            Helpers.Info($"Staging output: {$plan.WorkingDirectory}")

            var statePath = $root | join -p ".tosh-publish-state"
            var pkgbuildPath = $root | join -p "packaging" "archlinux" "PKGBUILD"
            var originalState = ReadState($statePath)
            var originalPkgbuild = read-file $pkgbuildPath
            var extensionPackagePath = ExtensionPackagePath($root)
            var extensionPackageLockPath = ExtensionPackageLockPath($root)
            var originalExtensionPackage = null
            var originalExtensionPackageLock = null
            if ((is-file $extensionPackagePath).IsFile) {
                $originalExtensionPackage = read-file $extensionPackagePath
            }
            if ((is-file $extensionPackageLockPath).IsFile) {
                $originalExtensionPackageLock = read-file $extensionPackageLockPath
            }
            var originalVersion = GetVersion($originalState)
            var version = $originalVersion
            var releaseState = $originalState
            var versionMutationStarted = false
            var metadataMutationStarted = false
            var releaseCommitted = false

            try {
                var started = date now
                if ($plan.NoBump) {
                    Helpers.Info($"Using existing version {$version} (--no-bump)")
                    $metadataMutationStarted = true
                    UpdatePkgbuild($pkgbuildPath, $version)
                    UpdateExtensionVersion($root, $originalState)
                } else {
                    var calver = CurrentCalVer()
                    var publishNumber = ($calver == $originalState.CalVer
                        ? ($originalState.Publish + 1)
                        : 1)
                    var nextState = new State($calver, $publishNumber, $originalState.DotnetMajor)
                    $releaseState = $nextState
                    $version = GetVersion($nextState)
                    styled $"Version: {$originalVersion} → {$version}" --fg bright-yellow --bold | writeline
                    $versionMutationStarted = true
                    $metadataMutationStarted = true
                    WriteState($statePath, $calver, $publishNumber, $originalState.DotnetMajor)
                    UpdatePkgbuild($pkgbuildPath, $version)
                    UpdateExtensionVersion($root, $nextState)
                }
                VerifyReleaseMetadata($root, $releaseState)

                Helpers.Sep("RESTORE")
                var safetyArgs = Helpers.MsbuildSafetyArgs()
                var artifacts = ReleaseArtifacts($plan.RuntimeId)
                var restoreArgs = [
                    "restore", $"{$root}/Tosh.slnx",
                    "--artifacts-path", $plan.BuildArtifactsDirectory,
                    $"-p:RuntimeIdentifier={$plan.RuntimeId}",
                    "-p:Configuration=Release",
                    $"-p:SelfContained={$plan.SelfContained}",
                    $"-p:PublishReadyToRun={$plan.PublishReadyToRun}",
                    ...$safetyArgs,
                ]
                if ($plan.Trimmed) {
                    $restoreArgs = [...$restoreArgs, "-p:PublishTrimmed=true", "-p:TrimMode=partial"]
                }
                dotnet ...$restoreArgs
                Helpers.AssertOk("dotnet restore")
                VerifyRuntimeRestore($plan.BuildArtifactsDirectory, $plan.RuntimeId, $artifacts)

                Helpers.Sep("PUBLISH")
                for artifact in $artifacts {
                    var publishArgs = $plan.PublishArgs($artifact.Project)
                    dotnet ...$publishArgs
                    Helpers.AssertOk($"dotnet publish {$artifact.Project}")
                    NormalizePublishedArtifact($plan.WorkingDirectory, $artifact) | ignore
                    Helpers.Ok($"Published {$artifact.Project}")
                }

                VerifyReleaseArtifacts($plan.WorkingDirectory, $artifacts)
                WriteBundleManifest($plan.WorkingDirectory, $version, $plan, $artifacts)
                var targetName = ($artifacts | first).FileName
                var stagedTargetPath = $plan.WorkingDirectory | join -p $targetName
                Helpers.Sep("VERIFY")
                VerifyStagedBinary($stagedTargetPath, $plan.RuntimeId, $version) | ignore

                $transaction.Promote()
                Helpers.Ok($"Promoted output → {$plan.Directory}")
                $plan.Binary = $plan.Directory | join -p $targetName
                if (not (is-file $plan.Binary).IsFile) {
                    throw $"Promoted binary does not exist: {$plan.Binary}"
                }
                var binaryInfo = ls $plan.Binary | first

                if ($plan.NoInstall) {
                    $releaseCommitted = true
                    $transaction.Commit()
                }

                if (not $plan.NoInstall) {
                    var packageDirectory = $transaction.StagingRoot | join -p "packages"
                    var packageBuild = Packaging.CreatePackages(
                        $packageTargets,
                        $plan.Directory,
                        $packageDirectory)
                    Packaging.VerifyPackageArchives($packageBuild, $plan.Directory)
                    Packaging.VerifyArchiveFilesUnchanged($packageBuild)
                    if (not (is-file $plan.Binary).IsFile) {
                        throw $"Packaged release succeeded, but the promoted binary disappeared: {$plan.Binary}"
                    }

                    Helpers.Sep("INSTALL")
                    # From this point a nonzero pacman result may represent a
                    # partial or post-hook failure. Preserve the matching release,
                    # previous output, and exact packages until success is proven.
                    $releaseCommitted = true
                    $transaction.RetainForRecovery = true
                    var installExitCode = Packaging.InstallPackages($packageBuild)
                    if ($installExitCode != 0) {
                        var installedMatches = Packaging.CountInstalledBundleMatches(
                            $packageBuild.Targets,
                            $plan.Directory)
                        Helpers.Warn($"pacman failed; {$installedMatches} selected executable(s) match the new release. Recovery data will be retained.")
                        throw $"pacman -U failed (exit {$installExitCode})."
                    }
                    Helpers.Ok($"Installed: {$packageBuild.Targets | join ","}")
                    Packaging.VerifyInstalledBundle($packageBuild.Targets, $plan.Directory)
                    $transaction.RetainForRecovery = false
                    $transaction.Commit()
                    Packaging.FinishInstall($packageBuild.Targets, false, false)

                    Helpers.Sep("SYNC EXTENSION")
                    try {
                        Extension.Sync(true, false)
                        Helpers.Ok("VS Code extension synced")
                    } catch ($error) {
                        Helpers.Warn($"Could not sync VS Code extension: {$error}")
                    }
                }

                var elapsed = (((date now) - $started).ToString("hh\\:mm\\:ss\\.fff"))
                Helpers.Sep("DONE")
                Helpers.Ok($"Binary: {$plan.Binary}")
                Helpers.Ok($"Version: {$version}")

                return new Result(
                    $plan.Binary,
                    $binaryInfo.Size,
                    $plan.RuntimeId,
                    $plan.Directory,
                    $plan.SelfContained,
                    $plan.Trimmed,
                    $elapsed,
                    $version)
            } catch ($error) {
                Helpers.Fail($"Publish failed: {$error}")
                var outputRestored = true
                if (not $releaseCommitted) { $outputRestored = $transaction.Rollback() }

                if (not $releaseCommitted and $outputRestored
                    and ($versionMutationStarted or $metadataMutationStarted)) {
                    Helpers.Warn("Rolling back release metadata...")
                    if ($versionMutationStarted) {
                        WriteState(
                            $statePath,
                            $originalState.CalVer,
                            $originalState.Publish,
                            $originalState.DotnetMajor)
                    }
                    if ($metadataMutationStarted) {
                        write-file $pkgbuildPath $originalPkgbuild | ignore
                        if ($originalExtensionPackage != null) {
                            write-file $extensionPackagePath $originalExtensionPackage | ignore
                        }
                        if ($originalExtensionPackageLock != null) {
                            write-file $extensionPackageLockPath $originalExtensionPackageLock | ignore
                        }
                    }
                } else if (not $releaseCommitted and not $outputRestored) {
                    Helpers.Warn("Publish output recovery failed; preserving version state to avoid a second mismatch.")
                } else if ($releaseCommitted) {
                    Helpers.Warn("Release output was already committed; preserving version state.")
                }
                throw $error
            }
        }
    }

    module Testing {
        const GroupNames = [
            "repl", "syntax", "engine", "tui", "concurrency", "lsp",
            "display", "config", "data", "pipeline", "system", "clr", "all",
        ]

        record HistoryEntry(
            kind: string,
            ts: string,
            group: string,
            total: int,
            passed: int,
            failed: int,
            duration: string)

        func GroupFilter(group: string) -> string? {
            switch ($group) {
                case "repl"        { return "ReplLineEditor|ReplCompletion|ReplInput|ReplHistory" }
                case "syntax"      { return "SyntaxHighlighter" }
                case "engine"      { return "EngineTests|ComplexCommand|Comprehension|ExpressionEval" }
                case "tui"         { return "TuiCommand|TuiCore|TuiInline|TuiScreen|ConfigBrowser|ConsolePager" }
                case "concurrency" { return "Concurrency|ScopeAndChannel|SpawnCommand|ConcurrentRedirection" }
                case "lsp"         { return "LspFeature|McpServer" }
                case "display"     { return "DisplayEngine|DisplayProfile|ObjectFormatter|DiagnosticRenderer" }
                case "config"      { return "ConfigCommand|ConfigCollection|VarsCommand" }
                case "data"        { return "DataProcessing|StructuredData|Matrix|Vector|StreamCommand|StreamHandle" }
                case "pipeline"    { return "PipelineData|PipelineHardening|MixedPipeline" }
                case "system"      { return "SystemdJson|TimeCommand|UtilityCommand|ExternalCommand|ExecCommand|StartupLoader" }
                case "clr"         { return "CliInvocation|CommandIntrospection|MemberPath|Rune|NativeInterop" }
                case "all"         { return null }
                default {
                    throw $"Unknown test group '{$group}'. Valid groups: {($GroupNames | join ", ")}"
                }
            }
        }

        func FailedFilter(trxPath: string) -> string? {
            return null unless ((is-file $trxPath).IsFile)

            var content = System.IO.File.ReadAllText($trxPath)
            var resultRx = new System.Text.RegularExpressions.Regex(
                "(?s)<UnitTestResult\\b[^>]+outcome=\"Failed\"[^>]*(?:/>|>.*?</UnitTestResult>)")
            var nameRx = new System.Text.RegularExpressions.Regex("testName=\"([^\"]+)\"")
            var matches = $resultRx.Matches($content)
            var filters = [
                $"(FullyQualifiedName={$name.Groups[1].Value})"
                <| for result in $matches
                where ($nameRx.Match($result.Value).Success)
                let name = $nameRx.Match($result.Value)
            ]

            return null if (($filters | count) == 0)
            return ($filters | join "|")
        }

        func Run(
            group: string,
            filterOverride: string?,
            rerunFailed: bool,
            noBuild: bool,
            verbose: bool,
            blame: bool,
            resultsDir: string?) {

            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "test")
            defer { $workspaceLock.Dispose() | ignore }

            var solution = $root | join -p "Tosh.slnx"
            var output = ($resultsDir ?? ($root | join -p "artifacts" "test-results"))
            var trxPath = $output | join -p "last.trx"
            var safetyArgs = Helpers.MsbuildSafetyArgs()

            if ($rerunFailed) {
                var failed = FailedFilter($trxPath)
                if ($failed == null) {
                    Helpers.Ok("No failed tests found in the last run.")
                    return
                }
                $filterOverride = $failed
                Helpers.Info($"Rerunning {($failed | match "FullyQualifiedName=" | count)} failed test(s)...")
            }

            if (not $noBuild) {
                Helpers.Sep("BUILD")
                var buildArgs = [
                    "build", $solution, "-c", "Debug", "--verbosity", "quiet",
                    ...$safetyArgs,
                ]
                dotnet ...$buildArgs
                Helpers.AssertOk("dotnet build")
            }

            var filter = ($filterOverride ?? (GroupFilter($group)))
            var label = ($rerunFailed
                ? "failed tests"
                : ($filterOverride != null
                    ? $"filter '{$filterOverride}'"
                    : ($group == "all" ? "all tests" : $"group '{$group}'")))

            Helpers.Sep($"TEST · {$label}")
            mkdir -p $output | ignore

            # The runner either just built or was explicitly told to reuse a build.
            var args = [
                "test", $solution,
                "--no-build",
                $"--results-directory={$output}",
                "--logger=trx;LogFileName=last.trx",
                ...$safetyArgs,
            ]

            if ($filter != null and $filter != "") {
                $args = [...$args, $"--filter={$filter}"]
            }
            if ($verbose) { $args = [...$args, "--logger", "console;verbosity=detailed"] }
            if ($blame) { $args = [...$args, "--blame"] }

            var started = date now
            dotnet ...$args
            var exitCode = $tosh.Last.ExitCode
            var elapsed = (((date now) - $started).ToString("hh\\:mm\\:ss\\.fff"))

            var total = 0
            var passed = 0
            var failed = 0
            if ((is-file $trxPath).IsFile) {
                var trx = System.IO.File.ReadAllText($trxPath)
                var stats = echo $trx
                    | parse -s "total=\"(?<Total>\\d+)\".*?passed=\"(?<Passed>\\d+)\".*?failed=\"(?<Failed>\\d+)\""
                    | first
                if ($stats != null) {
                    $total = $stats.Total as int
                    $passed = $stats.Passed as int
                    $failed = $stats.Failed as int
                }
            }

            Helpers.Sep("RESULTS")
            if ($exitCode != 0) {
                Helpers.Fail($"Tests FAILED (exit {$exitCode}, {$elapsed})")
                throw "Test run failed"
            }

            Helpers.Ok($"All tests passed ({$elapsed})")
            var entry = new HistoryEntry(
                "test", Helpers.TimestampNow(), $group,
                $total, $passed, $failed, $elapsed)
            History.AppendLine(
                $root,
                ($entry | to json).Replace("\n", "").Replace("  ", ""))
        }

        func Check(noTest: bool, fast: bool, group: string, filter: string?) {
            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "check")
            defer { $workspaceLock.Dispose() | ignore }

            var solution = $root | join -p "Tosh.slnx"
            var safetyArgs = Helpers.MsbuildSafetyArgs()

            Helpers.Sep("CHECK · BUILD")
            var buildArgs = [
                "build", $solution, "-c", "Debug", "--verbosity", "minimal",
                ...$safetyArgs,
            ]
            dotnet ...$buildArgs
            Helpers.AssertOk("dotnet build")
            Helpers.Ok("Build succeeded")

            if (not $noTest) {
                var smoke = "EngineTests|ComplexCommand|Comprehension|ExpressionEval|SystemdJson|TimeCommand|UtilityCommand|ExternalCommand|ExecCommand|StartupLoader|PipelineData|PipelineHardening|MixedPipeline"
                var effective = ($filter ?? ($fast ? $smoke : null))
                Run($group, $effective, false, true, false, false, null)
            }

            Helpers.Sep("CHECK PASSED")
        }
    }

    module Cleanup {
        func Run(
            dryRun: bool,
            includeAll: bool,
            includePackaging: bool = false,
            includeTools: bool = false,
            includePublish: bool = false,
            includePackages: bool = false) {

            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "clean")
            defer { $workspaceLock.Dispose() | ignore }

            var removed = 0
            var safetyArgs = Helpers.MsbuildSafetyArgs()
            if (not $includeAll and not $includePublish) {
                $safetyArgs = [...$safetyArgs, "-p:PreserveToshPublishArtifacts=true"]
            }

            func RemoveDirectory(path: string) {
                if (not ((is-dir $path).IsDirectory)) { return }
                if ($dryRun) {
                    Helpers.Info($"[dry-run] would remove: {$path}")
                } else {
                    rm -rf $path | ignore
                    Helpers.Info($"removed: {$path}")
                }
                $removed += 1
            }

            func RemoveFile(path: string) {
                if (not ((is-file $path).IsFile)) { return }
                if ($dryRun) {
                    Helpers.Info($"[dry-run] would remove: {$path}")
                } else {
                    rm $path | ignore
                    Helpers.Info($"removed: {$path}")
                }
                $removed += 1
            }

            Helpers.Sep("CLEAN")
            if ($dryRun) {
                Helpers.Info("[dry-run] would run: dotnet clean")
            } else {
                dotnet clean $"{$root}/Tosh.slnx" --verbosity quiet ...$safetyArgs
                Helpers.AssertOk("dotnet clean")
            }

            # 1. Clean bin, obj, TestResults across src, tests, tools, bench
            var searchRoots = ["src", "tests"]
            if ($includeAll or $includeTools) {
                $searchRoots = [...$searchRoots, "tools", "bench"]
            }

            for name in ["bin", "obj", "TestResults"] {
                for r in $searchRoots {
                    var searchPath = $root | join -p $r
                    if ((is-dir $searchPath).IsDirectory) {
                        for entry in (find $searchPath -type d -name $name) {
                            if ($entry.FullName != null) { RemoveDirectory($entry.FullName) }
                        }
                    }
                }
            }

            RemoveDirectory($"{$root}/artifacts/test-results")

            # 2. Publish cleanup
            if ($includeAll or $includePublish) {
                RemoveDirectory($"{$root}/artifacts/publish")
            }

            # 3. Packaging cleanup (archlinux src/ and pkg/)
            if ($includeAll or $includePackaging) {
                RemoveDirectory($"{$root}/packaging/archlinux/src")
                RemoveDirectory($"{$root}/packaging/archlinux/pkg")
            }

            # 4. Extension dependencies
            if ($includeAll) {
                RemoveDirectory($"{$root}/editor/vscode/tosh.tosh-lang/node_modules")
            }

            # 5. Package archives (.pkg.tar.zst and .vsix)
            if ($includeAll or $includePackages or $includePackaging) {
                var archDir = $root | join -p "packaging" "archlinux"
                if ((is-dir $archDir).IsDirectory) {
                    var zstFiles = (ls $archDir | where { $_.Name.EndsWith(".pkg.tar.zst") } | sort -d Modified | collect)
                    var zstCount = ($zstFiles | count)
                    if ($zstCount > 0) {
                        var skipFirst = (not $includeAll and not $includePackages)
                        var i = 0
                        for f in $zstFiles {
                            if ($i > 0 or not $skipFirst) {
                                RemoveFile($f.FullName)
                            }
                            $i += 1
                        }
                    }
                }

                var artDir = $root | join -p "artifacts"
                if ((is-dir $artDir).IsDirectory) {
                    var vsixFiles = (ls $artDir | where { $_.Name.EndsWith(".vsix") } | sort -d Modified | collect)
                    var vsixCount = ($vsixFiles | count)
                    if ($vsixCount > 0) {
                        var skipFirst = (not $includeAll and not $includePackages)
                        var j = 0
                        for f in $vsixFiles {
                            if ($j > 0 or not $skipFirst) {
                                RemoveFile($f.FullName)
                            }
                            $j += 1
                        }
                    }
                }
            }

            Helpers.Sep("DONE")
            switch ($removed) {
                case 0 { Helpers.Ok("Already clean.") }
                case 1 {
                    Helpers.Ok($dryRun ? "Would remove 1 item." : "Removed 1 item.")
                }
                default {
                    Helpers.Ok($dryRun
                        ? $"Would remove {$removed} items."
                        : $"Removed {$removed} items.")
                }
            }
        }
    }

    module Repository {
        func ShowInfo() {
            var root = Helpers.RepoRoot()
            var statePath = $root | join -p ".tosh-publish-state"

            Helpers.Sep("INFO")
            var state = Publish.ReadState($statePath)
            Helpers.Ok($"Version:   {Publish.GetVersion($state)}")

            var sdkJob = spawn dotnet --version | wait-for | first
            var sdkVersion = $sdkJob.Output | first
            Helpers.Ok($".NET SDK:  {$sdkVersion}")

            var branchJob = spawn git -C $root rev-parse --abbrev-ref HEAD | wait-for | first
            var branch = $branchJob.Output | first
            var statusJob = spawn git -C $root status --porcelain | wait-for | first
            var dirty = $statusJob.Output | count
            var gitSummary = ($dirty > 0
                ? $"{$branch} ({$dirty} modified)"
                : $"{$branch} (clean)")
            Helpers.Ok($"Git:       {$gitSummary}")

            var lastTest = History.ReadLast($root, "test")
            if ($lastTest == null) {
                Helpers.Info("Last test: (no history yet)")
            } else {
                var test = $lastTest | from json
                Helpers.Ok($"Last test: {$test.ts}  group={$test.group}  {$test.passed}/{$test.total} passed  {$test.duration}")
            }

            var lastBench = History.ReadLast($root, "bench")
            if ($lastBench == null) {
                Helpers.Info("Last bench: (no history yet)")
            } else {
                var bench = $lastBench | from json
                Helpers.Ok($"Last bench: {$bench.ts}  sc cold={$bench.sc_cold_ms}ms warm={$bench.sc_warm_ms}ms")
            }
        }
    }

    module Diagnostics {
        record Item(
            Severity: string,
            Code: string,
            File: string,
            Line: int,
            Col: int,
            Message: string)

        func Show(asJson: bool) {
            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "errors")
            defer { $workspaceLock.Dispose() | ignore }

            var solution = $root | join -p "Tosh.slnx"
            var safetyArgs = Helpers.MsbuildSafetyArgs()
            var args = [
                "build", $solution, "-c", "Debug", "-nologo",
                ...$safetyArgs,
            ]

            if (not $asJson) { Helpers.Sep("ERRORS · BUILD") }
            var job = spawn dotnet ...$args | wait-for | first
            var lines = chain $job.Output $job.ErrorLines | collect
            var regex = new System.Text.RegularExpressions.Regex(
                "^\\s*(.+?)\\((\\d+),(\\d+)\\):\\s*(error|warning)\\s+(\\w+):\\s*(.+?)(?:\\s*\\[.+?\\])?\\s*$")

            var diagnostics = [
                (new Item(
                    $match.Groups[4].Value,
                    $match.Groups[5].Value,
                    $match.Groups[1].Value,
                    ($match.Groups[2].Value as int),
                    ($match.Groups[3].Value as int),
                    $match.Groups[6].Value))
                <| for line in $lines
                where ($regex.Match($line.ToString()).Success)
                let match = $regex.Match($line.ToString())
            ]

            if ($asJson) {
                writeline (System.Text.Json.JsonSerializer.Serialize(
                    $diagnostics,
                    $diagnostics.GetType()))
                return
            }

            var errors = $diagnostics | where { $_.Severity == "error" } | collect
            var warnings = $diagnostics | where { $_.Severity == "warning" } | collect

            if (($errors | count) == 0 and ($warnings | count) == 0) {
                if ($job.ExitCode == 0) {
                    Helpers.Ok("No errors or warnings.")
                } else {
                    Helpers.Fail($"Build failed (exit {$job.ExitCode}) but no diagnostics were parseable.")
                }
                return
            }

            for diagnostic in $errors {
                Helpers.Fail($"[{$diagnostic.Code}] {$diagnostic.File}({$diagnostic.Line},{$diagnostic.Col}): {$diagnostic.Message}")
            }
            for diagnostic in $warnings {
                Helpers.Warn($"[{$diagnostic.Code}] {$diagnostic.File}({$diagnostic.Line},{$diagnostic.Col}): {$diagnostic.Message}")
            }

            Helpers.Info("")
            Helpers.Info($"{($errors | count)} error(s), {($warnings | count)} warning(s)")
        }
    }

    module Benchmark {
        record Result(
            Label: string,
            PublishSec: string,
            SizeMB: string,
            ColdMs: string,
            WarmMs: string)

        record Configuration(Label: string, DirectoryName: string, Args: array)
        record Delta(Label: string, ColdDelta: string, WarmDelta: string)
        record HistoryEntry(
            kind: string,
            ts: string,
            sc_cold_ms: string,
            sc_warm_ms: string,
            sc_r2r_cold_ms: string,
            sc_r2r_warm_ms: string,
            fdd_cold_ms: string,
            fdd_warm_ms: string)

        func ReadPreviousField(previous: object, key: string) -> double? {
            try {
                var value = $previous.GetProperty($key)
                if ($value.ValueKind == System.Text.Json.JsonValueKind.String) {
                    return System.Double.Parse(
                        $value.GetString(),
                        System.Globalization.CultureInfo.InvariantCulture)
                }
                return $value.GetDouble()
            } catch {
                return null
            }
        }

        func Run(rid: string, runs: int, output: string, compare: bool) {
            if ($runs < 1) { throw "--runs must be >= 1" }
            if ($rid == "") {
                $rid = System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier
            }
            $rid = Safety.ValidateRuntimeId($rid)
            var hostRuntimeId = System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier
            if ($rid != $hostRuntimeId) {
                throw $"Startup benchmarks must execute on their target RID (host: {$hostRuntimeId}, requested: {$rid})."
            }

            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "bench")
            defer { $workspaceLock.Dispose() | ignore }

            var directory = ($output == ""
                ? ($root | join -p "artifacts" "benchmarks")
                : System.IO.Path.GetFullPath($output))
            var runId = System.Guid.NewGuid().ToString("N")
            var runDirectory = $directory
                | join -p $rid $"run-{$runId}"
            var removeRunDirectory = ($output == "")
            defer {
                if ($removeRunDirectory and (is-dir $runDirectory).IsDirectory) {
                    try { System.IO.Directory.Delete($runDirectory, true) } catch ($error) {
                        Helpers.Warn($"Could not remove benchmark run directory '{$runDirectory}': {$error}")
                    }
                }
            }
            var buildTransactionDirectory = Safety.ValidateStagingDirectory(
                $root,
                ($root | join -p "artifacts" "staging" $"benchmark-{$runId}"))
            var buildArtifactsDirectory = Safety.ValidateStagingDirectory(
                $root,
                ($buildTransactionDirectory | join -p "build"))
            if ((is-file $buildTransactionDirectory).IsFile
                or (is-dir $buildTransactionDirectory).IsDirectory
                or (is-link $buildTransactionDirectory).IsLink) {
                throw $"Benchmark build transaction path already exists: {$buildTransactionDirectory}"
            }
            defer {
                try {
                    Safety.DeleteStagingDirectory($root, $buildTransactionDirectory)
                } catch ($error) {
                    Helpers.Warn($"Could not remove benchmark build directory '{$buildTransactionDirectory}': {$error}")
                }
            }
            System.IO.Directory.CreateDirectory($buildArtifactsDirectory) | ignore
            var project = $root | join -p "src" "Tosh.Cli" "Tosh.Cli.csproj"
            var safetyArgs = Helpers.MsbuildSafetyArgs()
            mkdir -p $runDirectory | ignore

            var previous = null
            var previousDocument = null
            defer {
                if ($previousDocument != null) { $previousDocument.Dispose() | ignore }
            }
            if ($compare) {
                var line = History.ReadLast($root, "bench")
                if ($line == null) {
                    Helpers.Warn("No previous benchmark in history; comparison will be omitted.")
                } else {
                    $previousDocument = System.Text.Json.JsonDocument.Parse($line)
                    $previous = $previousDocument.RootElement
                    var previousTimestamp = $previous.GetProperty("ts").GetString()
                    Helpers.Info($"Comparing against previous run from {$previousTimestamp}")
                }
            }

            var configurations = [
                new Configuration("Self-Contained", "sc", [
                    "-p:SelfContained=true",
                    "-p:IncludeAllContentForSelfExtract=true",
                ]),
                new Configuration("Self-Contained, Ready-To-Run", "sc-r2r", [
                    "-p:SelfContained=true",
                    "-p:PublishReadyToRun=true",
                    "-p:IncludeAllContentForSelfExtract=true",
                ]),
                new Configuration("Framework-Dependent", "fdd", [
                    "-p:SelfContained=false",
                    "-p:IncludeAllContentForSelfExtract=true",
                ]),
            ]

            var results = []
            Helpers.Sep("BENCH")
            Helpers.Info($"RID: {$rid}  runs: {$runs}  output: {$runDirectory}")
            writeline ""

            var restoreArgs = [
                "restore", $project,
                "--artifacts-path", $buildArtifactsDirectory,
                "-r", $rid,
                "-p:Configuration=Release",
                "-p:SelfContained=true",
                "-p:PublishReadyToRun=true",
                ...$safetyArgs,
            ]
            dotnet ...$restoreArgs
            Helpers.AssertOk("benchmark restore")

            for configuration in $configurations {
                var configurationDirectory = $runDirectory | join -p $configuration.DirectoryName
                mkdir -p $configurationDirectory | ignore
                Helpers.Info($"Publishing '{$configuration.Label}'...")

                var started = date now
                var configurationArgs = $configuration.Args
                var args = [
                    "publish", $project,
                    "-c", "Release", "-r", $rid,
                    "-o", $configurationDirectory,
                    "--artifacts-path", $buildArtifactsDirectory,
                    "--no-restore",
                    "-p:PublishSingleFile=true",
                    "-p:DebugType=None",
                    "-p:DebugSymbols=false",
                    ...$configurationArgs,
                    ...$safetyArgs,
                ]
                dotnet ...$args
                Helpers.AssertOk($"publish {$configuration.Label}")
                var publishSeconds = ((((date now) - $started).TotalSeconds).ToString("F2"))

                var executableSuffix = (($rid starts-with "win-") ? ".exe" : "")
                var candidates = [
                    ($configurationDirectory | join -p $"tosh{$executableSuffix}"),
                    ($configurationDirectory | join -p $"Tosh.Cli{$executableSuffix}"),
                ]
                var binary = $candidates | where { (is-file $_).IsFile } | first
                if ($binary == null) {
                    Helpers.Warn($"Binary not found for {$configuration.Label}; skipping.")
                    continue
                }

                var binaryInfo = ls $binary | first
                var sizeMb = (($binaryInfo.Size.Bytes / 1048576.0).ToString("F1"))
                Helpers.Info($"  Published {$sizeMb} MB in {$publishSeconds}s; measuring startup...")

                var cold = spawn $binary --safe -c exit | wait-for | first
                if ($cold.ExitCode != 0) {
                    throw $"Cold-start probe failed for {$configuration.Label} (exit {$cold.ExitCode})."
                }
                var coldMs = $cold.Duration.TotalMilliseconds.ToString("F1")
                var warmTotal = 0.0
                var run = 0
                while ($run < $runs) {
                    var warm = spawn $binary --safe -c exit | wait-for | first
                    if ($warm.ExitCode != 0) {
                        throw $"Warm-start probe failed for {$configuration.Label} (exit {$warm.ExitCode})."
                    }
                    $warmTotal += $warm.Duration.TotalMilliseconds
                    $run += 1
                }
                var warmAverage = (($warmTotal / $runs).ToString("F1"))

                Helpers.Ok($"{$configuration.Label}  publish={$publishSeconds}s  size={$sizeMb}MB  cold={$coldMs}ms  warm={$warmAverage}ms")
                $results = [...$results, new Result(
                    $configuration.Label,
                    $publishSeconds,
                    $sizeMb,
                    $coldMs,
                    $warmAverage)]
            }

            Helpers.Sep("SUMMARY")
            echo $results

            if ($compare and $previous != null) {
                writeline ""
                Helpers.Sep("COMPARE vs previous")
                var deltas = []
                for result in $results {
                    var configuration = $configurations
                        | where { $_.Label == $result.Label }
                        | first
                    var historyKey = $configuration.DirectoryName.Replace("-", "_")
                    var previousCold = ReadPreviousField(
                        $previous,
                        $"{$historyKey}_cold_ms")
                    var previousWarm = ReadPreviousField(
                        $previous,
                        $"{$historyKey}_warm_ms")
                    if ($previousCold != null and $previousWarm != null) {
                        var coldDelta = (($result.ColdMs as double) - $previousCold).ToString("+0.0;-0.0;0.0")
                        var warmDelta = (($result.WarmMs as double) - $previousWarm).ToString("+0.0;-0.0;0.0")
                        $deltas = [...$deltas, new Delta(
                            $result.Label,
                            $"{$coldDelta}ms",
                            $"{$warmDelta}ms")]
                    }
                }
                if (($deltas | count) > 0) { echo $deltas }
            }

            func ResultField(label: string, field: string) -> string {
                var result = $results | where { $_.Label == $label } | first
                if ($result == null) { return "0" }
                return ($field == "cold" ? $result.ColdMs : $result.WarmMs)
            }

            var historyEntry = new HistoryEntry(
                "bench", Helpers.TimestampNow(),
                (ResultField("Self-Contained", "cold")),
                (ResultField("Self-Contained", "warm")),
                (ResultField("Self-Contained, Ready-To-Run", "cold")),
                (ResultField("Self-Contained, Ready-To-Run", "warm")),
                (ResultField("Framework-Dependent", "cold")),
                (ResultField("Framework-Dependent", "warm")))
            History.AppendLine(
                $root,
                ($historyEntry | to json).Replace("\n", "").Replace("  ", ""))
        }
    }

    module Desktop {
        func Install(root: Types.DirectoryPath, system: bool) {
            Helpers.Sep("LINUX DESKTOP")
            var languageSpec = $root | join -p "editor" "gtksourceview" "tosh.lang"
            var icon = $root | join -p "editor" "vscode" "tosh.tosh-lang" "icons" "tosh-dark.svg"
            if (not (is-file $languageSpec).IsFile) { throw $"Missing GtkSourceView spec: {$languageSpec}" }
            if (not (is-file $icon).IsFile) { throw $"Missing icon: {$icon}" }

            var dataRoot = ""
            var useSudo = false
            if ($system) {
                $dataRoot = "/usr/share"
                var uid = (id -u).Uid
                if ($uid != 0) { $useSudo = true }
            } else {
                $dataRoot = ($env.XDG_DATA_HOME ?? $"{$env.HOME}/.local/share")
                if ($dataRoot == "") { $dataRoot = $"{$env.HOME}/.local/share" }
            }

            var applications = $"{$dataRoot}/applications"
            var mime = $"{$dataRoot}/mime"
            var icons = $"{$dataRoot}/icons/hicolor"
            var currentDefault = ""
            if (not $system) {
                try { $currentDefault = (xdg-mime query default text/x-tosh).Trim() } catch { }
            }

            var temporary = (mktemp -d).FullName
            defer { try { rm -rf $temporary | ignore } catch { } }

            write-file $"{$temporary}/tosh.xml" '<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-tosh">
    <comment>TōSh script</comment>
    <icon name="text-x-tosh"/>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.tosh" weight="100"/>
    <magic priority="80">
      <match type="string" value="#!/usr/bin/tosh" offset="0"/>
      <match type="string" value="#!/bin/tosh" offset="0"/>
      <match type="string" value="#!/bin/env tosh" offset="0"/>
      <match type="string" value="#!/usr/bin/env tosh" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
'

            write-file $"{$temporary}/tosh.desktop" '[Desktop Entry]
Type=Application
Name=TōSh
GenericName=Shell
Comment=ToastedShell interactive shell
Exec=tosh
TryExec=tosh
Icon=tosh
Terminal=true
Categories=System;TerminalEmulator;
StartupNotify=false
'

            write-file $"{$temporary}/tosh-open.desktop" '[Desktop Entry]
Type=Application
Name=Run with TōSh
GenericName=Shell
Comment=Run a TōSh script
Exec=tosh %f
TryExec=tosh
Icon=tosh
Terminal=true
NoDisplay=true
MimeType=text/x-tosh;
Categories=System;TerminalEmulator;
StartupNotify=false
'

            func InstallFile(source: string, destination: string) {
                if ($useSudo) {
                    sudo install -Dm644 $source $destination | ignore
                } else {
                    install -Dm644 $source $destination | ignore
                }
            }

            Helpers.Info($"Installing into {$dataRoot}")
            InstallFile($"{$temporary}/tosh.xml", $"{$mime}/packages/tosh.xml")
            InstallFile($icon, $"{$icons}/scalable/mimetypes/text-x-tosh.svg")
            InstallFile($icon, $"{$icons}/scalable/apps/tosh.svg")
            InstallFile($"{$temporary}/tosh.desktop", $"{$applications}/tosh.desktop")
            InstallFile($"{$temporary}/tosh-open.desktop", $"{$applications}/tosh-open.desktop")
            for version in ["2.0", "3.0", "4", "5"] {
                InstallFile($languageSpec, $"{$dataRoot}/gtksourceview-{$version}/language-specs/tosh.lang")
            }

            if ($useSudo) {
                try { sudo update-mime-database $mime | ignore } catch { }
                try { sudo gtk-update-icon-cache -f -t $icons | ignore } catch { }
                try { sudo update-desktop-database $applications | ignore } catch { }
            } else {
                try { update-mime-database $mime | ignore } catch { }
                try { gtk-update-icon-cache -f -t $icons | ignore } catch { }
                try { update-desktop-database $applications | ignore } catch { }
            }

            if (not $system and $currentDefault != "" and $currentDefault != "tosh-open.desktop") {
                try { xdg-mime default $currentDefault text/x-tosh | ignore } catch { }
            }

            Helpers.Ok("Linux desktop integration installed")
            Helpers.Info($"  MIME:         {$mime}/packages/tosh.xml")
            Helpers.Info($"  App launcher: {$applications}/tosh.desktop")
            Helpers.Info($"  Open With:    {$applications}/tosh-open.desktop")
        }
    }

    module Packaging {
        const ValidTargets = ["tosh", "lsp", "mcp", "tome", "crumb", "devcompanion", "dap"]
        const DefaultTargets = ["tosh", "lsp", "mcp", "tome", "crumb"]

        record PackageBuild(
            Targets: array,
            Files: array,
            ArchiveHashes: array,
            PrebuiltRoot: string?,
            PackageDirectory: string)

        func CanonicalTarget(target: string) -> string {
            var value = $target.Trim().ToLowerInvariant()
            if ($value == "tosh" or $value == "cli") { return "tosh" }
            if ($value == "lsp") { return "lsp" }
            if ($value == "mcp") { return "mcp" }
            if ($value == "tome" or $value == "editor") { return "tome" }
            if ($value == "crumb" or $value == "pkg") { return "crumb" }
            if ($value == "devcompanion" or $value == "dc" or $value == "companion") {
                return "devcompanion"
            }
            if ($value == "dap" or $value == "debug") { return "dap" }
            return ""
        }

        func NormalizeTargets(targets) -> array {
            var requested = []
            if ($targets is array) {
                $requested = $targets
            } else {
                var targetText = ($targets as string).Trim()
                if ($targetText.ToLowerInvariant() == "all") {
                    $requested = $DefaultTargets
                } else {
                    $requested = $targetText | split "," | collect
                }
            }

            var selected = []
            var invalid = []
            for target in $requested {
                var canonical = CanonicalTarget(($target as string))
                if ($canonical == "") {
                    $invalid = [...$invalid, ($target as string)]
                } else {
                    $selected = [...$selected, $canonical]
                }
            }

            if (($invalid | count) > 0 or ($selected | count) == 0) {
                var bad = (($invalid | count) > 0 ? ($invalid | join ", ") : "<empty>")
                throw $"Invalid package target(s): {$bad}. Choose from: tosh, lsp, mcp, tome, crumb, devcompanion, dap, all."
            }
            # Match PKGBUILD's fixed pkgname order so each target lines up with
            # the corresponding makepkg --packagelist entry.
            return $ValidTargets | where { $_ in $selected } | collect
        }

        func CreatePackages(
            targets,
            prebuiltRoot: string?,
            packageDirectory: string?) -> PackageBuild {
            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "package")
            defer { $workspaceLock.Dispose() | ignore }

            var archDirectory = $root | join -p "packaging" "archlinux"
            var selected = NormalizeTargets($targets)
            var targetSpec = $selected | join ","
            Helpers.Sep("PACKAGE")
            if ($prebuiltRoot != null and $prebuiltRoot != "") {
                $prebuiltRoot = Safety.ValidatePublishDirectory($root, $prebuiltRoot)
                Helpers.Info($"Packaging prebuilt targets: {$targetSpec}")
                Helpers.Info($"Prebuilt bundle: {$prebuiltRoot}")
            } else {
                $prebuiltRoot = null
                Helpers.Info($"Building targets: {$targetSpec}")
            }

            if ($packageDirectory == null or $packageDirectory == "") {
                $packageDirectory = $root
                    | join -p "artifacts" "staging" $"packages-{System.Guid.NewGuid().ToString("N")}"
            }
            $packageDirectory = Safety.ValidateStagingDirectory($root, $packageDirectory)
            if ((is-file $packageDirectory).IsFile
                or (is-dir $packageDirectory).IsDirectory
                or (is-link $packageDirectory).IsLink) {
                throw $"Package transaction path already exists: {$packageDirectory}"
            }
            System.IO.Directory.CreateDirectory($packageDirectory) | ignore

            var previous = (pwd).FullName
            var previousTargets = System.Environment.GetEnvironmentVariable("TOSH_TARGETS")
            var previousPrebuiltRoot = System.Environment.GetEnvironmentVariable("TOSH_PREBUILT_ROOT")
            var previousPackageDestination = System.Environment.GetEnvironmentVariable("PKGDEST")
            try {
                cd $archDirectory | ignore
                try { /usr/bin/chmod -R u+rwx pkg src } catch { }
                rm -rf pkg src | ignore
                System.Environment.SetEnvironmentVariable("TOSH_TARGETS", $targetSpec)
                System.Environment.SetEnvironmentVariable("TOSH_PREBUILT_ROOT", $prebuiltRoot)
                System.Environment.SetEnvironmentVariable("PKGDEST", $packageDirectory)
                # Do not use makepkg --syncdeps here: package creation must not
                # mutate the system before the explicit pacman transaction.
                makepkg -fC --noconfirm PKGBUILD
                Helpers.AssertOk("makepkg")

                var packageProbe = spawn makepkg --packagelist PKGBUILD | wait-for | first
                if ($packageProbe.ExitCode != 0) {
                    throw $"makepkg --packagelist failed (exit {$packageProbe.ExitCode})."
                }
                var packageFiles = $packageProbe.Output
                    | each { $_.ToString().Trim() }
                    | where { $_ != "" }
                    | collect
                if (($packageFiles | count) != ($selected | count)) {
                    throw $"makepkg produced {($packageFiles | count)} package path(s) for {($selected | count)} selected target(s)."
                }
                var archiveHashes = []
                for packageFile in $packageFiles {
                    if (not (is-file $packageFile).IsFile or (is-link $packageFile).IsLink) {
                        throw $"Expected package archive is missing or unsafe: {$packageFile}"
                    }
                    $archiveHashes = [...$archiveHashes, Publish.FileSha256($packageFile)]
                }
                Helpers.Ok($"Packaged: {$targetSpec}")
                return new PackageBuild(
                    $selected,
                    $packageFiles,
                    $archiveHashes,
                    $prebuiltRoot,
                    $packageDirectory)
            } catch ($error) {
                try { Safety.DeleteStagingDirectory($root, $packageDirectory) } catch { }
                throw $error
            } finally {
                try { System.Environment.SetEnvironmentVariable("TOSH_TARGETS", $previousTargets) } catch { }
                try { System.Environment.SetEnvironmentVariable("TOSH_PREBUILT_ROOT", $previousPrebuiltRoot) } catch { }
                try { System.Environment.SetEnvironmentVariable("PKGDEST", $previousPackageDestination) } catch { }
                try { cd $previous | ignore } catch { }
            }
        }

        func InstallPackages(packageBuild: PackageBuild) -> int {
            /usr/bin/sudo /usr/bin/pacman -U --noconfirm ...$packageBuild.Files
            return $tosh.Last.ExitCode
        }

        func InstalledPath(target: string) -> string {
            if ($target == "tosh") { return "/usr/bin/tosh" }
            if ($target == "lsp") { return "/usr/bin/tosh-lsp" }
            if ($target == "mcp") { return "/usr/bin/tosh-mcp" }
            if ($target == "tome") { return "/usr/bin/tome" }
            if ($target == "crumb") { return "/usr/bin/crumb" }
            if ($target == "devcompanion") { return "/usr/bin/tosh-devcompanion" }
            if ($target == "dap") { return "/usr/bin/tosh-dap" }
            throw $"Unknown installed target: {$target}"
        }

        func BundleFileName(target: string) -> string {
            if ($target == "tosh") { return "tosh" }
            if ($target == "lsp") { return "Tosh.Lsp" }
            if ($target == "mcp") { return "Tosh.Mcp" }
            if ($target == "tome") { return "tome" }
            if ($target == "crumb") { return "crumb" }
            throw $"Target '{$target}' is not part of the release bundle."
        }

        func PackageMember(target: string) -> string {
            if ($target == "tosh") { return "usr/bin/tosh" }
            if ($target == "lsp") { return "usr/bin/tosh-lsp" }
            if ($target == "mcp") { return "usr/bin/tosh-mcp" }
            if ($target == "tome") { return "usr/bin/tome" }
            if ($target == "crumb") { return "usr/bin/crumb" }
            if ($target == "devcompanion") { return "usr/bin/tosh-devcompanion" }
            if ($target == "dap") { return "usr/bin/tosh-dap" }
            throw $"Unknown package target: {$target}"
        }

        func VerifyArchiveFilesUnchanged(packageBuild: PackageBuild) {
            if (($packageBuild.Files | count) != ($packageBuild.ArchiveHashes | count)) {
                throw "Package archive/hash count mismatch."
            }
            var index = 0
            while ($index < ($packageBuild.Files | count)) {
                var packageFile = $packageBuild.Files[$index]
                if (not (is-file $packageFile).IsFile or (is-link $packageFile).IsLink) {
                    throw $"Refusing missing or unsafe package archive: {$packageFile}"
                }
                if (Publish.FileSha256($packageFile) != $packageBuild.ArchiveHashes[$index]) {
                    throw $"Package archive changed after creation: {$packageFile}"
                }
                $index += 1
            }
        }

        func VerifyPackageArchives(packageBuild: PackageBuild, bundleRoot: string) {
            VerifyArchiveFilesUnchanged($packageBuild)
            var root = Helpers.RepoRoot()
            var verifyDirectory = $root
                | join -p "artifacts" "staging" $"package-verify-{System.Guid.NewGuid().ToString("N")}"
            $verifyDirectory = Safety.ValidateStagingDirectory($root, $verifyDirectory)
            System.IO.Directory.CreateDirectory($verifyDirectory) | ignore
            try {
                var index = 0
                while ($index < ($packageBuild.Targets | count)) {
                    var target = $packageBuild.Targets[$index]
                    var packageFile = $packageBuild.Files[$index]
                    var member = PackageMember($target)
                    var targetDirectory = $verifyDirectory | join -p $target
                    System.IO.Directory.CreateDirectory($targetDirectory) | ignore
                    bsdtar -xf $packageFile -C $targetDirectory $member
                    Helpers.AssertOk($"extract package payload {$target}")

                    var extracted = System.IO.Path.Combine($targetDirectory, $member)
                    var source = $bundleRoot | join -p (BundleFileName($target))
                    if (not (is-file $extracted).IsFile or (is-link $extracted).IsLink) {
                        throw $"Package payload is missing or unsafe: {$extracted}"
                    }
                    if (Publish.FileSha256($extracted) != Publish.FileSha256($source)) {
                        throw $"Package payload does not match the promoted release: {$target}"
                    }
                    $index += 1
                }
            } finally {
                try { Safety.DeleteStagingDirectory($root, $verifyDirectory) } catch { }
            }
            VerifyArchiveFilesUnchanged($packageBuild)
            Helpers.Ok("Package archives match the promoted release")
        }

        func CleanupPackageBuild(packageBuild: PackageBuild) {
            var root = Helpers.RepoRoot()
            try {
                Safety.DeleteStagingDirectory($root, $packageBuild.PackageDirectory)
            } catch ($error) {
                Helpers.Warn($"Could not remove package transaction directory '{$packageBuild.PackageDirectory}': {$error}")
            }
            # Clean up intermediate makepkg staging directories (src/ and pkg/)
            var archDir = $root | join -p "packaging" "archlinux"
            try { rm -rf ($archDir | join -p "src") | ignore } catch { }
            try { rm -rf ($archDir | join -p "pkg") | ignore } catch { }
        }

        func VerifyInstalledBundle(targets: array, bundleRoot: string) {
            for target in $targets {
                var source = $bundleRoot | join -p (BundleFileName($target))
                var installed = InstalledPath($target)
                if (not (is-file $installed).IsFile or (is-link $installed).IsLink) {
                    throw $"Installed executable is missing or unsafe: {$installed}"
                }
                var sourceHash = Publish.FileSha256($source)
                var installedHash = Publish.FileSha256($installed)
                if ($sourceHash != $installedHash) {
                    throw $"Installed executable does not match the promoted release: {$installed}"
                }
            }
            Helpers.Ok("Installed executables match the promoted release")
        }

        func CountInstalledBundleMatches(targets: array, bundleRoot: string) -> int {
            var matches = 0
            for target in $targets {
                try {
                    var source = $bundleRoot | join -p (BundleFileName($target))
                    var installed = InstalledPath($target)
                    if ((is-file $installed).IsFile
                        and not (is-link $installed).IsLink
                        and Publish.FileSha256($installed) == Publish.FileSha256($source)) {
                        $matches += 1
                    }
                } catch { }
            }
            return $matches
        }

        func FinishInstall(selected: array, linuxDesktop: bool, system: bool) {
            var root = Helpers.RepoRoot()

            if ("tosh" in $selected and System.OperatingSystem.IsLinux()) {
                try {
                    Helpers.Info("Setting cap_net_raw on /usr/bin/tosh...")
                    sudo setcap cap_net_raw+ep /usr/bin/tosh
                } catch ($error) {
                    Helpers.Warn($"Could not set cap_net_raw: {$error}")
                }
            }
            if ($linuxDesktop) { Desktop.Install($root, $system) }
            Helpers.Warn("Restart running tosh shells (`exec tosh`) to pick up the new binary.")
            Helpers.Sep("DONE")
        }

        func Install(targets, linuxDesktop: bool, system: bool, prebuiltRoot: string?) {
            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "install")
            defer { $workspaceLock.Dispose() | ignore }

            var packageBuild = null
            var retainPackages = false
            try {
                $packageBuild = CreatePackages($targets, $prebuiltRoot, null)
                VerifyArchiveFilesUnchanged($packageBuild)
                if ($packageBuild.PrebuiltRoot != null) {
                    VerifyPackageArchives($packageBuild, $packageBuild.PrebuiltRoot)
                }
                Helpers.Sep("INSTALL")
                var exitCode = InstallPackages($packageBuild)
                if ($exitCode != 0) {
                    $retainPackages = true
                    throw $"pacman -U failed (exit {$exitCode})."
                }
                Helpers.Ok($"Installed: {$packageBuild.Targets | join ","}")
                if ($packageBuild.PrebuiltRoot != null) {
                    try {
                        VerifyInstalledBundle($packageBuild.Targets, $packageBuild.PrebuiltRoot)
                    } catch ($error) {
                        $retainPackages = true
                        throw $error
                    }
                }
                FinishInstall($packageBuild.Targets, $linuxDesktop, $system)
            } finally {
                if ($packageBuild != null and $retainPackages) {
                    Helpers.Warn($"Package archives retained for retry: {$packageBuild.PackageDirectory}")
                } else if ($packageBuild != null) {
                    CleanupPackageBuild($packageBuild)
                }
            }
        }
    }

    module Extension {
        func Sync(quiet: bool, regenerate: bool) {
            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "sync")
            defer { $workspaceLock.Dispose() | ignore }

            var script = $root | join -p "scripts" "sync_vscode_extension.tosh"
            var args = ["--safe", $script]
            if ($quiet) { $args = [...$args, "--quiet"] }
            if ($regenerate) { $args = [...$args, "--regenerate"] }
            tosh ...$args
            Helpers.AssertOk("sync_vscode_extension.tosh")
        }

        func BuildVsix(noInstall: bool, noPublish: bool, marketplaceUrl: string) {
            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "vsix")
            defer { $workspaceLock.Dispose() | ignore }

            var extensionDirectory = $root | join -p "editor" "vscode" "tosh.tosh-lang"
            var artifacts = $root | join -p "artifacts"
            if (not (is-dir $extensionDirectory).IsDirectory) {
                throw $"Extension directory not found: {$extensionDirectory}"
            }

            Helpers.Sep("VSIX")
            var statePath = $root | join -p ".tosh-publish-state"
            var packageJson = $extensionDirectory | join -p "package.json"
            if ((is-file $statePath).IsFile and (is-file $packageJson).IsFile) {
                var state = Publish.ReadState($statePath)
                Publish.UpdateExtensionVersion($root, $state)
            } else {
                Helpers.Warn("Could not sync extension version; state or package.json is missing.")
            }

            var previousDirectory = (pwd).FullName
            cd $extensionDirectory | ignore
            try {
                if (not (is-dir ($extensionDirectory | join -p "node_modules")).IsDirectory) {
                    Helpers.Info("Installing npm dependencies...")
                    npm install --no-audit --no-fund --silent
                    Helpers.AssertOk("npm install")
                }

                try {
                    for stale in (ls *.vsix) {
                        rm $stale.FullName | ignore
                    }
                } catch { }

                Helpers.Info("Packaging extension with vsce...")
                npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license --out . | ignore
                Helpers.AssertOk("vsce package")

                var vsix = ls *.vsix | first
                if ($vsix == null) { throw "vsce produced no .vsix file" }

                mkdir -p $artifacts | ignore
                var destination = $artifacts | join -p $vsix.Name
                cp $vsix.FullName $destination | ignore
                Helpers.Ok($"Built {$vsix.Name}")
                Helpers.Info($"Copied to {$destination}")

                if ($noInstall) {
                    Helpers.Info("Skipping local install (--noInstall)")
                } else if ((which code | first) == null) {
                    Helpers.Warn("VS Code CLI ('code') is not on PATH; skipping install.")
                } else {
                    code --install-extension $destination --force | ignore
                    Helpers.AssertOk("code --install-extension")
                    Helpers.Ok("Extension installed in local VS Code")
                }

                if ($noPublish) {
                    Helpers.Info("Skipping marketplace publish (--noPublish)")
                } else {
                    var healthUrl = $"{$marketplaceUrl}/health"
                    var publishUrl = $"{$marketplaceUrl}/publish"
                    var reachable = false
                    try {
                        var response = http get $healthUrl --as response
                        if ($response.StatusCode == 200) { $reachable = true }
                    } catch { }

                    if (not $reachable) {
                        Helpers.Warn($"Valinor Marketplace is not reachable at {$marketplaceUrl}; skipping publish.")
                    } else {
                        curl -sS -f -o /dev/null -X POST -F $"file=@{$destination}" $publishUrl | ignore
                        Helpers.AssertOk("marketplace publish")
                        Helpers.Ok($"Published to Valinor Marketplace ({$marketplaceUrl})")
                    }
                }
            } finally {
                cd $previousDirectory | ignore
            }
            Helpers.Sep("DONE")
        }
    }

    ## The specification is built from three inputs, two of which are generated
    ## from the source tree rather than written by hand. Order matters and is the
    ## reason this is one step rather than three commands to remember: the command
    ## reference is exported from a *built* `tosh`, and both generated chapters are
    ## `\input` by the document, so the PDF is produced last.
    module Spec {
        record Result(
            Diagnostics: bool,
            CommandReference: bool,
            Pdf: bool,
            Path: string)

        func DocumentPath(root: Types.DirectoryPath) -> string =>
            $root | join -p "docs" "spec" "toastscript-spec.tex"

        func PdfPath(root: Types.DirectoryPath) -> string =>
            $root | join -p "docs" "spec" "toastscript-spec.pdf"

        ## LaTeX is the one dependency the rest of the pipeline does not carry, so
        ## its absence is reported and skipped rather than failing a release that
        ## was not asking for a PDF.
        func HasLatexmk() -> bool {
            try {
                var probe = spawn latexmk -v | wait-for | first
                return ($probe.ExitCode == 0)
            } catch {
                return false
            }
        }

        ## `docs/diagnostic-codes.md` and the runtime's code manifest come out of
        ## the same pass, so all three stay consistent with each other.
        func WriteDiagnostics(root: Types.DirectoryPath) {
            var script = $root | join -p "scripts" "extract-diagnostic-codes.tosh"
            var job = spawn tosh --no-profile $script --quiet | wait-for | first
            if ($job.ExitCode != 0) {
                throw $"Diagnostic extraction failed (exit {$job.ExitCode})."
            }
            Helpers.Ok("Diagnostic code reference regenerated.")
        }

        ## Exported from the installed `tosh`, so this reflects the build that was
        ## just installed rather than the source tree.
        func WriteCommandReference(root: Types.DirectoryPath) {
            var output = $root | join -p "docs" "spec" "command-reference.tex"
            var job = spawn tosh --export-command-metadata --latex -o $output | wait-for | first
            if ($job.ExitCode != 0) {
                throw $"Command metadata export failed (exit {$job.ExitCode})."
            }
            Helpers.Ok("Command reference regenerated.")
        }

        ## `-cd` runs LaTeX in the document's own directory, which is where its
        ## `\input` targets and auxiliary files live.
        func WritePdf(root: Types.DirectoryPath) -> bool {
            if (not HasLatexmk()) {
                Helpers.Warn("latexmk not found — skipping the PDF. Install texlive to build it.")
                return false
            }

            var job = spawn latexmk -cd -pdf -interaction=nonstopmode -halt-on-error (DocumentPath($root))
                | wait-for
                | first
            if ($job.ExitCode != 0) {
                throw $"latexmk failed (exit {$job.ExitCode}). See docs/spec/toastscript-spec.log."
            }
            ## Hoisted rather than called inside the hole: a bare sibling call in
            ## an interpolation hole resolves as a *type* and fails (`TS-P2-114`).
            var pdf = PdfPath($root)
            Helpers.Ok($"Specification PDF written: {$pdf}")
            return true
        }

        func Run(noDiagnostics: bool, noCommands: bool, noPdf: bool) -> Result {
            var root = Helpers.RepoRoot()

            Helpers.Sep("SPEC · GENERATE")
            if (not $noDiagnostics) { WriteDiagnostics($root) }
            if (not $noCommands)    { WriteCommandReference($root) }

            var built = false
            if (not $noPdf) {
                Helpers.Sep("SPEC · PDF")
                $built = WritePdf($root)
            }

            return new Result(
                (not $noDiagnostics),
                (not $noCommands),
                $built,
                PdfPath($root))
        }
    }

    module Pipeline {
        func BumpVersionWithoutPublish() {
            var root = Helpers.RepoRoot()
            var statePath = $root | join -p ".tosh-publish-state"
            var pkgbuildPath = $root | join -p "packaging" "archlinux" "PKGBUILD"
            var extensionPackagePath = Publish.ExtensionPackagePath($root)
            var extensionPackageLockPath = Publish.ExtensionPackageLockPath($root)
            var state = Publish.ReadState($statePath)
            var calver = Publish.CurrentCalVer()
            var nextPublish = ($calver == $state.CalVer ? ($state.Publish + 1) : 1)
            var next = new Publish.State($calver, $nextPublish, $state.DotnetMajor)
            var originalPkgbuild = read-file $pkgbuildPath
            var originalExtensionPackage = null
            var originalExtensionPackageLock = null
            if ((is-file $extensionPackagePath).IsFile) {
                $originalExtensionPackage = read-file $extensionPackagePath
            }
            if ((is-file $extensionPackageLockPath).IsFile) {
                $originalExtensionPackageLock = read-file $extensionPackageLockPath
            }

            Helpers.Sep("ALL · VERSION")
            try {
                Publish.WriteState($statePath, $next.CalVer, $next.Publish, $next.DotnetMajor)
                Publish.UpdatePkgbuild($pkgbuildPath, Publish.GetVersion($next))
                Publish.UpdateExtensionVersion($root, $next)
                Publish.VerifyReleaseMetadata($root, $next)
                Helpers.Ok($"Version: {Publish.GetVersion($next)}")
            } catch ($error) {
                Publish.WriteState($statePath, $state.CalVer, $state.Publish, $state.DotnetMajor)
                write-file $pkgbuildPath $originalPkgbuild | ignore
                if ($originalExtensionPackage != null) {
                    write-file $extensionPackagePath $originalExtensionPackage | ignore
                }
                if ($originalExtensionPackageLock != null) {
                    write-file $extensionPackageLockPath $originalExtensionPackageLock | ignore
                }
                throw $error
            }
        }

        func Run(
            bump: bool,
            noClean: bool,
            skipTests: bool,
            noPublish: bool,
            noInstall: bool,
            noVsix: bool,
            targets: string,
            spec: bool = false) {

            var root = Helpers.RepoRoot()
            var workspaceLock = WorkspaceLock.Acquire($root, "all")
            defer { $workspaceLock.Dispose() | ignore }
            var selected = Packaging.NormalizeTargets($targets)

            Helpers.Sep("ALL · START")

            if (not $noClean) {
                Helpers.Sep("ALL · CLEAN")
                # Preserve the last committed release and extension dependencies;
                # `clean --all` remains available as an explicit destructive action.
                Cleanup.Run(false, false)
            }
            Helpers.Sep("ALL · CHECK")
            Testing.Check($skipTests, false, "all", null)

            if ($noPublish) {
                if ($bump) { BumpVersionWithoutPublish() }
                if (not $noInstall) {
                    Helpers.Sep("ALL · INSTALL")
                    Packaging.Install($selected, false, false, null)
                }
            } else {
                Helpers.Sep("ALL · PUBLISH")
                var wantsDevCompanion = ("devcompanion" in $selected)
                var releaseTargets = $selected
                    | where { $_ != "devcompanion" }
                    | collect
                if ($noInstall or not $wantsDevCompanion) {
                    Publish.Run("", "", false, false, $noInstall, (not $bump), $releaseTargets) | ignore
                } else {
                    # DevCompanion is intentionally not shipped in the release
                    # bundle. Install release targets from the bundle, then build
                    # only DevCompanion from source instead of rebuilding all five.
                    var installReleaseTargets = (($releaseTargets | count) > 0)
                    var publishTargets = ($installReleaseTargets
                        ? $releaseTargets
                        : ["tosh", "lsp", "mcp", "tome", "crumb"])
                    Publish.Run(
                        "", "", false, false,
                        (not $installReleaseTargets),
                        (not $bump),
                        $publishTargets) | ignore
                    Helpers.Sep("ALL · INSTALL DEVCOMPANION")
                    Packaging.Install(["devcompanion"], false, false, null)
                }
            }

            if (not $noVsix) {
                Helpers.Sep("ALL · VSIX")
                Extension.BuildVsix(false, false, "http://localhost:7781")
            }

            ## Opt-in: the specification needs a LaTeX toolchain the rest of the
            ## pipeline does not, and a release should not fail for want of one.
            ## It runs after publish so the command reference is exported from the
            ## build that was just installed.
            if ($spec) {
                Helpers.Sep("ALL · SPEC")
                Spec.Run(false, false, false) | ignore
            }

            Helpers.Sep("ALL · DONE")
            Helpers.Ok("Full pipeline completed successfully.")
        }
    }
}

## @summary Open the TōSh workspace in Tōme.
subcommand edit {
    var workspace = Build.Helpers.RepoRoot() | join -p "ToSh.tome"
    tome $workspace
}

## @summary Inspect or update the persisted version state.
subcommand version {
    ## @summary Two-digit CalVer year; omitted preserves the current year.
    flag year: int? = null
    ## @summary CalVer month in 1..12; omitted preserves the current month.
    flag month: int? = null
    ## @summary Publish counter; omitted preserves the current counter.
    flag publish: int? = null
    ## @summary .NET SDK major stamped into the version.
    flag dotnet: int? = null
    ## @summary Preview the resulting version without modifying files.
    flag dryRun: bool = false

    var root = Build.Helpers.RepoRoot()
    var workspaceLock = Build.WorkspaceLock.Acquire($root, "version")
    try {
        var statePath = $root | join -p ".tosh-publish-state"
        var pkgbuildPath = $root | join -p "packaging" "archlinux" "PKGBUILD"
        var state = Build.Publish.ReadState($statePath)
        var hasChanges = ($year != null or $month != null or $publish != null or $dotnet != null)

        if (not $hasChanges) {
            var parts = Build.Publish.ParseCalVer($state.CalVer)
            Build.Helpers.Sep("VERSION")
            Build.Helpers.Ok($"Current: {Build.Publish.GetVersion($state)}")
            Build.Helpers.Info($"  CalVer:  {$state.CalVer}  (year={$parts[0]}, month={$parts[1]})")
            Build.Helpers.Info($"  Publish: {$state.Publish}")
            Build.Helpers.Info($"  Dotnet:  {$state.DotnetMajor}")
            Build.Helpers.Info($"  State:   {$statePath}")
            return
        }

        var current = Build.Publish.ParseCalVer($state.CalVer)
        var nextYear = ($year ?? $current[0])
        var nextMonth = ($month ?? $current[1])
        var nextPublish = ($publish ?? $state.Publish)
        var nextDotnet = ($dotnet ?? $state.DotnetMajor)

        if ($nextYear < 0 or $nextYear > 99) { throw $"--year must be in 0..99 (got {$nextYear})" }
        if ($nextMonth < 1 or $nextMonth > 12) { throw $"--month must be in 1..12 (got {$nextMonth})" }
        if ($nextPublish < 1) { throw $"--publish must be >= 1 (got {$nextPublish})" }
        if ($nextDotnet < 1) { throw $"--dotnet must be >= 1 (got {$nextDotnet})" }

        var next = new Build.Publish.State($"{$nextYear}.{$nextMonth}", $nextPublish, $nextDotnet)
        Build.Helpers.Sep("VERSION")
        styled $"{Build.Publish.GetVersion($state)} → {Build.Publish.GetVersion($next)}" --fg bright-yellow --bold | writeline

        if ($dryRun) {
            Build.Helpers.Info("(--dry-run) state, PKGBUILD, and extension package unchanged.")
            return
        }

        var extensionPackagePath = Build.Publish.ExtensionPackagePath($root)
        var extensionPackageLockPath = Build.Publish.ExtensionPackageLockPath($root)
        var originalPkgbuild = null
        var originalExtensionPackage = null
        var originalExtensionPackageLock = null
        if ((is-file $pkgbuildPath).IsFile) { $originalPkgbuild = read-file $pkgbuildPath }
        if ((is-file $extensionPackagePath).IsFile) {
            $originalExtensionPackage = read-file $extensionPackagePath
        }
        if ((is-file $extensionPackageLockPath).IsFile) {
            $originalExtensionPackageLock = read-file $extensionPackageLockPath
        }

        try {
            Build.Publish.WriteState($statePath, $next.CalVer, $next.Publish, $next.DotnetMajor)
            Build.Helpers.Ok($"Wrote {$statePath}")

            if ($originalPkgbuild != null) {
                Build.Publish.UpdatePkgbuild($pkgbuildPath, Build.Publish.GetVersion($next))
                Build.Helpers.Ok($"Updated {$pkgbuildPath}")
            } else {
                Build.Helpers.Warn($"PKGBUILD not found at {$pkgbuildPath}; skipped.")
            }

            Build.Publish.UpdateExtensionVersion($root, $next)
            Build.Publish.VerifyReleaseMetadata($root, $next)
        } catch ($error) {
            Build.Publish.WriteState($statePath, $state.CalVer, $state.Publish, $state.DotnetMajor)
            if ($originalPkgbuild != null) { write-file $pkgbuildPath $originalPkgbuild | ignore }
            if ($originalExtensionPackage != null) {
                write-file $extensionPackagePath $originalExtensionPackage | ignore
            }
            if ($originalExtensionPackageLock != null) {
                write-file $extensionPackageLockPath $originalExtensionPackageLock | ignore
            }
            throw $error
        }
    } finally {
        $workspaceLock.Dispose() | ignore
    }
}

## @summary Build, version-bump, package, and optionally install TōSh.
subcommand publish {
    ## @summary Target Runtime Identifier; empty selects the current platform.
    flag rid: string = ""
    ## @summary Publish output below artifacts/publish; empty selects the RID/mode default.
    flag output: string = ""
    ## @summary Enable partial IL trimming.
    flag trimmed: bool = false
    ## @summary Produce a framework-dependent build.
    flag frameworkDependent: bool = false
    ## @summary Skip the makepkg installation step.
    flag noInstall: bool = false
    ## @summary Reuse the persisted version instead of incrementing it.
    flag noBump: bool = false
    ## @summary Arch package targets installed from the published bundle.
    flag targets: string = "all"
    ## @summary Replace the current process with the published binary on success.
    flag exec: bool = false

    var result = Build.Publish.Run(
        $rid,
        $output,
        $trimmed,
        $frameworkDependent,
        $noInstall,
        $noBump,
        $targets)
    if ($exec) { exec $result.Binary }
    $result
}

## @summary Run the test suite, optionally filtered by group or pattern.
subcommand test {
    ## @summary Named test group; `all` runs the complete suite.
    flag group: string = "all"
    ## @summary Explicit xUnit filter; overrides `group`.
    flag filter: string = ""
    ## @summary Rerun failures recorded in the previous TRX result.
    flag failed: bool = false
    ## @summary List the available test groups and exit.
    flag listGroups: bool = false
    ## @summary Reuse existing build output.
    flag noBuild: bool = false
    ## @summary Enable detailed console logging.
    flag verbose: bool = false
    ## @summary Enable the test-host blame collector.
    flag blame: bool = false
    ## @summary Custom results directory.
    flag results: string = ""

    if ($listGroups) {
        writeline """
            Available test groups:
              repl        engine      tui         concurrency
              lsp         display     config      data
              pipeline    system      clr         syntax
              all         (default — run everything)
            """
        return
    }

    Build.Testing.Run(
        $group,
        ($filter == "" ? null : $filter),
        $failed,
        $noBuild,
        $verbose,
        $blame,
        ($results == "" ? null : $results))
}

## @summary Build the solution and optionally run tests.
subcommand check {
    ## @summary Stop after a successful build.
    flag noTest: bool = false
    ## @summary Run a focused smoke-test filter.
    flag fast: bool = false
    ## @summary Named test group to run after the build.
    flag group: string = "all"
    ## @summary Explicit xUnit filter; overrides `fast`.
    flag filter: string = ""

    Build.Testing.Check(
        $noTest,
        $fast,
        $group,
        ($filter == "" ? null : $filter))
}

## @summary Remove build and test artifacts.
subcommand clean {
    ## @summary Show what would be removed without changing the filesystem.
    flag dryRun: bool = false
    ## @summary Remove all transient build outputs, publish artifacts, packaging staging, and dependencies.
    flag all: bool = false
    ## @summary Clean Arch packaging build trees (packaging/archlinux/src, pkg) and old package archives.
    flag packaging: bool = false
    ## @summary Clean build outputs (bin, obj) in tools and benchmarks.
    flag tools: bool = false
    ## @summary Clean production publish output directory (artifacts/publish).
    flag publish: bool = false
    ## @summary Remove all built package files (.pkg.tar.zst, .vsix).
    flag packages: bool = false

    Build.Cleanup.Run($dryRun, $all, $packaging, $tools, $publish, $packages)
}

## @summary Print a digest of the current repository state.
subcommand info {
    Build.Repository.ShowInfo()
}

## @summary Build the solution and surface compiler diagnostics.
subcommand errors {
    ## @summary Emit a JSON array instead of styled diagnostic lines.
    flag json: bool = false
    Build.Diagnostics.Show($json)
}

## @summary Benchmark the canonical TōSh publish configurations.
subcommand bench {
    ## @summary Target Runtime Identifier; empty selects the current platform.
    flag rid: string = ""
    ## @summary Number of warm-start samples per configuration.
    flag runs: int = 5
    ## @summary Benchmark output directory.
    flag output: string = ""
    ## @summary Compare timings with the latest benchmark history entry.
    flag compare: bool = false

    Build.Benchmark.Run($rid, $runs, $output, $compare)
}

## @summary Build and install selected Arch package targets.
subcommand install {
    ## @summary Target, comma-separated targets, target array, or `all`.
    arg targets = "all"
    ## @summary Package the validated canonical publish bundle instead of rebuilding from source.
    flag reusePublished: bool = false
    ## @summary Also install MIME, icon, desktop, and GtkSourceView integration.
    flag linuxDesktop: bool = false
    ## @summary Install desktop integration under `/usr/share` using sudo as needed.
    flag system: bool = false

    var prebuiltRoot = null
    if ($reusePublished) {
        var selected = Build.Packaging.NormalizeTargets($targets)
        if ("devcompanion" in $selected) {
            throw "DevCompanion is not part of the canonical publish bundle; install it from source."
        }
        $prebuiltRoot = Build.Helpers.RepoRoot()
            | join -p "artifacts" "publish" "linux-x64" "single-file"
    }
    Build.Packaging.Install($targets, $linuxDesktop, $system, $prebuiltRoot)
}

## @summary Sync the VS Code extension into the local extensions directory.
subcommand sync {
    ## @summary Suppress informational output from the sync script.
    flag quiet: bool = false
    ## @summary Force dependency regeneration.
    flag regenerate: bool = false

    Build.Extension.Sync($quiet, $regenerate)
}

## @summary Build, install, and optionally publish the VS Code extension package.
subcommand vsix {
    ## @summary Build the VSIX without installing it into local VS Code.
    flag noInstall: bool = false
    ## @summary Skip publishing to the local Valinor Marketplace.
    flag noPublish: bool = false
    ## @summary Marketplace base URL.
    flag marketplaceUrl: string = "http://localhost:7781"

    Build.Extension.BuildVsix($noInstall, $noPublish, $marketplaceUrl)
}

## @summary Regenerate the specification's generated chapters and build its PDF.
subcommand spec {
    ## @summary Skip regenerating the diagnostic code reference.
    flag noDiagnostics: bool = false
    ## @summary Skip regenerating the command reference from runtime metadata.
    flag noCommands: bool = false
    ## @summary Regenerate the inputs without running LaTeX.
    flag noPdf: bool = false

    Build.Spec.Run($noDiagnostics, $noCommands, $noPdf)
}

## @summary Run the complete clean, check, publish, install, and VSIX pipeline.
subcommand all {
    ## @summary Increment the version exactly once during the pipeline.
    flag bump: bool = false
    ## @summary Skip artifact cleanup.
    flag noClean: bool = false
    ## @summary Build without running tests.
    flag skipTests: bool = false
    ## @summary Skip the standalone publish step.
    flag noPublish: bool = false
    ## @summary Skip Arch package installation.
    flag noInstall: bool = false
    ## @summary Skip VSIX packaging and publication.
    flag noVsix: bool = false
    ## @summary Arch package targets installed by the release pipeline.
    flag targets: string = "all"
    ## @summary Also regenerate the specification and build its PDF (needs latexmk).
    flag spec: bool = false

    Build.Pipeline.Run(
        $bump,
        $noClean,
        $skipTests,
        $noPublish,
        $noInstall,
        $noVsix,
        $targets,
        $spec)
}
