#!/usr/bin/env tosh
# build.tosh — TōSh unified build system
#
# Subcommands:
#   publish   Build, version-bump, package, and install TōSh
#   test      Run the test suite (whole or filtered by group / pattern)
#   check     Build all projects without installing (CI gate)
#   clean     Remove build artifacts, bin/obj, TestResults
#   bench     Benchmark publish configurations
#
# Usage:
#   scripts/build.tosh <subcommand> [options]
#   scripts/build.tosh --help

# ─────────────────────────────────────────────────────────────────────────────
# Shared helpers
# ─────────────────────────────────────────────────────────────────────────────

type NonEmptyString = string where (not String.IsNullOrEmpty(_))
type DirectoryPath = string where (is-dir _).IsDirectory

## Prints a success message with a green checkmark.
## @param=msg The message to display (must be non-empty).
func ok(msg: NonEmptyString) => styled $"  ✓ {$msg}" --fg bright-green | writeline

## Prints an informational message in gray.
## @param=msg The message to display (must be non-empty).
func info(msg: NonEmptyString) => styled $"  {$msg}" --fg gray --dim | writeline

## Prints a warning message with a yellow warning symbol.
## @param=msg The message to display (must be non-empty).
func warn(msg: NonEmptyString) => styled $"  ⚠ {$msg}" --fg yellow | writeline

## Prints an error message with a red cross symbol.
## @param=msg The message to display (must be non-empty).
func fail(msg: NonEmptyString) => styled $"  ✗ {$msg}" --fg bright-red --bold | writeline

## Asserts that the last command succeeded.
## @param=label The label to display in case of failure (must be non-empty).
func assert_ok(label: NonEmptyString) {
    if ($tosh.Last.ExitCode != 0) {
        throw $"{$label} failed (exit {$tosh.Last.ExitCode})"
    }
}

func repo_root() -> DirectoryPath => (dirname (dirname (realpath $tosh.Script.Path)))

func ts_now() -> string => ((date now).ToString("yyyy-MM-ddTHH:mm:ssZ"))

func history_path(root: DirectoryPath) -> string => $root | join -p "artifacts" "history.jsonl"

func history_append(root: DirectoryPath, line: NonEmptyString) {
    var path = history_path $root
    mkdir -p (realpath (dirname $path)) | ignore
    echo $line out>> $path
}

func history_read_last(root: DirectoryPath, kind: NonEmptyString) -> string? {
    var path = (history_path $root)
    if (not ((is-file $path).IsFile)) { return null }
    var last = null
    for line in (cat $path | lines) {
        if ($line =~ $"\"kind\":\\s*\"{$kind}\"") { $last = $line }
    }
    return $last
}

func sep(label: NonEmptyString) {
    var pad = (28 - (($label | count) // 2))
    if ($pad < 2) { $pad = 2 }
    var line = $"{'─' * $pad}[ {$label} ]{'─' * $pad}"
    styled $line --fg bright-cyan --bold | writeline
}

# ─────────────────────────────────────────────────────────────────────────────
# Versioning (shared with publish subcommand)
# ─────────────────────────────────────────────────────────────────────────────

record PublishState(CalVer: string, Publish: int)

func read_publish_state(path: string) -> PublishState {
    var line = (cat $path | lines | first)
    var colon = ($line.IndexOf(":"))
    if ($colon < 0) { throw $".tosh-publish-state is corrupt: {$line}" }
    var calver = ($line.Substring(0, $colon))
    var num = System.Convert.ToInt32(($line.Substring($colon + 1)))
    return new PublishState($calver, $num)
}

func write_publish_state(path: string, calver: string, num: int) {
    write-file $path $"{$calver}:{$num}" | ignore
}

func update_pkgbuild_version(path: string, version: string) => read-file $path | replace -r "pkgver=.*" $"pkgver={$version}" | write-file $path | ignore

func compute_calver() -> string => (date now).ToString("yy.M")

# ─────────────────────────────────────────────────────────────────────────────
# Publish configuration
# ─────────────────────────────────────────────────────────────────────────────

sealed class PublishPlan {
    prop Trimmed: bool = false
    prop SelfContained: bool = true
    prop NoInstall: bool = false
    prop ExecAfter: bool = false
    prop NoBump: bool = false

    shy prop _rid: string? = null
    shy prop _dir: string? = null
    shy prop _binary: string? = null

    prop RepoRoot: string { get => repo_root() }

    prop RuntimeId: string {
        get => ($this._rid ?? System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier)
        set => $this._rid = $value
    }

    prop ModeDir: string { get => ($this.Trimmed ? "single-file-trimmed" : "single-file") }

    prop Directory: string {
        get => $this.effective_directory()
        set => $this._dir = $value
    }

    prop Binary: string? {
        get => $this._binary
        set => $this._binary = $value
    }

    prop BuildArgs: array { get => $this.make_build_args() }
    prop PublishArgs: array { get => $this.make_publish_args() }

    PublishPlan() {}

    shy func effective_directory() -> string {
        if ($this._dir != null and $this._dir != "") {
            return System.IO.Path.GetFullPath($this._dir)
        }
        return $this.RepoRoot | join -p "artifacts" "publish" $this.RuntimeId $this.ModeDir
    }

    shy func make_build_args() -> array {
        return [
            "build", $"{$this.RepoRoot}/src/Tosh.Cli/Tosh.Cli.csproj",
            "-c", "Release", "-r", $this.RuntimeId,
            $"-p:SelfContained={$this.SelfContained}",
        ]
    }

    shy func make_publish_args() -> array {
        var args = [
            "publish", $"{$this.RepoRoot}/src/Tosh.Cli/Tosh.Cli.csproj",
            "-c", "Release", "-r", $this.RuntimeId,
            "-o", $this.Directory,
            "-p:PublishSingleFile=true",
            "-p:PublishReadyToRun=true",
            "-p:EnableCompressionInSingleFile=false",
            "-p:DebugType=None",
            "-p:DebugSymbols=false",
            "-p:DisableToshVsCodeExtensionSync=true",
            $"-p:SelfContained={$this.SelfContained}",
        ]
        if ($this.Trimmed) {
            $args = (echo $args ["-p:PublishTrimmed=true", "-p:TrimMode=partial"] | flatten | collect)
        }
        return $args
    }
}

record BuildResult(
    Binary: string,
    Size: StorageSize,
    RID: string,
    Output: string,
    SelfContained: bool,
    Trimmed: bool,
    Duration: string,
    Version: string
)

# ─────────────────────────────────────────────────────────────────────────────
# Test group → xUnit FullyQualifiedName filter pattern
# ─────────────────────────────────────────────────────────────────────────────

func group_filter_pattern(group: string) -> string? {
    switch ($group) {
        case "repl"        { return "ReplLineEditor|ReplCompletion|ReplInput|ReplHistory" }
        case "syntax"      { return "SyntaxHighlighter" }
        case "engine"      { return "EngineTests|ComplexCommand|Comprehension|ExpressionEval" }
        case "tui"         { return "TuiCommand|TuiCore|TuiInline|TuiScreen|ConfigBrowser|ConsolePager" }
        case "concurrency" { return "Concurrency|ScopeAndChannel|SpawnCommand|ConcurrentRedirection" }
        case "lsp"         { return "LspFeature|McpServer" }
        case "display"     { return "DisplayEngine|DisplayProfile|ObjectFormatter|DiagnosticRenderer" }
        case "config"      { return "ConfigCommand|ConfigCollection|VarsCommand" }
        case "data"        { return "DataProcessing|StructuredData|Matrix|Vector|StreamCommand|StreamHandle" }
        case "pipeline"    { return "PipelineData|PipelineHardening|MixedPipeline" }
        case "system"      { return "SystemdJson|TimeCommand|UtilityCommand|ExternalCommand|ExecCommand|StartupLoader" }
        case "clr"         { return "CliInvocation|CommandIntrospection|MemberPath|Rune|NativeInterop" }
        case "all"         { return null }
        default {
            throw $"""
                Unknown test group '{$group}'.
                Valid groups: repl syntax engine tui concurrency lsp display config data pipeline system clr all
            """
        }
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# Subcommand: publish
# ─────────────────────────────────────────────────────────────────────────────
## Builds the solution, version-bumps, updates PKGBUILD, publishes to a directory, optionally installs via makepkg, and optionally executes the new binary.
subcommand publish {
    ## When set, specifies the target runtime identifier (RID) for publishing (e.g. win-x64, linux-x64, osx-arm64). Defaults to the current platform's RID.
    flag rid: string = ""

    ## When set, specifies the output directory for the published binaries. Defaults to artifacts/publish/{rid}/{mode}.
    flag output: string = ""

    ## When set, enables aggressive trimming for a smaller single-file binary (may cause issues with reflection or dynamic code generation).
    flag trimmed: bool = false

    ## When set, specifies whether the published binary should be framework-dependent. Defaults to false (self-contained).
    flag frameworkDependent: bool = false

    ## When set, skips the installation step (makepkg) after publishing, useful for manual testing or CI.
    flag noInstall: bool = false

    ## When set, prevents automatic version bumping and uses the existing version from the publish state (useful for patch releases or manual control over versioning).
    flag noBump: bool = false

    ## When set, executes the published binary immediately after a successful publish (use with caution, especially if the new version has breaking changes or bugs). Defaults to false.
    flag exec: bool = false

    var plan = new PublishPlan()
    if ($rid != "")    { $plan.RuntimeId = $rid }
    if ($output != "") { $plan.Directory = $output }
    $plan.Trimmed       = $trimmed
    $plan.SelfContained = (not $frameworkDependent)
    $plan.NoInstall     = $noInstall
    $plan.NoBump        = $noBump
    $plan.ExecAfter     = $exec

    var root = $plan.RepoRoot
    var state_path = $root | join -p ".tosh-publish-state"
    var pkgbuild_path = $root | join -p "packaging" "archlinux" "PKGBUILD"
    var dotnet_major = 10

    var orig_state = (read_publish_state $state_path)
    var orig_calver = $orig_state.CalVer
    var orig_publish = $orig_state.Publish
    var orig_pkgbuild = cat $pkgbuild_path

    var new_version = $"{$orig_calver}.{$orig_publish}.{$dotnet_major}"

    if (not $plan.NoBump) {
        var current_calver = (compute_calver)
        var new_publish = ($current_calver == $orig_calver ? ($orig_publish + 1) : 1)
        $new_version = $"{$current_calver}.{$new_publish}.{$dotnet_major}"
        styled $"Version: {$orig_calver}.{$orig_publish}.{$dotnet_major} → {$new_version}" --fg bright-yellow --bold | writeline
        write_publish_state $state_path $current_calver $new_publish
        update_pkgbuild_version $pkgbuild_path $new_version
    }
    else {
        info $"Using existing version {$new_version} (--no-bump)"
    }

    try {
        mkdir -p $plan.Directory | ignore
        var t0 = date now

        sep "BUILD"
        dotnet ...$plan.BuildArgs
        assert_ok "dotnet build"

        sep "PUBLISH"
        dotnet ...$plan.PublishArgs
        assert_ok "dotnet publish"

        sep "PUBLISH TOOLS"
        var tool_publish_args = [
            "-c", "Release", "-r", $plan.RuntimeId,
            "-o", $plan.Directory,
            "-p:PublishSingleFile=true",
            "-p:PublishReadyToRun=true",
            "-p:EnableCompressionInSingleFile=false",
            "-p:DebugType=None",
            "-p:DebugSymbols=false",
            $"-p:SelfContained={$plan.SelfContained}",
        ]
        dotnet publish $"{$root}/src/Tosh.Lsp/Tosh.Lsp.csproj" ...$tool_publish_args
        assert_ok "dotnet publish Tosh.Lsp"
        ok "Published Tosh.Lsp"

        dotnet publish $"{$root}/src/Tosh.Mcp/Tosh.Mcp.csproj" ...$tool_publish_args
        assert_ok "dotnet publish Tosh.Mcp"
        ok "Published Tosh.Mcp"

        var elapsed = (((date now) - $t0).ToString("hh\\:mm\\:ss\\.fff"))

        # Find the published binary
        var candidates = [
            ($plan.Directory | join -p "tosh"),
            ($plan.Directory | join -p "tosh.exe"),
            ($plan.Directory | join -p "Tosh.Cli"),
            ($plan.Directory | join -p "Tosh.Cli.exe"),
        ]
        var found_binary = null
        for c in ($candidates) {
            if ((is-file $c).IsFile) { $found_binary = $c; break }
        }
        if ($found_binary == null) { throw $"No binary found in {$plan.Directory}" }

        var target_name = "tosh"
        if ($plan.RuntimeId starts-with "win-") { $target_name = "tosh.exe" }
        var target_path = $plan.Directory | join -p $target_name
        if ($found_binary != $target_path) {
            rm -f $target_path
            mv $found_binary $target_path
        }
        $plan.Binary = $target_path

        var binfo = (ls $plan.Binary | first)

        if (not $plan.NoInstall) {
            sep "INSTALL"
            info "Installing via PKGBUILD (makepkg -si)..."
            var pkgdir = dirname $pkgbuild_path
            var prev_cwd = (pwd).FullName
            cd $pkgdir
            try {
                makepkg -sif --noconfirm
                assert_ok "makepkg"
            } finally {
                cd $prev_cwd
            }

            if (not ($plan.RuntimeId starts-with "win-")) {
                try {
                    info "Setting cap_net_raw on /usr/bin/tosh..."
                    sudo setcap cap_net_raw+ep /usr/bin/tosh
                } catch ($e) {
                    warn $"Could not set cap_net_raw: {$e.Message}"
                }
            }
        }

        sep "DONE"
        ok $"Binary: {$plan.Binary}"
        ok $"Version: {$new_version}"

        if ($plan.ExecAfter) { exec $plan.Binary }

        return new BuildResult(
            $plan.Binary,
            $binfo.Size,
            $plan.RuntimeId,
            $plan.Directory,
            $plan.SelfContained,
            $plan.Trimmed,
            $elapsed,
            $new_version
        )
    } catch ($err) {
        fail $"Publish failed: {$err}"
        if (not $plan.NoBump) {
            warn "Rolling back version state..."
            write_publish_state $state_path $orig_calver $orig_publish
            $orig_pkgbuild | write-file $pkgbuild_path | ignore
        }
        throw $err
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# Subcommand: test
# ─────────────────────────────────────────────────────────────────────────────

func trx_failed_filter(trx_path: string) -> string? {
    if (not ((is-file $trx_path).IsFile)) { return null }
    var content = System.IO.File.ReadAllText($trx_path)
    var elem_rx = new System.Text.RegularExpressions.Regex("(?s)<UnitTestResult\\b[^>]+outcome=\"Failed\"[^>]*(?:/>|>.*?</UnitTestResult>)")
    var name_rx = new System.Text.RegularExpressions.Regex("testName=\"([^\"]+)\"")
    var ms = $elem_rx.Matches($content)
    if ($ms.Count == 0) { return null }
    var parts = [$"(FullyQualifiedName={$nm.Groups[1].Value})" <| for match in $ms where ($name_rx.Match($match.Value).Success) let nm = $name_rx.Match($match.Value)]
    if (($parts | count) == 0) { return null }
    return ($parts | join "|")
}

record TestEntry(kind: string, ts: string, group: string, total: int, passed: int, failed: int, duration: string)

func run_tests(group: string, filter_override: string?, rerun_failed: bool, no_build: bool, verbose: bool, blame: bool, results_dir: string?) {
    var root = (repo_root)
    var slnx = $root | join -p "Tosh.slnx"
    var def_results = $root | join -p "artifacts" "test-results"
    var out_dir = ($results_dir ?? $def_results)
    var trx_path = $out_dir | join -p "last.trx"

    # --failed: load previous TRX and build filter
    if ($rerun_failed) {
        var failed_filter = (trx_failed_filter $trx_path)
        if ($failed_filter == null) {
            ok "No failed tests found in last run."
            return
        }
        $filter_override = $failed_filter
        info $"Rerunning {($failed_filter | match -r "FullyQualifiedName=" | count)} failed test(s)..."
    }

    # Build
    if (not $no_build) {
        sep "BUILD"
        dotnet build $slnx -c Debug --verbosity quiet
        assert_ok "dotnet build"
    }

    # Resolve filter
    var filter_pattern = ($filter_override ?? (group_filter_pattern $group))
    var label = ($rerun_failed ? "failed tests" : ($filter_override != null ? $"filter '{$filter_override}'" : ($group != "all" ? $"group '{$group}'" : "all tests")))

    sep $"TEST · {$label}"

    var test_args = ["test", $slnx, $"--results-directory={$out_dir}", $"--logger=trx;LogFileName=last.trx"]
    if ($no_build) { $test_args = (chain $test_args ["--no-build"] | collect) }

    if ($filter_pattern != null and $filter_pattern != "") {
        $test_args = (chain $test_args [$"--filter={$filter_pattern}"] | collect)
    }
    else if ($filter_override != null and $filter_override != "") {
        $test_args = (chain $test_args [$"--filter={$filter_override}"] | collect)
    }

    if ($verbose) { $test_args = (chain $test_args ["--logger", "console;verbosity=detailed"] | collect) }
    if ($blame)   { $test_args = (chain $test_args ["--blame"] | collect) }

    var t0 = date now
    dotnet ...$test_args
    var exit_code = $tosh.Last.ExitCode
    var elapsed = (((date now) - $t0).ToString("hh\\:mm\\:ss\\.fff"))

    # Parse totals from TRX for history
    var total_count = 0
    var passed_count = 0
    var failed_count = 0
    if ((is-file $trx_path).IsFile) {
        var trx = System.IO.File.ReadAllText($trx_path)
        var stats = echo $trx | parse -s "total=\"(?<Total>\\d+)\".*?passed=\"(?<Passed>\\d+)\".*?failed=\"(?<Failed>\\d+)\"" | first
        if ($stats != null) {
            $total_count  = $stats.Total as int
            $passed_count = $stats.Passed as int
            $failed_count = $stats.Failed as int
        }
    }

    sep "RESULTS"
    if ($exit_code == 0) {
        ok $"All tests passed ({$elapsed})"
        var entry = new TestEntry("test", (ts_now), $group, $total_count, $passed_count, $failed_count, $elapsed)
        history_append $root ($entry | to json).Replace("\n", "").Replace("  ", "")
    }
    else {
        fail $"Tests FAILED (exit {$exit_code}, {$elapsed})"
        throw "Test run failed"
    }
}

## Runs the test suite, optionally filtered by group or xUnit filter pattern, with options for rerunning failed tests, skipping build, and outputting results to a specific directory.
subcommand test {
    ## When set, only runs tests from the specified group (see `test --list-groups`).
    flag group: string = "all"

    ## When set, only runs tests matching the given xUnit FullyQualifiedName filter pattern (overrides --group).
    flag filter: string = ""

    ## When set, reruns only the tests that failed in the previous run (requires --results to locate the TRX file).
    flag failed: bool = false

    ## When set, lists available test groups and exits.
    flag listGroups: bool = false

    ## When set, skips the build step and runs tests against the last build output (useful for iterative test runs without rebuilding).
    flag noBuild: bool = false

    ## When set, outputs detailed test execution logs to the console.
    flag verbose: bool = false

    ## When set, enables the xUnit Blame logger to capture additional diagnostics on test failures (requires --results to locate the TRX file).
    flag blame: bool = false

    ## When set, specifies a custom directory for test results output (must contain the TRX file for --failed and --blame to work).
    flag results: string = ""

    if ($listGroups) {
        writeline """
            Available test groups:
              repl        engine      tui         concurrency
              lsp         display     config      data
              pipeline    system      clr         syntax
              all         (default — run everything)
            """
        return
    }

    run_tests $group ($filter == "" ? null : $filter) $failed $noBuild $verbose $blame ($results == "" ? null : $results)
}

# ─────────────────────────────────────────────────────────────────────────────
# Subcommand: check (build only, no install — for CI)
# ─────────────────────────────────────────────────────────────────────────────
## Builds the entire solution without installing, used as a CI gate to ensure no build errors before running tests.
subcommand check {
    ## When set, skips running tests after building, only checks that the build succeeds.
    flag noTest: bool = false

    ## When set, only runs a subset of tests after building, filtered by group (see `test --list-groups`).
    flag fast: bool = false

    ## When set, only runs tests matching the given xUnit FullyQualifiedName filter pattern (overrides --fast).
    flag group: string = "all"

    ## When set, only runs tests matching the given xUnit FullyQualifiedName filter pattern (overrides --fast).
    flag filter: string = ""

    var root = repo_root
    var slnx = $root | join -p "Tosh.slnx"

    sep "CHECK · BUILD"
    dotnet build $slnx -c Debug --verbosity minimal
    assert_ok "dotnet build"
    ok "Build succeeded"

    if (not $noTest) {
        var smoke_filter = "EngineTests|ComplexCommand|Comprehension|ExpressionEval|SystemdJson|TimeCommand|UtilityCommand|ExternalCommand|ExecCommand|StartupLoader|PipelineData|PipelineHardening|MixedPipeline"
        var effective_filter = ($fast ? $smoke_filter : ($filter == "" ? null : $filter))
        run_tests $group $effective_filter false true false false null
    }

    sep "CHECK PASSED"
}

# ─────────────────────────────────────────────────────────────────────────────
# Subcommand: clean
# ─────────────────────────────────────────────────────────────────────────────
## Cleans build artifacts: bin/obj directories, test results, published outputs.
subcommand clean {
    ## When set, performs a dry run without actually deleting anything, printing what would be removed.
    flag dryRun: bool = false

    ## When set, also removes published outputs and node_modules (full clean).
    flag all: bool = false

    var root = repo_root
    var removed = 0

    func remove_dir(path: string) {
        if ((is-dir $path).IsDirectory) {
            if ($dryRun) {
                info $"[dry-run] would remove: {$path}"
            }
            else {
                rm -rf $path | ignore
                info $"removed: {$path}"
            }
            $removed += 1
        }
    }

    sep "CLEAN"

    # dotnet clean removes bin/obj; we also nuke stale ones
    if (not $dryRun) {
        dotnet clean $"{$root}/Tosh.slnx" --verbosity quiet
    }
    else {
        info "[dry-run] would run: dotnet clean"
    }

    # Find and remove any surviving bin/obj/TestResults directories
    var dirs_to_scan = chain ["bin", "obj", "TestResults"]
    
    for name in $dirs_to_scan {
        var dir_entries = find $"{$root}/src" $"{$root}/tests" -type d -name $name
        for entry in $dir_entries {
            if ($entry.FullName != null) {
                remove_dir $entry.FullName
            }
        }
    }

    remove_dir $"{$root}/artifacts/test-results"

    if ($all) {
        remove_dir $"{$root}/artifacts/publish"
        remove_dir $"{$root}/editor/vscode/tosh.tosh-lang/node_modules"
    }

    sep "DONE"
    if ($removed == 0) {
        ok "Already clean."
    } else if ($removed == 1) {
        ok "Removed 1 directory."
    } else {
        ok $"Removed {$removed} directories."
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# Subcommand: info
# ─────────────────────────────────────────────────────────────────────────────
## Displays information about the current repository state, including version, .NET SDK version, Git branch and status, and last test/bench runs.
subcommand info {
    var root = repo_root
    var state_path = $root | join -p ".tosh-publish-state"

    sep "INFO"

    # Version
    var state = read_publish_state $state_path
    ok $"Version:   {$state.CalVer}.{$state.Publish}.10"

    # .NET SDK
    var sdk_job = spawn dotnet --version | wait-for | first
    var sdk_ver = echo $sdk_job.Output | first
    ok $".NET SDK:  {$sdk_ver}"

    # Git
    var branch_job = spawn git -C $root rev-parse --abbrev-ref HEAD | wait-for | first
    var branch = echo $branch_job.Output | first
    var status_job = spawn git -C $root status --porcelain | wait-for | first
    var dirty = $status_job.Output | count
    var git_str = $dirty > 0 ? $"{$branch} ({$dirty} modified)" : $"{$branch} (clean)"
    ok $"Git:       {$git_str}"

    # Last test run
    var last_test = history_read_last $root "test"
    if ($last_test != null) {
        var t = ($last_test | from json)
        ok $"Last test: {$t.ts}  group={$t.group}  {$t.passed}/{$t.total} passed  {$t.duration}"
    }
    else {
        info "Last test: (no history yet)"
    }

    # Last bench run
    var last_bench = history_read_last $root "bench"
    if ($last_bench != null) {
        var b = $last_bench | from json
        ok $"Last bench: {$b.ts}  sc cold={$b.sc_cold_ms}ms warm={$b.sc_warm_ms}ms"
    }
    else {
        info "Last bench: (no history yet)"
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# Subcommand: errors
# ─────────────────────────────────────────────────────────────────────────────

record Diag(Severity: string, Code: string, File: string, Line: int, Col: int, Message: string)

## Builds the solution and parses compiler errors/warnings from the output, optionally emitting as JSON.
subcommand errors {
    ## When set, outputs diagnostics as JSON instead of human-readable text.
    flag json: bool = false

    var root = repo_root
    var slnx = $root | join -p "Tosh.slnx"

    if (not $json) { sep "ERRORS · BUILD" }

    var job = spawn dotnet build $slnx -c Debug -nologo | wait-for | first
    var all_lines = chain $job.Output $job.ErrorLines | collect

    var diag_rx = new System.Text.RegularExpressions.Regex("^\\s*(.+?)\\((\\d+),(\\d+)\\):\\s*(error|warning)\\s+(\\w+):\\s*(.+?)(?:\\s*\\[.+?\\])?\\s*$")

    var diags = [(new Diag($m.Groups[4].Value, $m.Groups[5].Value, $m.Groups[1].Value, ($m.Groups[2].Value as int), ($m.Groups[3].Value as int), $m.Groups[6].Value)) <| for raw_line in $all_lines where ($diag_rx.Match($raw_line.ToString()).Success) let m = $diag_rx.Match($raw_line.ToString())]

    if ($json) { echo $diags | to json; return }

    var errors   = $diags | where { $_.Severity == "error"   } | collect
    var warnings = $diags | where { $_.Severity == "warning" } | collect

    if (($errors | count) == 0 and ($warnings | count) == 0) {
        if ($job.ExitCode != 0) {
            fail $"Build failed (exit {$job.ExitCode}) but no diagnostics were parseable."
        }
        else {
            ok "No errors or warnings."
        }
        return
    }

    [(fail $"[{$d.Code}] {$d.File}({$d.Line},{$d.Col}): {$d.Message}") <| for d in $errors] | ignore
    [(warn $"[{$d.Code}] {$d.File}({$d.Line},{$d.Col}): {$d.Message}") <| for d in $warnings] | ignore

    info ""
    info $"{($errors | count)} error(s), {($warnings | count)} warning(s)"
}

# ─────────────────────────────────────────────────────────────────────────────
# Subcommand: bench
# ─────────────────────────────────────────────────────────────────────────────

record BenchResult(Label: string, PublishSec: string, SizeMB: string, ColdMs: string, WarmMs: string)
record BenchConfig(Label: string, DirName: string, Args: array)
record DeltaRow(Label: string, ColdDelta: string, WarmDelta: string)
record BenchEntry(kind: string, ts: string, sc_cold_ms: string, sc_warm_ms: string, sc_r2r_cold_ms: string, sc_r2r_warm_ms: string, fdd_cold_ms: string, fdd_warm_ms: string, fdd_r2r_cold_ms: string, fdd_r2r_warm_ms: string)

func measure_startup_ms(binary: string where (is-file _).IsFile) -> string {
    var result = spawn $binary --safe -c exit | wait-for | first
    return $result.Duration.TotalMilliseconds.ToString("F1")
}

func read_prev_field(prev_bench: object, key: string) -> double?
{
    var prop = $prev_bench.GetType().GetProperty($key)
    if ($prop == null) { return null }
    return ($prop.GetValue($prev_bench) as double)
}

## Runs Benchmarks against publish configurations
subcommand bench {
    ## The Runtime Identifier (RID) to publish for. Defaults to current platform RID if not specified.
    flag rid: string = ""

    ## Number of times to run the warm startup measurement (average will be reported). Default: 5
    flag runs: int = 5

    ## Output directory for published binaries and benchmark results. Defaults to "artifacts/benchmarks/{rid}" under the repo root.
    flag output: string = ""

    ## When set, compares startup times against the previous bench run and shows deltas.
    flag compare: bool = false

    if ($rid == "") { $rid = System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier }

    var root = repo_root
    var bench_dir = ($output == "") ? ($root | join -p "artifacts" "benchmarks") : $output
    var project = $root | join -p "src" "Tosh.Cli" "Tosh.Cli.csproj"

    mkdir -p $bench_dir | ignore

    # Load previous bench for --compare
    var prev_bench = null
    if ($compare) {
        var prev_line = history_read_last $root "bench"
        if ($prev_line != null) {
            $prev_bench = $prev_line | from json
            info $"Comparing against previous run from {$prev_bench.ts}"
        }
        else {
            warn "No previous bench in history; --compare will show no deltas."
        }
    }

    var configs = [
        new BenchConfig("Self-Contained",                     "sc",     ["-p:SelfContained=true"]),
        new BenchConfig("Self-Contained, Ready-To-Run",       "sc-r2r", ["-p:SelfContained=true", "-p:PublishReadyToRun=true"]),
        new BenchConfig("Framework-Dependent",                "fdd",    ["-p:SelfContained=false"]),
        new BenchConfig("Framework-Dependent, Ready-To-Run",  "fdd-r2r",["-p:SelfContained=false", "-p:PublishReadyToRun=true"]),
    ]

    var results = []

    sep "BENCH"
    info $"RID: {$rid}  runs: {$runs}  output: {$bench_dir}"
    writeline ""

    for cfg in ($configs) {
        var cfg_dir = $bench_dir | join -p $cfg.DirName
        mkdir -p $cfg_dir | ignore

        info $"Publishing '{$cfg.Label}'..."
        var pub_t0 = date now
        var base_args = ["publish", $project, "-c", "Release", "-r", $rid, "-o", $cfg_dir, "-p:PublishSingleFile=true", "-p:DebugType=None", "-p:DebugSymbols=false"]
        var all_args = chain $base_args $cfg.Args
        dotnet ...$all_args
        assert_ok $"publish {$cfg.Label}"
        var pub_sec = ((((date now) - $pub_t0).TotalSeconds).ToString("F2"))

        # Find the binary
        var bin_path = [($cfg_dir | join -p "tosh"), ($cfg_dir | join -p "Tosh.Cli")] | where { (is-file $_).IsFile } | first
        if ($bin_path == null) { warn $"Binary not found for {$cfg.Label}, skipping"; continue }

        var bin_info = (ls $bin_path | first)
        var size_mb = (($bin_info.Size.Bytes / 1048576.0).ToString("F1"))

        info $"  Published {$size_mb} MB in {$pub_sec}s, measuring startup..."

        # Cold start (first run, OS hasn't cached pages)
        var cold_result = (spawn $bin_path --safe -c exit | wait-for | first)
        var cold_ms = ($cold_result.Duration.TotalMilliseconds.ToString("F1"))

        # Warm starts — sum measurement durations over $runs iterations
        var warm_total = 0.0
        var r = 0
        while ($r < $runs) {
            var warm_result = (spawn $bin_path --safe -c exit | wait-for | first)
            $warm_total += $warm_result.Duration.TotalMilliseconds
            $r += 1
        }
        var warm_avg = (($warm_total / $runs).ToString("F1"))

        ok $"{$cfg.Label}  publish={$pub_sec}s  size={$size_mb}MB  cold={$cold_ms}ms  warm={$warm_avg}ms"
        $results = (chain $results [new BenchResult($cfg.Label, $pub_sec, $size_mb, $cold_ms, $warm_avg)])
    }

    sep "SUMMARY"
    echo $results

    # --compare: print delta table
    if ($compare and $prev_bench != null) {
        writeline ""
        sep "COMPARE vs previous"
        var deltas = []
        for res in ($results) {
            var dir_key = ($configs | where { $_.Label == $res.Label } | first).DirName
            var prev_cold = (read_prev_field $prev_bench $"{$dir_key}_cold_ms")
            var prev_warm = (read_prev_field $prev_bench $"{$dir_key}_warm_ms")
            if ($prev_cold != null and $prev_warm != null) {
                var dc = (($res.ColdMs as double) - $prev_cold).ToString("+0.0;-0.0;0.0")
                var dw = (($res.WarmMs as double) - $prev_warm).ToString("+0.0;-0.0;0.0")
                $deltas = (chain $deltas [new DeltaRow($res.Label, $"{$dc}ms", $"{$dw}ms")])
            }
        }
        if (($deltas | count) > 0) { echo $deltas }
    }

    # Append to history
    func result_field(lbl: string, field: string) -> string {
        var m = ($results | where { $_.Label == $lbl } | first)
        if ($m == null) { return "0" }
        return ($field == "cold" ? $m.ColdMs : $m.WarmMs)
    }
    var bench_entry = new BenchEntry(
        "bench", (ts_now),
        (result_field "Self-Contained" "cold"),                        (result_field "Self-Contained" "warm"),
        (result_field "Self-Contained, Ready-To-Run" "cold"),          (result_field "Self-Contained, Ready-To-Run" "warm"),
        (result_field "Framework-Dependent" "cold"),                   (result_field "Framework-Dependent" "warm"),
        (result_field "Framework-Dependent, Ready-To-Run" "cold"),     (result_field "Framework-Dependent, Ready-To-Run" "warm")
    )
    history_append $root ($bench_entry | to json).Replace("\n", "").Replace("  ", "")
}

# Dispatch is handled natively by the `subcommand` blocks above.
# Running `build.tosh` bare or with `--help` shows auto-generated help.