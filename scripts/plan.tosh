#!/usr/bin/env tosh
## @summary Work the plan boards in docs/plan — list, inspect and check items.
## @remarks
##   Replaces five separate scripts (append-to-item, check-table-rows, close-items,
##   file-item, stabilization-counts) that each re-implemented the same table parse
##   against the same document. Modelled on scripts/build.tosh: one entry point,
##   subcommands underneath.
##
##   The counts this prints are **derived every time**. The board they replaced kept
##   a hand-written snapshot with the instruction "when a status changes there,
##   change it here in the same edit", and it drifted twenty items out of date
##   because that is what hand-maintained summaries do.
##
##   Rows are single lines of up to several thousand characters and may contain
##   escaped pipes inside prose, so cells are split on unescaped `|` only.
## @example
##   scripts/plan.tosh counts
##   scripts/plan.tosh list active
##   scripts/plan.tosh show TS-P2-117
##   scripts/plan.tosh check
## @returns Depends on the subcommand; `check` and `orphans` exit non-zero on a fault.
var PLAN_DIR = "docs/plan"
var BOARDS = ["ACTIVE", "PROPOSED", "COMPLETE", "DEFERRED"]

## The controlled status vocabulary. A status cell may carry any amount of detail
## after an em dash; the leading word must be one of these, so that state is a fact
## rather than a reading.
var STATES = ["Open", "Proposed", "Research", "In progress", "Partial", "Complete", "Deferred", "Withdrawn"]

## Which board each state belongs on. `check` uses this to catch a half-finished
## move — a row whose status says Complete while it still sits in ACTIVE.md.
var HOME = {%
    "Open" => "ACTIVE", "Research" => "ACTIVE", "In progress" => "ACTIVE", "Partial" => "ACTIVE",
    "Proposed" => "PROPOSED",
    "Complete" => "COMPLETE", "Withdrawn" => "COMPLETE",
    "Deferred" => "DEFERRED"
%}

## Stand-in for an escaped pipe while a row is being split. Any string that cannot
## occur in the prose will do; this one is checked for by `check`.
var SENTINEL = "@@ESCAPED_PIPE@@"

## Split a table row into cells on unescaped pipes. A prose cell may contain `\|`
## — 39 rows do — and splitting naively would shift every later cell.
func cells(line) {
    var safe = $line.Replace("\\|", $SENTINEL)
    var parts = $safe.Split("|")
    var out = []
    for p in $parts { $out = ($out + [$p.Replace($SENTINEL, "\\|")]) }
    return $out
}

## The leading status word, with detail and emphasis stripped.
func lead(cell) {
    var s = $cell.Trim().Replace("**", "")
    for sep in ["—", "–", ";", ","] {
        var i = $s.IndexOf($sep)
        if ($i >= 0) { $s = $s.Substring(0, $i) }
    }
    return $s.Trim()
}

## Every item row across every board, as dictionaries.
func load() {
    var items = []
    for board in $BOARDS {
        var path = ($PLAN_DIR + "/" + $board + ".md")
        var tier = ""
        for line in (read-file $path | lines) {
            if ($line.StartsWith("## P")) { $tier = $line.Substring(3, 2) }
            if (not ($line =~ "^\\| `TS-P[0-3]-[0-9]+` \\|")) { continue }
            var c = cells($line)
            $items = ($items + [{%
                "id" => $line.Split("`")[1],
                "board" => $board,
                "tier" => $tier,
                "status" => $c[2].Trim(),
                "state" => lead($c[2]),
                "cellcount" => ($c | count),
                "line" => $line
            %}])
        }
    }
    return $items
}

var argv = ($tosh.Script.Args | collect)
var cmd = "counts"
if (($argv | count) > 0) { $cmd = $argv[0] }
var rest = ($argv | skip 1 | collect)

## ---------------------------------------------------------------- counts
if ($cmd == "counts") {
    var items = load()
    for board in $BOARDS {
        var n = ($items | where { $_["board"] == $board } | count)
        echo $"{$board}: {$n}"
    }
    echo $"total: {($items | count)}"
    for tier in ["P0", "P1", "P2", "P3"] {
        var all = ($items | where { $_["tier"] == $tier } | count)
        var done = ($items | where { ($_["tier"] == $tier) and ($_["board"] == "COMPLETE") } | count)
        if ($all > 0) { echo $"{$tier}: {$done}/{$all} complete" }
    }
}

## ---------------------------------------------------------------- list
if ($cmd == "list") {
    var want = "ACTIVE"
    if (($rest | count) > 0) { $want = $rest[0].ToUpper() }
    var items = (load() | where { $_["board"] == $want } | collect)
    for it in $items {
        var id = $it["id"]
        var state = $it["state"]
        var tier = $it["tier"]
        echo $"{$id}  [{$state}]  {$tier}"
    }
    var n = ($items | count)
    echo $"({$n} items on {$want})"
}

## ---------------------------------------------------------------- show
if ($cmd == "show") {
    if (($rest | count) == 0) { echo "usage: plan.tosh show <id>" }
    var id = $rest[0]
    var hits = (load() | where { $_["id"] == $id } | collect)
    if (($hits | count) == 0) { echo $"no such item: {$id}" }
    for it in $hits {
        var c = cells($it["line"])
        var board = $it["board"]
        var tier = $it["tier"]
        var status = $c[2].Trim()
        var problem = $c[3].Trim()
        var acceptance = $c[4].Trim()
        echo $"{$id} — {$board} / {$tier}"
        echo $"status: {$status}"
        echo ""
        echo $"problem: {$problem}"
        echo ""
        echo $"acceptance: {$acceptance}"
    }
}

## ---------------------------------------------------------------- check
##
## The integrity pass. Everything here is a fault a human edit can introduce and a
## reader would not notice: a duplicated ID, a status word outside the vocabulary,
## a row with the wrong number of cells, or a row sitting on the wrong board
## because a move was only half done.
if ($cmd == "check") {
    var items = load()
    var faults = 0
    var seen = []

    for it in $items {
        var id = $it["id"]
        var board = $it["board"]
        var state = $it["state"]
        var cellcount = $it["cellcount"]

        if ($id in $seen) {
            echo $"duplicate id: {$id} (again on {$board})"
            $faults = ($faults + 1)
        }
        $seen = ($seen + [$id])

        if (not ($state in $STATES)) {
            echo $"uncontrolled status: {$id} — '{$state}'"
            $faults = ($faults + 1)
        } else {
            var home = $HOME[$state]
            if ($home != $board) {
                echo $"misfiled: {$id} is '{$state}' but sits on {$board}, belongs on {$home}"
                $faults = ($faults + 1)
            }
        }

        if ($cellcount != 6) {
            var actual = ($cellcount - 2)
            echo $"malformed row: {$id} has {$actual} cells, expected 4"
            $faults = ($faults + 1)
        }
    }

    var total = ($items | count)
    echo $"checked {$total} items, {$faults} faults"
}

## ---------------------------------------------------------------- orphans
##
## Item IDs are cited in source and test comments — 853 references across 251 files
## when the boards were split. An ID deleted from the board while those citations
## remain leaves a reader chasing an item that no longer exists.
if ($cmd == "orphans") {
    var known = []
    for it in load() { $known = ($known + [$it["id"]]) }

    ## `/usr/bin/grep` by absolute path deliberately: `grep` alone resolves to the
    ## TōSh builtin, which has its own option set and no `-o`.
    var cited = []
    for id in (/usr/bin/grep -roh --include="*.cs" --include="*.tosh" "TS-P[0-3]-[0-9]\\+" src tests scripts | lines) {
        if (not ($id in $cited)) { $cited = ($cited + [$id]) }
    }

    var missing = ($cited | where { not ($_ in $known) } | collect)
    for m in $missing { echo $"cited in code but not on any board: {$m}" }
    var nc = ($cited | count)
    var nm = ($missing | count)
    echo $"{$nc} distinct ids cited, {$nm} orphaned"
}
