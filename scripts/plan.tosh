#!/usr/bin/env tosh
## @summary Work the plan — list, inspect, check and index the items in docs/plan.
## @remarks
##   Replaces five scripts (append-to-item, check-table-rows, close-items, file-item,
##   stabilization-counts) that each re-implemented the same markdown-table parse.
##   Modelled on scripts/build.tosh: one entry point, subcommands underneath.
##
##   Everything printed here is derived on the spot. The board this replaced kept a
##   hand-written snapshot carrying the instruction "when a status changes there,
##   change it here in the same edit"; it drifted twenty items out of date, because
##   that is what hand-maintained summaries do.
## @example scripts/plan.tosh counts
## @example scripts/plan.tosh list active
## @example scripts/plan.tosh show TS-P2-117
## @example scripts/plan.tosh check
## @example scripts/plan.tosh index
## @returns Depends on the subcommand; `check` reports a fault count.

## @summary Refinement type for paths that must already exist as a directory.
type DirectoryPath = string where (is-dir _).IsDirectory

## @summary Resolves the absolute path of the repository root.
## @returns The repository root directory as a `DirectoryPath`.
func RepoRoot() -> DirectoryPath {
    var result = (spawn git rev-parse --show-toplevel | wait-for | first)
    if ($result.ExitCode != 0) { throw "Run this command from inside the TōSh repository." }
    return ($result.Output | first).ToString().Trim()
}


var PLAN_DIR = $"{RepoRoot()}/docs/plan"
var ITEMS_DIR = $"{RepoRoot()}/docs/plan/items"

var STATES   = [ "proposed", "open" , "research", "in-progress", "partial" , "complete", "deferred", "withdrawn" ]
var AREAS    = [ "toast"   , "tosh" , "tome"    , "crumb"      , "plan"    , "legacy" ]
var REQUIRED = [ "id"      , "title", "status"  , "area"       , "priority" ]

## Which index a status appears on.
var BOARD = {%
    "proposed"    => "PROPOSED",
    "open"        => "ACTIVE"  ,
    "research"    => "ACTIVE"  ,
    "in-progress" => "ACTIVE"  ,
    "partial"     => "ACTIVE"  ,
    "deferred"    => "DEFERRED",
    "complete"    => "COMPLETE",
    "withdrawn"   => "COMPLETE"
%}

var BOARDS = ["ACTIVE", "PROPOSED", "DEFERRED", "COMPLETE"]

## Read one item file into a dictionary of its frontmatter, plus the counts that
## `check` needs: how many acceptance boxes are ticked and how many are not.
func read_item(path) {
    var fields = {% %}
    var infront = false
    var seen_front = false
    var open_boxes = 0
    var done_boxes = 0
    var bad_boxes = 0

    for line in (read-file $path | lines) {
        if ($line.Trim() == "---") {
            if (not $seen_front) { $infront = true; $seen_front = true }
            else { $infront = false }
            continue
        }
        if ($infront) {
            var i = $line.IndexOf(":")
            if ($i > 0) {
                var key = $line.Substring(0, $i).Trim()
                var value = $line.Substring(($i + 1)).Trim()
                if ($value.StartsWith("\"")) { $value = $value.Trim("\"") }
                $fields[$key] = $value
            }
            continue
        }
        var t = $line.Trim()
        if ($t.StartsWith("- [ ]")) { $open_boxes = ($open_boxes + 1) }
        if ($t.StartsWith("- [x]")) { $done_boxes = ($done_boxes + 1) }

        ## A checkbox that is neither ticked nor unticked counts as neither, so a typo
        ## silently exempts an item from the rule that `complete` needs every box ticked.
        ## Found by writing `- [~]` in TOAST-0005 to mean "not met" and watching `check`
        ## report zero faults.
        if (($t.StartsWith("- [")) and (not $t.StartsWith("- [ ]")) and (not $t.StartsWith("- [x]"))) {
            $bad_boxes = ($bad_boxes + 1)
        }
    }

    $fields["path"] = $path
    $fields["open_boxes"] = $open_boxes
    $fields["done_boxes"] = $done_boxes
    $fields["bad_boxes"] = $bad_boxes
    return $fields
}

## Every item. `find` by absolute path because `ls` is a TōSh builtin returning
## objects, and a plain list of paths is all this needs.
##
## The board is resolved here rather than by a helper called from inside a `where`
## closure: a free function invoked as `f($_)` inside a closure resolves as an
## *instance method on the pipeline item* and fails. Filed as TOAST-0001.
func load() {
    var items = []
    var paths = find $ITEMS_DIR -name "*.md" | get FullName | each _.Trim()
    for path in $paths {
        if ($path == "") { continue }
        var it = read_item($path)
        var s = $it["status"]
        if ($s in $STATES) { $it["board"] = $BOARD[$s] } else { $it["board"] = "UNKNOWN" }
        $items = ($items + [$it])
    }
    return $items
}

# var argv = ($tosh.Script.Args | collect)
# var cmd = "counts"
# if (($argv | count) > 0) { $cmd = $argv[0] }
# var rest = ($argv | skip 1 | collect)

## @summary Gives the counts of items acrossed each state and target
subcommand counts {
    var items = load()
    for board in $BOARDS {
        var n = ($items | where { $_["board"] == $board } | count)
        echo $"{$board}: {$n}"
    }
    var total = ($items | count)
    echo $"total tracked items: {$total}"
    for area in $AREAS {
        var n = ($items | where { $_["area"] == $area } | count)
        if ($n > 0) { echo $"    {$area}: {$n}" }
    }
}

## @summary Lists items with the specified state.
subcommand list {
    ## @summary ACTIVE, PROPOSED, DEFERRED, or COMPLETE (case insensitive)
    arg status: string = "ACTIVE"
    $status = $status.ToUpper()
    var items = (load() | where { $_["board"] == $status } | collect)
    for it in $items {
        var id = $it["id"]
        var status = $it["status"]
        var title = $it["title"]
        var ob = $it["open_boxes"]
        var db = $it["done_boxes"]
        var boxes = ""
        if (($ob + $db) > 0) { $boxes = $" ({$db}/{($ob + $db)})" }
        echo $"{$id}  [{$status}]{$boxes}  {$title}"
    }
    var n = ($items | count)
    echo $"({$n} on {$status})"
}

## @summary Returns the summary and details of a single item, specified by id
subcommand show {
    ## @summary The id of the item in question
    arg id: string
    var hits = (load() | where { $_["id"] == $id } | collect)
    if (($hits | count) == 0) { echo $"no such item: {$id}" }
    for it in $hits { read-file $it["path"] }
}

## @summary Checks items for introduced faults
subcommand check {
    var items = load()
    var faults = 0
    var seen = []

    for it in $items {
        var path = $it["path"]

        for field in $REQUIRED {
            if (not $it.ContainsKey($field)) {
                echo $"missing field '{$field}': {$path}"
                $faults = ($faults + 1)
            }
        }

        var id = $it["id"]
        var status = $it["status"]
        var area = $it["area"]

        if ($id in $seen) {
            echo $"duplicate id: {$id} ({$path})"
            $faults = ($faults + 1)
        }
        $seen = ($seen + [$id])

        if (not ($status in $STATES)) {
            echo $"unknown status '{$status}': {$id}"
            $faults = ($faults + 1)
        }
        if (not ($area in $AREAS)) {
            echo $"unknown area '{$area}': {$id}"
            $faults = ($faults + 1)
        }

        ## The sub-task rule: an item is not complete while a box is unticked.
        ## The old board had no way to say this, so authors said it in a column
        ## markdown never rendered.
        if (($status == "complete") and ($it["open_boxes"] > 0)) {
            var n = $it["open_boxes"]
            echo $"{$id} is 'complete' with {$n} unchecked acceptance box(es) — use 'partial'"
            $faults = ($faults + 1)
        }
        if ($it["bad_boxes"] > 0) {
            var b = $it["bad_boxes"]
            echo $"{$id} has {$b} malformed checkbox(es) — only '- [ ]' and '- [x]' are counted"
            $faults = ($faults + 1)
        }

        if (($status == "partial") and ($it["open_boxes"] == 0)) {
            echo $"{$id} is 'partial' but nothing is left unchecked — close it or record what remains"
            $faults = ($faults + 1)
        }

        var expected = ($ITEMS_DIR + "/" + $id + ".md")
        if ($path != $expected) {
            echo $"filename does not match id: {$path} (expected {$expected})"
            $faults = ($faults + 1)
        }
    }

    var total = ($items | count)
    echo $"checked {$total} items, {$faults} faults"
}

## @summary Regenerate the four board files from the item files.
subcommand index {
    var items = load()
    for board in $BOARDS {
        var rows = (load() | where { $_["board"] == $board } | collect)
        var out = [
            $"# {$board.Substring(0, 1)}{$board.Substring(1).ToLower()}",
            "",
            "<!-- Generated by scripts/plan.tosh index. Do not edit; edit docs/plan/items/. -->",
            "",
            "| ID | Priority | Status | Progress | Title |",
            "|---|---|---|---|---|"
        ]
        for it in $rows {
            var id = $it["id"]
            var title = $it["title"]
            var status = $it["status"]
            var priority = $it["priority"]
            var ob = $it["open_boxes"]
            var db = $it["done_boxes"]
            var progress = "—"
            if (($ob + $db) > 0) { $progress = $"{$db}/{($ob + $db)}" }
            $out = ($out + [$"| [`{$id}`](items/{$id}.md) | P{$priority} | {$status} | {$progress} | {$title} |"])
        }
        if (($rows | count) == 0) { $out = ($out + ["| — | | | | *(none)* |"]) }
        if ($board == "COMPLETE") {
            $out = ($out + ["", "Items closed under the old stabilization board are frozen in [legacy/COMPLETE.md](legacy/COMPLETE.md)."])
        }
        write-file ($PLAN_DIR + "/" + $board + ".md") (($out | join "\n") + "\n") | ignore
        var n = ($rows | count)
        echo $"{$board}.md: {$n} items"
    }
}

## @summary Scan for orphaned IDs (cited in code but absent from the plan).
subcommand orphans {
    var known = []
    for it in load() { $known = ($known + [$it["id"]]) }
    for line in (read-file ($PLAN_DIR + "/legacy/COMPLETE.md") | lines) {
        if ($line =~ "^\\| `TS-P[0-3]-[0-9]+` \\|") { $known = ($known + [$line.Split("`")[1]]) }
    }

    var cited = []
    ## Includes are unquoted deliberately: TōSh passes `--include="*.cs"` through to
    ## an external command with the quote characters still in it, so grep looks for a
    ## file literally named "*.cs" and matches nothing. Filed as TOSH-0001.
    for id in (/usr/bin/grep -roh --include=*.cs --include=*.tosh "TS-P[0-3]-[0-9]\\+" src tests scripts | lines) {
        if (not ($id in $cited)) { $cited = ($cited + [$id]) }
    }

    var missing = ($cited | where { not ($_ in $known) } | collect)
    for m in $missing { echo $"cited in code but not in the plan: {$m}" }
    var nc = ($cited | count)
    var nm = ($missing | count)
    echo $"{$nc} distinct ids cited, {$nm} orphaned"
}
