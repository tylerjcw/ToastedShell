#!/usr/bin/env tosh
## @summary Split the stabilization board into docs/plan/{ACTIVE,COMPLETE,DEFERRED}.md.
## @remarks
##   One-shot migration, kept because it is the record of how the board was split
##   and because a re-runnable migration can be checked. It moves rows
##   **byte-identically** and routes them by a status it *computes* rather than one
##   it writes, so the migration cannot change an item's meaning while moving it —
##   the discipline TOAST_SEPARATION_PLAN.md asks for when moving code, applied to
##   the board itself.
##
##   Normalising the status vocabulary is deliberately NOT done here. Five rows do
##   not lead with a controlled status word; they are reported for a human to
##   restate in a separate, reviewable commit.
## @example
##   scripts/plan-migrate.tosh docs/TOASTSCRIPT_STABILIZATION.md docs/plan
## @returns Routing counts, the ID-set check, and any rows needing attention.
var doc = $tosh.Script.Args[0]
var outdir = $tosh.Script.Args[1]

## Reduce a free-text status cell to its leading word, which is the part that
## carries the state. Everything after an em dash, en dash or semicolon is detail.
func lead(cell) {
    var s = $cell.Trim().Replace("**", "")
    for sep in ["—", "–", ";"] {
        var i = $s.IndexOf($sep)
        if ($i >= 0) { $s = $s.Substring(0, $i) }
    }
    return $s.Trim()
}

## Map that leading word onto the controlled set. Order matters: the "Complete for
## <shape>" spellings are partial completions and must be tested before "Complete".
func classify(leadword) {
    if ($leadword.StartsWith("Complete for"))   { return "Partial" }
    if ($leadword.StartsWith("Corpus complete")) { return "Partial" }
    if ($leadword.StartsWith("Complete"))       { return "Complete" }
    if ($leadword.StartsWith("Proposed"))       { return "Proposed" }
    if ($leadword.StartsWith("Open"))           { return "Open" }
    if ($leadword.StartsWith("In progress"))    { return "In progress" }
    if ($leadword.StartsWith("Research"))       { return "Research" }
    if ($leadword.StartsWith("Deferred"))       { return "Deferred" }
    if ($leadword.StartsWith("Withdrawn"))      { return "Withdrawn" }
    if ($leadword.StartsWith("Superseded"))     { return "Withdrawn" }
    if ($leadword.StartsWith("Does not reproduce")) { return "Withdrawn" }
    return "UNKNOWN"
}

## Which file a state belongs in.
##
## Proposed is split out rather than folded into Active because the two ask
## different questions of a reader: Active is "what is being worked", Proposed is
## "what has not been agreed to yet". Keeping them together made the working list
## twice its real size — 25 rows where 11 are actually in play.
func destination(state) {
    if ($state == "Complete") { return "COMPLETE" }
    if ($state == "Withdrawn") { return "COMPLETE" }
    if ($state == "Deferred") { return "DEFERRED" }
    if ($state == "Proposed") { return "PROPOSED" }
    return "ACTIVE"
}

var boards = ["ACTIVE", "PROPOSED", "COMPLETE", "DEFERRED"]

var sections = ["P0", "P1", "P2", "P3"]
var titles = {%
    "P0" => "P0 — Safety, Data, and Binding Invariants",
    "P1" => "P1 — Canonical Language Semantics",
    "P2" => "P2 — Parser, Binder, Diagnostics, and Surface Generation",
    "P3" => "P3 — Features Enabled by Stabilization"
%}

## rows[dest][tier] = list of verbatim lines
var rows = {% %}
var counts = {% %}
for dest in $boards {
    var per_tier = {% %}
    for tier in $sections { $per_tier[$tier] = [] }
    $rows[$dest] = $per_tier
    $counts[$dest] = 0
}

var source_ids = []
var unknown = []
var attention = []

for line in (read-file $doc | lines) {
    if (not ($line =~ "^\\| `TS-P[0-3]-[0-9]+` \\|")) { continue }

    var id = $line.Split("`")[1]
    var tier = $id.Split("-")[1]
    var cell = $line.Split("|")[2]
    var word = lead($cell)
    var state = classify($word)

    if ($state == "UNKNOWN") { $unknown = ($unknown + [$"{$id}: {$word}"]) }
    if ($state == "Partial") { $attention = ($attention + [$"{$id}: {$word}"]) }

    var dest = destination($state)
    $source_ids = ($source_ids + [$id])
    $counts[$dest] = ($counts[$dest] + 1)
    $rows[$dest][$tier] = ($rows[$dest][$tier] + [$line])
}

## Emit one board file, tier by tier, skipping tiers with nothing in them.
func emit(dest, heading, blurb) {
    var out = ["# " + $heading, "", $blurb, ""]
    for tier in ["P0", "P1", "P2", "P3"] {
        var tier_rows = $rows[$dest][$tier]
        if (($tier_rows | count) == 0) { continue }
        $out = ($out + ["## " + $titles[$tier], ""])
        $out = ($out + ["| ID | Status | Problem | Required acceptance |"])
        $out = ($out + ["|---|---|---|---|"])
        $out = ($out + $tier_rows)
        $out = ($out + [""])
    }
    write-file ($outdir + "/" + $dest + ".md") (($out | join "\n")) | ignore
    return ($rows[$dest] | count)
}

emit("ACTIVE", "Active work", "Items accepted and in play — open, in progress, under research, or partially done. This is the working list; if it is long, that is a signal.") | ignore
emit("PROPOSED", "Proposed work", "Items filed but not yet agreed to. Nothing here is committed to; accepting one moves it to `ACTIVE.md`, declining it moves it to `DEFERRED.md` with the reason.") | ignore
emit("COMPLETE", "Completed work", "Items resolved — fixed, or withdrawn rather than fixed. Append-only; nothing leaves this file.") | ignore
emit("DEFERRED", "Deferred work", "Items deliberately not being worked, with the decision recorded in the status cell. Deferred is a decision, not a backlog.") | ignore

for dest in $boards {
    echo $"{$dest}: {$counts[$dest]}"
}
echo $"total routed: {($source_ids | count)}"

## The check that makes the migration trustworthy: every ID in must appear exactly
## once out. A count match alone would not catch a row written to two files.
var emitted = []
for dest in $boards {
    for line in (read-file ($outdir + "/" + $dest + ".md") | lines) {
        if (not ($line =~ "^\\| `TS-P[0-3]-[0-9]+` \\|")) { continue }
        $emitted = ($emitted + [$line.Split("`")[1]])
    }
}

echo $"ids in: {($source_ids | count)}  ids out: {($emitted | count)}"
var missing = ($source_ids | where { not ($_ in $emitted) } | collect)
var extra = ($emitted | where { not ($_ in $source_ids) } | collect)
echo $"missing: {($missing | count)}  extra: {($extra | count)}"
if (($missing | count) > 0) { echo $"  MISSING: {($missing | join ", ")}" }
if (($extra | count) > 0) { echo $"  EXTRA: {($extra | join ", ")}" }

if (($unknown | count) > 0) {
    echo "unclassified statuses:"
    for u in $unknown { echo $"  {$u}" }
}
if (($attention | count) > 0) {
    echo "partial statuses needing a controlled word (follow-up commit):"
    for a in $attention { echo $"  {$a}" }
}
