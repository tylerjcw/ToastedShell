#!/usr/bin/env tosh
# publish_tosh.tosh — Build, version-bump, publish, and install TōSh.
#
# Workflow:
#   1. Bump publish number (and CalVer month if needed)
#   2. Update PKGBUILD with new version
#   3. dotnet build + dotnet publish (single-file binary)
#   4. Install via makepkg -si (PKGBUILD)
#   5. Rollback state on failure

## Configures and drives a single-file dotnet publish of the Tosh CLI.
class PublishPlan {
    prop Binary: string? = null
    prop Trimmed: bool = false
    prop SelfContained: bool = true

    shy prop requested_directory: string? = null
    shy prop requested_runtime_id: string? = null

    prop RepoRoot: string {
        get => dirname (dirname (realpath $tosh.Script.Path))
    }

    prop RuntimeId: string {
        get => $this.effective_runtime_id()
        set => $this.requested_runtime_id = $value
    }

    prop Directory: string {
        get => $this.effective_directory()
        set => $this.requested_directory = $value
    }

    prop PublishArgs: array => $this.build_publish_args()
    prop BuildArgs: array => $this.build_build_args()

    shy prop mode_dir: string => $this.Trimmed ? "single-file-trimmed" : "single-file"

    PublishPlan() { }

    shy func effective_runtime_id() -> string {
        if ($this.requested_runtime_id != null and $this.requested_runtime_id != "") {
            return $this.requested_runtime_id
        }
        return System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier
    }

    shy func effective_directory() -> string {
        if ($this.requested_directory != null and $this.requested_directory != "") {
            return System.IO.Path.GetFullPath($this.requested_directory)
        }
        return System.IO.Path.Join($this.RepoRoot, "artifacts", "publish", $this.RuntimeId, $this.mode_dir)
    }

    shy func build_build_args() -> array {
        return [
            "build",
            $"{$this.RepoRoot}/src/Tosh.Cli/Tosh.Cli.csproj",
            "-c", "Release",
            "-r", $this.RuntimeId,
            $"-p:SelfContained={$this.SelfContained}"
        ]
    }

    shy func build_publish_args() -> array {
        var args = [
            "publish",
            $"{$this.RepoRoot}/src/Tosh.Cli/Tosh.Cli.csproj",
            "-c", "Release",
            "-r", $this.RuntimeId,
            "-o", $this.Directory,
            "-p:PublishSingleFile=true",
            "-p:PublishReadyToRun=true",
            "-p:EnableCompressionInSingleFile=false",
            "-p:DebugType=None",
            "-p:DebugSymbols=false",
            "-p:DisableToshVsCodeExtensionSync=true",
            $"-p:SelfContained={$this.SelfContained}"
        ]

        if ($this.Trimmed) {
            $args = echo $args ["-p:PublishTrimmed=true", "-p:TrimMode=partial"] | flatten
        }

        return $args
    }
}

record BuildResult(
    Binary: string,
    Size: StorageSize,
    RID: string,
    Output: string,
    SelfContained: bool,
    Trimmed: bool,
    Duration: timespan,
    Version: string
)

# ── Versioning helpers ──

record PublishState(CalVer: string, Publish: int)

func read_publish_state(path: string) -> PublishState {
    var line = (cat $path | lines | first)
    var parts = $line.Split(':')
    if (($parts | count) != 2) {
        throw $".tosh-publish-state is corrupt: {$line}"
    }
    return new PublishState($parts[0], ($parts[1] as int))
}

func write_publish_state(path: string, calver: string, publish_num: int) {
    write-file $path $"{$calver}:{$publish_num}" | ignore
}

func update_pkgbuild_version(path: string, version: string) {
    var content = cat $path
    $content | replace -r "pkgver=.*" $"pkgver={$version}" | write-file $path | ignore
}

func compute_calver() -> string {
    var now = (date now)
    var yy = $now.Year - 2000
    var mm = $now.Month
    return $"{$yy}.{$mm}"
}

# ── Usage ──

func usage() {
    echo """
        Usage: scripts/publish_tosh.tosh [options]

        Build, version-bump, and install TōSh via PKGBUILD.

        Options:
          --rid <RID>            Runtime identifier (default: host RID).
          --output <DIR>         Output directory (default: artifacts/publish/<rid>/single-file).
          --trimmed              Enable trimmed single-file publish (experimental).
          --framework-dependent  Publish framework-dependent instead of self-contained.
          --no-install           Skip the makepkg install step.
          --exec                 Replace the current process with the new shell after install.
          --help, -h             Show this help text.
        """
}

# ── Argument parsing ──

var publish = new PublishPlan()
var no_install = false
var exec_after = false
var i = 0

while ($i < ($tosh.Script.Args | count)) {
    var arg = ($tosh.Script.Args | get $i)

    if ($arg starts-with "--rid=") {
        var rid = ($arg | split "=" | skip 1 | join "=")
        if ($rid == "") { throw "Missing value for --rid" }
        $publish.RuntimeId = $rid
        $i = ($i + 1)
        continue
    }
    if ($arg starts-with "--output=") {
        var output = ($arg | split "=" | skip 1 | join "=")
        if ($output == "") { throw "Missing value for --output" }
        $publish.Directory = $output
        $i = ($i + 1)
        continue
    }

    switch ($arg) {
        case "--rid" {
            if (($i + 1) >= ($tosh.Script.Args | count)) { throw "Missing value for --rid" }
            $i = ($i + 1)
            $publish.RuntimeId = ($tosh.Script.Args | get $i)
        }
        case "--output" {
            if (($i + 1) >= ($tosh.Script.Args | count)) { throw "Missing value for --output" }
            $i = ($i + 1)
            $publish.Directory = ($tosh.Script.Args | get $i)
        }
        case "--trimmed" {
            $publish.Trimmed = true
        }
        case "--framework-dependent" {
            $publish.SelfContained = false
        }
        case "--no-install" {
            $no_install = true
        }
        case "--exec" {
            $exec_after = true
        }
        case "--help" { usage; return }
        case "-h" { usage; return }
        default {
            writeline $"Unknown option: {$arg}" e> /dev/stderr
            usage e> /dev/stderr
            throw $"Unknown option: {$arg}"
        }
    }
    $i += 1
}

# ── Paths ──

var state_path = System.IO.Path.Join($publish.RepoRoot, ".tosh-publish-state")
var pkgbuild_path = System.IO.Path.Join($publish.RepoRoot, "packaging", "archlinux", "PKGBUILD")
var dotnet_major = 10

# ── Save original state for rollback ──

var orig_state = read_publish_state $state_path
var orig_calver = $orig_state.CalVer
var orig_publish = $orig_state.Publish
var orig_pkgbuild = cat $pkgbuild_path

# ── Bump version ──

var current_calver = (compute_calver)
var new_publish = $current_calver == $orig_calver ? ($orig_publish + 1) : 1
var new_version = $"{$current_calver}.{$new_publish}.{$dotnet_major}"
styled $"Version bump: {$orig_calver}.{$orig_publish}.{$dotnet_major} → {$new_version}" --fg bright-yellow --bold | writeline

write_publish_state $state_path $current_calver $new_publish
update_pkgbuild_version $pkgbuild_path $new_version


# ── Build, publish, install ──

try {
    mkdir -p $publish.Directory | ignore
    var total_start = (date now)

    # Build (triggers spec generation, VS Code extension sync, etc.)
    styled $"Building ToSh ({$publish.RuntimeId})..." --fg bright-cyan --bold | writeline
    dotnet ...$publish.BuildArgs
    if ($tosh.Last.ExitCode != 0) { throw "dotnet build failed." }

    writeline ""

    # Publish as single-file binary
    styled $"Publishing ToSh ({$publish.RuntimeId})..." --fg bright-cyan --bold | writeline
    dotnet ...$publish.PublishArgs
    if ($tosh.Last.ExitCode != 0) { throw "dotnet publish failed." }

    var build_duration = ((date now) - $total_start)
    writeline ""

    # Find the published binary
    var candidates = [
        System.IO.Path.Join($publish.Directory, "Tosh.Cli"),
        System.IO.Path.Join($publish.Directory, "Tosh.Cli.exe"),
        System.IO.Path.Join($publish.Directory, "tosh"),
        System.IO.Path.Join($publish.Directory, "tosh.exe")
    ]

    var found = false
    for candidate in ($candidates) {
        if ((is-file $candidate).IsFile) {
            $publish.Binary = $candidate
            $found = true
            break
        }
    }

    if (not $found or $publish.Binary == null or $publish.Binary == "") {
        throw $"Publish completed, but no executable was found in {$publish.Directory}"
    }

    # Rename to tosh / tosh.exe
    var target_name = "tosh"
    if ($publish.Binary ends-with ".exe" or $publish.RuntimeId starts-with "win-") {
        $target_name = "tosh.exe"
    }

    var target_path = System.IO.Path.Join($publish.Directory, $target_name)

    if ($publish.Binary != $target_path) {
        rm -f $target_path
        mv $publish.Binary $target_path
    }
    $publish.Binary = $target_path

    if (not (is-file $publish.Binary).IsFile) {
        throw $"After rename, expected binary at {$publish.Binary}, but it does not exist."
    }

    var binary_info = (ls $publish.Binary | first)

    styled $"Published: {$publish.Binary}" --fg bright-green --bold | writeline
    styled $"""
        Size:           {$binary_info.Size}
        RID:            {$publish.RuntimeId}
        Duration:       {$build_duration}
        Directory:      {$publish.Directory}
        Self-contained: {$publish.SelfContained}
        Trimmed:        {$publish.Trimmed}
        Version:        {$new_version}
    """ --fg gray --dim | writeline

    # Install via PKGBUILD
    if (not $no_install) {
        writeline ""
        styled "Installing via PKGBUILD (makepkg -si)..." --fg bright-cyan --bold | writeline
        var pkgbuild_dir = System.IO.Path.GetDirectoryName($pkgbuild_path)
        var old_cwd = (pwd).FullName
        cd $pkgbuild_dir
        try {
            makepkg -sif --noconfirm
        } finally {
            cd $old_cwd
        }

        # Set cap_net_raw for raw socket support (ping, etc.)
        if (not ($publish.RuntimeId starts-with "win-")) {
            try {
                styled "Setting cap_net_raw on /usr/bin/tosh (requires sudo)..." --fg gray --dim | writeline
                sudo setcap cap_net_raw+ep /usr/bin/tosh
            } catch ($err) {
                styled $"Warning: Could not set cap_net_raw ({$err.Message})" --fg yellow | writeline
            }
        }
    }

    # Replace current process with the new shell if requested
    if ($exec_after) { exec $publish.Binary }

    return new BuildResult(
        $publish.Binary,
        $binary_info.Size,
        $publish.RuntimeId,
        $publish.Directory,
        $publish.SelfContained,
        $publish.Trimmed,
        $build_duration,
        $new_version
    )
} catch ($err) {
    # Rollback version state on any failure
    styled $"ERROR: {$err}" --fg bright-red --bold | writeline
    styled "Rolling back version state..." --fg yellow | writeline
    write_publish_state $state_path $orig_calver $orig_publish
    $orig_pkgbuild | write-file $pkgbuild_path | ignore
    throw $err
}
