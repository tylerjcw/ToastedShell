#!/usr/bin/env tosh
## @summary Re-derive the stabilization item counts from the tables themselves.
## @remarks
##   The Active Work snapshot in TOASTSCRIPT_STABILIZATION.md had drifted twenty
##   items out of date because it was maintained by hand. This reads the tables
##   and prints what they actually say, so the snapshot is derived rather than
##   remembered.
##
##   Written in ToastScript deliberately: this programme's own repository work
##   had been done in Python, which wasted the dogfooding. Two defects surfaced
##   within minutes of the switch (TS-P2-44, TS-P2-45).
## @example
##   scripts/stabilization-counts.tosh
## @returns One line per priority tier, plus a total.
var doc = "docs/TOASTSCRIPT_STABILIZATION.md"

var tiers = {% "P0" => 0, "P1" => 0, "P2" => 0, "P3" => 0 %}
var done  = {% "P0" => 0, "P1" => 0, "P2" => 0, "P3" => 0 %}
var total = 0
var complete = 0

for line in (read-file $doc | lines) {
    if (not ($line =~ "^\\| `TS-P[0-3]-[0-9]+` \\|")) { continue }

    var tier = $line.Split("`")[1].Split("-")[1]
    var status = $line.Split("|")[2].Trim()

    $tiers[$tier] = ($tiers[$tier] + 1)
    $total = ($total + 1)

    if ($status.StartsWith("Complete")) {
        $done[$tier] = ($done[$tier] + 1)
        $complete = ($complete + 1)
    }
}

for tier in ["P0", "P1", "P2", "P3"] {
    echo $"{$tier}: {$done[$tier]}/{$tiers[$tier]}"
}
echo $"total: {$complete}/{$total} complete, {($total - $complete)} open"
