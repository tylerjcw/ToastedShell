#!/usr/bin/env tosh
## @summary Convert the open board rows into one-file-per-item, and freeze the closed ones.
## @remarks
##   Second and final stage of the board migration. The first stage split one
##   document into four; this one leaves the table format behind entirely for items
##   that are still being worked.
##
##   Only the 30 open, proposed and deferred items become files. The 176 closed ones
##   are frozen into legacy/COMPLETE.md as they are: they are history, nothing will
##   edit them again, and rewriting them would churn 280 KB to no purpose.
##
##   The fifth column is the reason this stage exists. Six rows carry remaining-work
##   notes in a cell the table header never declared, so markdown has never rendered
##   them. Those become unchecked acceptance boxes, which is what they always were.
## @example
##   scripts/plan-migrate-items.tosh
## @returns One line per file written, then a reconciliation count.
var PLAN_DIR = "docs/plan"
var SENTINEL = "@@ESCAPED_PIPE@@"

func cells(line) {
    var safe = $line.Replace("\\|", $SENTINEL)
    var parts = $safe.Split("|")
    var out = []
    for p in $parts { $out = ($out + [$p.Replace($SENTINEL, "\\|")]) }
    return $out
}

func lead(cell) {
    var s = $cell.Trim().Replace("**", "")
    for sep in ["—", "–", ";", ","] {
        var i = $s.IndexOf($sep)
        if ($i >= 0) { $s = $s.Substring(0, $i) }
    }
    return $s.Trim()
}

## Legacy free-text status to the controlled vocabulary.
func status_of(word) {
    if ($word.StartsWith("Complete for")) { return "partial" }
    if ($word.StartsWith("Corpus complete")) { return "partial" }
    if ($word.StartsWith("Complete")) { return "complete" }
    if ($word.StartsWith("Proposed")) { return "proposed" }
    if ($word.StartsWith("Open")) { return "open" }
    if ($word.StartsWith("In progress")) { return "in-progress" }
    if ($word.StartsWith("Research")) { return "research" }
    if ($word.StartsWith("Deferred")) { return "deferred" }
    if ($word.StartsWith("Withdrawn")) { return "withdrawn" }
    if ($word.StartsWith("Superseded")) { return "withdrawn" }
    if ($word.StartsWith("Does not reproduce")) { return "withdrawn" }
    return "open"
}

## A one-line title. These rows almost always open with a bolded sentence stating
## the defect, which is exactly the title; fall back to the opening clause.
func title_of(problem) {
    var p = $problem.Trim()
    if ($p.StartsWith("**")) {
        var rest = $p.Substring(2)
        var end = $rest.IndexOf("**")
        if ($end > 0) { $p = $rest.Substring(0, $end) }
    } else {
        var dot = $p.IndexOf(". ")
        if ($dot > 0) { $p = $p.Substring(0, $dot) }
    }
    $p = $p.Replace("\n", " ").Replace("\"", "'").Trim()
    if ($p.EndsWith(".")) { $p = $p.Substring(0, ($p.Length - 1)) }
    if ($p.Length > 110) { $p = ($p.Substring(0, 107) + "...") }
    return $p
}

var written = 0
var frozen = []

for board in ["ACTIVE", "PROPOSED", "DEFERRED", "COMPLETE"] {
    var tier = ""
    for line in (read-file ($PLAN_DIR + "/" + $board + ".md") | lines) {
        if ($line.StartsWith("## P")) { $tier = $line.Substring(3, 2) }
        if (not ($line =~ "^\\| `TS-P[0-3]-[0-9]+` \\|")) { continue }

        ## A closed row keeps its table form, but any cell past the declared four is
        ## folded back into the acceptance cell first. Three closed rows carry one,
        ## and markdown would go on dropping it in the archive exactly as it did in
        ## the original — freezing a document is no reason to freeze a defect.
        if ($board == "COMPLETE") {
            var fc = cells($line)
            if (($fc | count) > 6) {
                var merged = $fc[4]
                var k = 5
                while ($k < (($fc | count) - 1)) {
                    if ($fc[$k].Trim() != "") { $merged = ($merged + " " + $fc[$k].Trim()) }
                    $k = ($k + 1)
                }
                $line = ("|" + $fc[1] + "|" + $fc[2] + "|" + $fc[3] + "|" + $merged + "|")
            }
            $frozen = ($frozen + [$line])
            continue
        }

        var c = cells($line)
        var id = $line.Split("`")[1]
        var status = status_of(lead($c[2]))
        var priority = $tier.Substring(1, 1)
        var problem = $c[3].Trim()
        var acceptance = $c[4].Trim()

        ## The undeclared fifth column: remaining work that markdown never showed.
        var remaining = ""
        if (($c | count) > 6) { $remaining = $c[5].Trim() }

        var body = [
            "---",
            $"id: {$id}",
            $"title: \"{title_of($problem)}\"",
            $"status: {$status}",
            "area: legacy",
            $"priority: {$priority}",
            $"legacy: {$id}",
            "---",
            "",
            $"> Status as filed: {$c[2].Trim()}",
            "",
            "## Problem",
            "",
            $problem,
            "",
            "## Acceptance",
            "",
            $acceptance
        ]

        if ($remaining != "") {
            $body = ($body + ["", "## Remaining", "", $"- [ ] {$remaining}"])
        }

        write-file ($PLAN_DIR + "/items/" + $id + ".md") (($body | join "\n") + "\n") | ignore
        $written = ($written + 1)
        echo $"{$id}  {$status}  P{$priority}"
    }
}

var header = [
    "# Completed under the stabilization board",
    "",
    "The 176 items closed before the plan moved to one file per item. **Frozen** —",
    "nothing here is edited again. Kept whole because 853 references across 251",
    "source and test files cite these IDs, and a citation should lead somewhere.",
    "",
    "New work does not use `TS-P*-*` identifiers; see `../README.md`.",
    "",
    "| ID | Status | Problem | Required acceptance |",
    "|---|---|---|---|"
]
write-file ($PLAN_DIR + "/legacy/COMPLETE.md") ((($header + $frozen) | join "\n") + "\n") | ignore

var nfrozen = ($frozen | count)
echo ""
echo $"item files written: {$written}"
echo $"frozen into legacy/COMPLETE.md: {$nfrozen}"
echo $"total accounted: {($written + $nfrozen)}"
