<Project>

  <!--
    A4: emit a `.snupkg` symbol package next to every `.nupkg` we ship.
    This must live in Directory.Build.targets (not .props) so that
    <IsPackable> has been finalised by the project body before the
    condition is evaluated.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
    <SymbolPackageFormat Condition="'$(SymbolPackageFormat)' == ''">snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Post-build hooks for all projects in the Tosh solution.
    Imported automatically by MSBuild from the repo root.

    `dotnet clean` now removes:
      - The normal bin/ and obj/ (built-in)
      - artifacts/test-results/   (hang dumps, coverage, xml reports)
      - artifacts/publish/        (published single-file binaries)
  -->

  <Target Name="CleanTestResults" AfterTargets="Clean"
          Condition="Exists('$(ArtifactsRoot)test-results')">
    <RemoveDir Directories="$(ArtifactsRoot)test-results" />
    <Message Importance="high" Text="Cleaned test results: $(ArtifactsRoot)test-results" />
  </Target>

  <Target Name="CleanPublishArtifacts" AfterTargets="Clean"
          Condition="Exists('$(ArtifactsRoot)publish')">
    <RemoveDir Directories="$(ArtifactsRoot)publish" />
    <Message Importance="high" Text="Cleaned publish artifacts: $(ArtifactsRoot)publish" />
  </Target>

  <!--
    Recompile the ToastScript language specification when the .tex source
    is newer than the PDF.  Runs only during Tosh.Cli builds (to avoid
    firing once per project) and only when latexmk is installed.

    Opt-out:  dotnet build -p:DisableToshSpecBuild=true
  -->
  <PropertyGroup>
    <SpecDir>$(RepoRoot)docs/spec/</SpecDir>
    <SpecTex>$(SpecDir)toastscript-spec.tex</SpecTex>
    <SpecPdf>$(SpecDir)ToastScript.pdf</SpecPdf>
    <SpecCommandRef>$(SpecDir)command-reference.tex</SpecCommandRef>
  </PropertyGroup>

  <!--
    Generate the command reference LaTeX from introspected command metadata.
    Runs only during Tosh.Cli builds, before BuildSpec.
    The generated file is \input'd by the main spec.

    Opt-out:  dotnet build -p:DisableToshSpecBuild=true
  -->
  <Target Name="GenerateCommandRef"
          AfterTargets="Build"
          BeforeTargets="BuildSpec"
          Condition="'$(DesignTimeBuild)' != 'true'
                     and '$(DisableToshSpecBuild)' != 'true'
                     and '$(MSBuildProjectName)' == 'Tosh.Cli'">
    <Exec Command="dotnet run --project &quot;$(RepoRoot)src/Tosh.Cli/Tosh.Cli.csproj&quot; --no-build -- --export-command-metadata --latex -o &quot;$(SpecCommandRef)&quot;"
          WorkingDirectory="$(RepoRoot)"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_ManifestExit" />
    </Exec>
    <Message Importance="high"
             Text="Command reference generated: $(SpecCommandRef)"
             Condition="'$(_ManifestExit)' == '0'" />
    <Warning Text="Command reference generation failed (exit $(_ManifestExit))"
             Condition="'$(_ManifestExit)' != '0'" />
  </Target>

  <Target Name="BuildSpec"
          AfterTargets="Build"
          Inputs="@(ToshSpecInputs)"
          Outputs="$(SpecPdf)"
          Condition="'$(DesignTimeBuild)' != 'true'
                     and '$(DisableToshSpecBuild)' != 'true'
                     and '$(MSBuildProjectName)' == 'Tosh.Cli'
                     and Exists('$(SpecTex)')">
    <!--
      Track every .tex file under docs/spec/ as an input so changes to \input'd
      files (diagnostic-codes.tex, command-reference.tex, etc.) trigger a rebuild.
      Without this, MSBuild's up-to-date check only saw toastscript-spec.tex and
      silently skipped the rebuild + copy, leaving ToastScript.pdf stale.
    -->
    <ItemGroup>
      <ToshSpecInputs Include="$(SpecDir)*.tex" />
    </ItemGroup>
    <Exec Command="latexmk -pdf -interaction=nonstopmode -quiet toastscript-spec.tex"
          WorkingDirectory="$(SpecDir)"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_LatexMkExit" />
    </Exec>
    <Copy SourceFiles="$(SpecDir)toastscript-spec.pdf"
          DestinationFiles="$(SpecPdf)"
          Condition="'$(_LatexMkExit)' == '0' and Exists('$(SpecDir)toastscript-spec.pdf')"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="Spec PDF updated: $(SpecPdf)"
             Condition="'$(_LatexMkExit)' == '0'" />
    <Warning Text="Spec PDF build failed (latexmk exit $(_LatexMkExit)) — check $(SpecDir)toastscript-spec.log"
             Condition="'$(_LatexMkExit)' != '0'" />
  </Target>

  <!--
    Run the parity / documentation completeness advisory. Fires once during the
    Tosh.Cli build (so it doesn't run for every project), AFTER Tosh.Cli's own
    build completes (so the parity tool's project references resolve against
    fresh assemblies). The tool prints MSBuild canonical warning lines on stdout;
    `ConsoleToMSBuild="true"` surfaces them as warnings, while `IgnoreExitCode="true"`
    guarantees the build is never failed by parity drift.

    Skip while building the parity tool itself or in design-time builds.

    Opt-out:  dotnet build -p:DisableToshParityCheck=true
  -->
  <Target Name="ToshParityCheck"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'
                     and '$(DisableToshParityCheck)' != 'true'
                     and '$(MSBuildProjectName)' == 'Tosh.Cli'">
    <Exec Command="dotnet run --project &quot;$(RepoRoot)tools/Tosh.ParityCheck/Tosh.ParityCheck.csproj&quot; -c $(Configuration) --nologo"
          WorkingDirectory="$(RepoRoot)"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_ToshParityExit" />
    </Exec>
    <Message Importance="normal"
             Text="Tosh parity check complete (exit $(_ToshParityExit))." />
  </Target>


</Project>
