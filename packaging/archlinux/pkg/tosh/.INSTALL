post_install() {
  if ! grep -q '^/usr/bin/tosh$' /etc/shells 2>/dev/null; then
    echo '/usr/bin/tosh' >> /etc/shells
    echo '==> Added /usr/bin/tosh to /etc/shells'
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  if grep -q '^/usr/bin/tosh$' /etc/shells 2>/dev/null; then
    sed -i '/^\/usr\/bin\/tosh$/d' /etc/shells
    echo '==> Removed /usr/bin/tosh from /etc/shells'
  fi
}