#!/usr/bin/env tosh
# showcase.tosh
# A quick tour of tosh — typed object pipelines meet Unix shell ergonomics.
# For deeper dives, see the topic-specific scripts alongside this file.

echo "=== Object Pipelines ==="
ls -la | where _.Type == file | sort Size | get { Name, Size }

echo "=== Typed Functions ==="
func bigFiles(minSize: StorageSize) {
    ls -la | where _.Type == file | where _.Size >= $minSize | sort Size | reverse
}
bigFiles 512b | get { Name, Size }

echo "=== String Interpolation ==="
var user = (whoami)
echo $"Welcome, {$user}!"
echo $"There are {ls | where _.Type == file | count} files here."
echo $"2 + 2 = {2 + 2}"

echo "=== Control Flow ==="
var names = ["alice", "bob", "carol"]
for name in ($names) { echo $name }

var counter = 0
while (($counter < 3)) {
    echo $counter
    $counter = ($counter + 1)
}

echo "=== .NET Interop ==="
echo "GUID:" (new System.Guid "d3b07384-d113-4ec6-a5d2-5b1d0d2e8c39")
echo "Random:" (new System.Random | call Next 1 100)
echo "Upper:" ("hello, tosh".ToUpper())
echo "Join:" (String.Join(" + ", ["objects", "pipelines", "types"]))
echo "PI:" (Math.Round(Math.PI, 4))

echo "=== Command Wrappers ==="
func ll   => ls -la
func dirs => ls -la | where { _.Type == dir }
func big  => ls -la | where { _.Type == file } | sort Size | reverse | first 5
big | get { Name, Size }

echo "=== Optional Parameters ==="
func greet(name: String, title?: String) {
    if ($title is not null) {
        echo $"Hello, {$title} {$name}!"
    } else {
        echo $"Hello, {$name}!"
    }
}
greet "Alice" "Dr."
greet "Bob"

echo "=== System Info ==="
uname | get { SystemName, Release, Machine }
ps | sort WorkingSet | reverse | first 5 | get { Name, WorkingSet, Cpu }
df | first 3
free

echo ""
echo "ToastedShell -- typed objects, rich tables, full .NET, zero friction."
