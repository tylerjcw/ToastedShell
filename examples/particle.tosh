export class Particle<T>
{
    proud prop Position : ToastLib.Math.Point2D<double> = ToastLib.Math.Point2D.Empty<double>()
    proud prop Velocity : ToastLib.Math.Vector2D<double> = ToastLib.Math.Vector2D.Zero<double>()
    proud prop Symbol   : char = Char.MinValue
    proud prop Color    : ConsoleColor = Random.Shared.Next(9, 15) as ConsoleColor

    Particle<T>(x : T, y : T)
    {
        $this.Position.X = $x
        $this.Position.Y = $y
        $this.Velocity.X = (Random.Shared.NextDouble() * 0.8 - 0.4)
        $this.Velocity.Y = (Random.Shared.NextDouble() * 0.8 - 0.4)
        $this.Symbol = "●★♦■◆▲"[Random.Shared.Next(6)];
        $this.Color = Random.Shared.Next(9, 15) as ConsoleColor
    }
}

var particles: list = new list()
var width: int = Math.Max(10, System.Console.WindowWidth  - 1)
var height: int = Math.Max(10, System.Console.WindowHeight - 1)
System.Console.CursorVisible = false

func ApplyForces(p: Particle) {
    var centerX: double = $width  / 2
    var centerY: double = $height / 2
    var dist: double = Math.sqrt(($p.Position.X ** 2) + ($p.Position.Y ** 2))
    var time: double = Environment.TickCount / 1000.0
    var oscillation: double = Math.Sin($time * 0.8)  # Oscillation over time
    var factor: double = $oscillation * 0.1  # Force factor oscillates between attraction and repulsion
    $p.Velocity.X += ($centerX - $p.Position.X) * $factor
    $p.Velocity.Y += ($centerY - $p.Position.Y) * $factor
    $p.Velocity.X *= 0.97  # Moderate damping
    $p.Velocity.Y *= 0.97
}

for i in 0..39 {
    $particles.Add(new Particle<int>(Random.Shared.Next($width), Random.Shared.Next($height)))
}

while (not(System.Console.KeyAvailable)) {
    clear
    for particle in $particles {
        ApplyForces($particle)
        $particle.Position.X = ($particle.Position.X + $particle.Velocity.X + $width)  % $width
        $particle.Position.Y = ($particle.Position.Y + $particle.Velocity.Y + $height) % $height
        System.Console.SetCursorPosition(Math.Round($particle.Position.X, 0), Math.Round($particle.Position.Y, 0))
        System.Console.ForegroundColor = $particle.Color
        System.Console.Write($particle.Symbol)
    }
    sleep(0.07)
}
