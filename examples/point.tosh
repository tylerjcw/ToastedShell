hollow class _Point<T1, T2> {
    hollow prop X: T1
    hollow prop Y: T2
    hollow prop IsEmpty: bool
    
    hollow shared func Empty() -> _Point<T1, T2> {}

    hollow func +(other: _Point<T1, T2>) -> _Point<T1, T2> {}
    hollow func -(other: _Point<T1, T2>) -> _Point<T1, T2> {}
    hollow func *(other: _Point<T1, T2>) -> _Point<T1, T2> {}
    hollow func /(other: _Point<T1, T2>) -> _Point<T1, T2> {}
    
    hollow func +(other: int) -> _Point<T1, T2> {}
    hollow func -(other: int) -> _Point<T1, T2> {}
    hollow func *(other: int) -> _Point<T1, T2> {}
    hollow func /(other: int) -> _Point<T1, T2> {}

    hollow func +(other: float) -> _Point<T1, T2> {}
    hollow func -(other: float) -> _Point<T1, T2> {}
    hollow func *(other: float) -> _Point<T1, T2> {}
    hollow func /(other: float) -> _Point<T1, T2> {}

    hollow func +(other: double) -> _Point<T1, T2> {}
    hollow func -(other: double) -> _Point<T1, T2> {}
    hollow func *(other: double) -> _Point<T1, T2> {}
    hollow func /(other: double) -> _Point<T1, T2> {}
}

class Point2D<T1, T2> extends _Point<T1, T2> {
    overrule prop X: T1
    overrule prop Y: T2
    overrule prop IsEmpty: bool => (($this.X, $this.Y) == (0, 0))
 
    Point2D<T1, T2>(x: T1, y: T2) {
        $this.X = $x
        $this.Y = $y
    }
     
    overrule shared func Empty() -> Point2D<int, int> {
        return new Point2D<int, int>(0, 0)
    }

    overrule func +(other: _Point<T1, T2>) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X + $other.X, $this.Y + $other.Y)
    }

    overrule func -(other: _Point<T1, T2>) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X - $other.X, $this.Y - $other.Y)
    }

    overrule func *(other: _Point<T1, T2>) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X * $other.X, $this.Y * $other.Y)
    }

    overrule func /(other: _Point<T1, T2>) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X / $other.X, $this.Y / $other.Y)
    }

    overrule func +(other: int) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X + $other, $this.Y + $other)
    }

    overrule func -(other: int) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X - $other, $this.Y - $other)
    }

    overrule func *(other: int) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X * $other, $this.Y * $other)
    }

    overrule func /(other: int) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X / $other, $this.Y / $other)
    }

    overrule func +(other: float) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X + $other, $this.Y + $other)
    }

    overrule func -(other: float) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X - $other, $this.Y - $other)
    }

    overrule func *(other: float) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X * $other, $this.Y * $other)
    }

    overrule func /(other: float) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X / $other, $this.Y / $other)
    }

    overrule func +(other: double) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X + $other, $this.Y + $other)
    }

    overrule func -(other: double) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X - $other, $this.Y - $other)
    }

    overrule func *(other: double) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X * $other, $this.Y * $other)
    }

    overrule func /(other: double) -> Point2D<T1, T2> {
        return new Point2D<T1, T2>($this.X / $other, $this.Y / $other)
    }
}

sealed class Point3D<T1, T2, T3> extends _Point<T1, T2> {
    overrule prop X: T1
    overrule prop Y: T2
    prop Z: T3
    overrule prop IsEmpty: bool => (($this.X, $this.Y, $this.Z) == (0, 0, 0))

    Point3D<T1, T2, T3>(x: T1, y: T2, z: T3) {
        $this.X = $x
        $this.Y = $y
        $this.Z = $z
    }

    overrule shared func Empty() -> Point3D<int, int, int> {
        return new Point3D<int, int, int>(0, 0, 0)
    }

    overrule func +(other: Point3D<T1, T2, T3>) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X + $other.X, $this.Y + $other.Y, $this.Z + $other.Z)
    }

    overrule func -(other: Point3D<T1, T2, T3>) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X - $other.X, $this.Y - $other.Y, $this.Z - $other.Z)
    }

    overrule func *(other: Point3D<T1, T2, T3>) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X * $other.X, $this.Y * $other.Y, $this.Z * $other.Z)
    }

    overrule func /(other: Point3D<T1, T2, T3>) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X / $other.X, $this.Y / $other.Y, $this.Z / $other.Z)
    }

    overrule func +(other: int) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X + $other, $this.Y + $other, $this.Z + $other)
    }

    overrule func -(other: int) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X - $other, $this.Y - $other, $this.Z - $other)
    }

    overrule func *(other: int) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X * $other, $this.Y * $other, $this.Z * $other)
    }

    overrule func /(other: int) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X / $other, $this.Y / $other, $this.Z / $other)
    }

    overrule func +(other: float) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X + $other, $this.Y + $other, $this.Z + $other)
    }

    overrule func -(other: float) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X - $other, $this.Y - $other, $this.Z - $other)
    }

    overrule func *(other: float) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X * $other, $this.Y * $other, $this.Z * $other)
    }

    overrule func /(other: float) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X / $other, $this.Y / $other, $this.Z / $other)
    }

    overrule func +(other: double) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X + $other, $this.Y + $other, $this.Z + $other)
    }

    overrule func -(other: double) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X - $other, $this.Y - $other, $this.Z - $other)
    }

    overrule func *(other: double) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X * $other, $this.Y * $other, $this.Z * $other)
    }

    overrule func /(other: double) -> Point3D<T1, T2, T3> {
        return new Point3D<T1, T2, T3>($this.X / $other, $this.Y / $other, $this.Z / $other)
    }
}
