#!/bin/tosh
# Reactor block calculator for Factorio 2.0.77 + Plutonium Energy 1.8.1
# Values verified against prototype Lua source:
#   base/prototypes/entity/entities.lua   (reactor, exchanger, turbine)
#   base/prototypes/item.lua              (uranium-fuel-cell)
#   PlutoniumEnergy/prototypes/entity/entities.lua  (MOX, breeder reactors)
#   PlutoniumEnergy/prototypes/item/items.lua       (fuel cells)

# ── Fuel types (GJ per cell from prototype fuel_value fields) ──────────
module Fuel {
    enum Mox: int {
        Energy = 3
    }

    enum Uranium: int {
        Energy = 8
    }

    enum Breeder: int {
        Energy = 10
    }

    enum Plutonium: int {
        Energy = 20
    }
}

# ── Reactor type definition ────────────────────────────────────────────
class Reactor(name: string, heat: power, percent: double, fuel) {
    shy fixed prop _fuel               = $fuel
    fixed prop Name           : string       = $name
    fixed prop Heat           : power        = $heat
    fixed prop NeighborPercent: double       = $percent
    fixed prop FuelName       : string       => $this._fuel.Name
    fixed prop FuelEnergy     : energy       => $this._fuel.Energy.UnderlyingValue * 1`GJ
    fixed prop NeighborPower  : power        => ($this.NeighborPercent / 100) * $this.Heat
    fixed prop BurnTime       : timequantity => $this.FuelEnergy / $this.Heat
}

# ── Reactor block calculator ──────────────────────────────────────────
class ReactorBlock(reactorType: Reactor, width: int = 2, height: int = 2, bufferDuration: timequantity = 300`s, tankCapacity: volume = 25000`L) {
    prop Width         : int          = $width
    prop Height        : int          = $height
    prop BufferDuration: timequantity = $bufferDuration
    prop Type          : Reactor      = $reactorType
    prop TankCapacity  : volume       = $tankCapacity

    # ── Thermal ────────────────────────────────────────────────────────
    # Each adjacency link adds the neighbor bonus to BOTH reactors.
    prop ReactorCount: int   => $this.Width * $this.Height
    prop Links       : int   => ($this.Width - 1) * $this.Height + ($this.Height - 1) * $this.Width
    prop OutputPower : power => $this.ReactorCount * $this.Type.Heat + 2 * $this.Type.NeighborPower * $this.Links

    # ── Infrastructure ─────────────────────────────────────────────────
    # 10 MW per heat exchanger, 5.82 MW per steam turbine (500°C steam)
    # each pump moves 1200 water/sec, each exchanger needs 10.3 water/sec
    prop Exchangers     : int   => Math.Ceiling($this.OutputPower / 10`MW)
    prop Turbines       : int   => Math.Ceiling($this.OutputPower / 5.82`MW)
    prop Pumps          : int   => Math.Ceiling($this.WaterPerSecond / 1200`L/s)
    prop ElectricalPower: power => $this.Turbines * 5.82`MW

    # ── Steam buffer ──────────────────────────────────────────────────
    # Each heat exchanger produces ~103 steam/sec
    prop WaterPerSecond: flowrate => $this.Exchangers * 10.3`L/s
    prop SteamPerSecond: flowrate => $this.Exchangers * 103`L/s
    prop SteamBuffer   : volume   => $this.SteamPerSecond * $this.BufferDuration
    prop Tanks         : int      => Math.Ceiling($this.SteamBuffer / $this.TankCapacity)

    # ── Fuel logistics ────────────────────────────────────────────────
    prop BurnTime  : timequantity => $this.Type.BurnTime
    prop FuelPerMin: double       => (60`s / $this.BurnTime) * $this.ReactorCount
}

using Tosh.Tui.Widgets = Tui

## @summary Resolves a reactor type by name.
## @remarks
##   Folded here rather than at each call site, so a type supplied on the command line is
##   matched the same way as one chosen in the form — and so the live preview and the
##   final answer cannot disagree about what "MOX" means.
func ReactorFor(name: string) -> Reactor {
    return match($name.ToLower()) {
        "nuclear"   => new Reactor("Nuclear", 40`MW, 100, Fuel.Uranium  )
        "uranium"   => new Reactor("Nuclear", 40`MW, 100, Fuel.Uranium  )
        "plutonium" => new Reactor("Nuclear", 40`MW, 100, Fuel.Plutonium)
        "mox"       => new Reactor("MOX",     20`MW, 150, Fuel.Mox      )
        "breeder"   => new Reactor("Breeder", 20`MW, 50,  Fuel.Breeder  )
        default     => throw $"Unknown reactor type '{$name}'. Valid: nuclear, uranium, plutonium, mox, breeder"
    }
}

## @summary The right-hand pane of the form: the block as the numbers currently stand.
## @remarks
##   A pull binding. The form hands it every field's current value and it returns what to
##   show, so there is nothing to wire up and nothing to keep in step — editing a field
##   redraws the screen, and redrawing calls this again.
##
##   It is also the one place in the script that runs on half-typed input, so every field
##   is read defensively: a width of "" is a number the user is in the middle of writing,
##   not a mistake worth an error message.
func Preview(values) {
    try {
        var w = Whole($values.Width,    1)
        var h = Whole($values.Height,   1)
        var s = Whole($values.Seconds,  1)
        var c = Whole($values.Capacity, 1)

        var rb = new ReactorBlock(ReactorFor($"{$values.ReactorType}"), $w, $h, $s * 1`s, $c * 1`L)

        return $"""
{$rb.ReactorCount}x {$rb.Type.Name} ({$rb.Type.Heat})
    Dimensions  {$rb.Width}x{$rb.Height}, {$rb.Links} links
    Bonus       {$rb.Type.NeighborPercent}% ({$rb.Type.NeighborPower})
    Fuel        {$rb.FuelPerMin} {$rb.Type.FuelName}/min

Power
    Heat        {$rb.OutputPower}
    Electrical  {$rb.ElectricalPower}

Plumbing
    {$rb.Pumps}x offshore pump(s)
    {$rb.Exchangers}x exchangers, {$rb.WaterPerSecond}
    {$rb.Turbines}x turbines, {$rb.SteamPerSecond}
    {$rb.Tanks}x tanks, {$rb.BufferDuration.TimeSpan}
"""
    } catch (e) {
        return "..."
    }
}

## @summary Reads a form field as a whole number, tolerating what half-typed input looks like.
func Whole(value, fallback: int) -> int {
    var text = $"{$value}"
    var trimmed = $text.Trim()

    if ($trimmed == "") {
        return $fallback
    }

    ## A cast is not a test. `"abc" as int` throws rather than yielding null — the same
    ## trap `TS-P2-111` records against the argument shift below — so the shape has to be
    ## checked before the value is read, and a half-typed field is exactly where that
    ## matters.
    if (not ($trimmed =~ "^[0-9]+$")) {
        return $fallback
    }

    var parsed = $trimmed as int

    if ($parsed < 1) {
        return $fallback
    }

    return $parsed
}

## @summary Calculates the statistics of a Factorio Reactor Block
## @param=ReactorType Valid types: Nuclear/Uranium, Plutonium, MOX, or Breeder
## @param=Width Number of reactors wide
## @param=Height Number of reactors high
## @param=Seconds Number of seconds the steam buffer should last
## @param=Capacity Capacity of the steam tanks
subcommand calc {
    ## @summary Valid types: Nuclear/Uranium, Plutonium, MOX, or Breeder. Prompts when omitted.
    arg ReactorType: string = ""

    ## @summary Number of reactors wide
    arg Width      : int    = 2

    ## @summary Number of reactors high
    arg Height     : int    = 2

    ## @summary Number of seconds the steam buffer should last
    arg Seconds    : int    = 300

    ## @summary Capacity of the steam tanks
    arg Capacity   : int    = 25000

    ## `ReactorType` is the first positional, so omitting it shifts every later
    ## argument one place left: `calc 2 2 300 25000` lands the width in
    ## `ReactorType`. A leading number is what that looks like, and the arguments
    ## are shifted back before the picker fills in the type.
    ##
    ## The test is a regex rather than a cast on purpose. `"2" as int` succeeds,
    ## but `"Nuclear" as int` *throws* rather than yielding something falsy, so
    ## using the cast as the condition fails on exactly the inputs that do not
    ## need shifting (`TS-P2-111`).
    if ($ReactorType =~ "^[0-9]+$") {
        $Capacity    = $Seconds
        $Seconds     = $Height
        $Height      = $Width
        $Width       = $ReactorType as int
        $ReactorType = ""
    }

    ## The form is the fallback, not the only way in: passing the type keeps the
    ## script runnable non-interactively. It asks for everything rather than only the
    ## type, with the block itself alongside the fields — the numbers move as they are
    ## typed, so the shape of the answer is visible before committing to it.
    ##
    ## Built the way a Windows Forms window is: construct the widgets, set their
    ## properties, put them in containers, and answer the events worth answering.
    if ($ReactorType == "") {
        var kinds = new Tui.TuiList(["Nuclear", "Plutonium", "MOX", "Breeder"]) {| Id = "ReactorType" |}

        var wide     = new Tui.TuiField("Wide",     $"{$Width}")    {| Id = "Width"    |}
        var high     = new Tui.TuiField("High",     $"{$Height}")   {| Id = "Height"   |}
        var seconds  = new Tui.TuiField("Seconds",  $"{$Seconds}")  {| Id = "Seconds"  |}
        var capacity = new Tui.TuiField("Capacity", $"{$Capacity}") {| Id = "Capacity" |}

        ## `TextSource` is what makes the right pane live: a property set to a function is
        ## re-read whenever the screen redraws, and a keystroke is what causes a redraw.
        ## There is no update code and nothing to wire.
        var preview = new Tui.TuiTextWidget() {| TextSource = &Preview |}

        var inputs = new Tui.TuiStack(Tui.TuiOrientation.Vertical) {|
            Items = [$kinds, $wide, $high, $seconds, $capacity]
        |}

        var panes = new Tui.TuiStack(Tui.TuiOrientation.Horizontal) {|
            Items = [
                new Tui.TuiBorder($inputs,  "Inputs") {| Size = "2*" |},
                new Tui.TuiBorder($preview, "Block")  {| Size = "3*" |},
            ]
        |}

        var form = new Tui.TuiForm($panes) {| Title = "Reactor Block" |}

        ## Enter accepts the form and this runs while the widgets are still here to be
        ## read, so the answers come from the things the script just built rather than
        ## from a dictionary keyed by their ids. The ids are still worth having — they are
        ## what `Preview` sees — but they are for the live view, not for the result.
        $form.Submitted = func() {
            $ReactorType = $"{$kinds.SelectedItem}"
            $Width       = Whole($wide.Text,     2)
            $Height      = Whole($high.Text,     2)
            $Seconds     = Whole($seconds.Text,  300)
            $Capacity    = Whole($capacity.Text, 25000)
        }

        tui run $form

        ## Escape leaves the form cancelled, so walking away needs no flag of its own.
        if ($form.WasCancelled) {
            throw "Cancelled."
        }
    }

    var reactor = ReactorFor($ReactorType)

    var rb = new ReactorBlock($reactor, $Width, $Height, $Seconds * 1`s, $Capacity * 1`L)

    writeline $"""
    {$rb.ReactorCount}x {$rb.Type.Name} Reactors ({$rb.Type.Heat}):
        Fuel       = {$rb.Type.FuelName} ({$rb.Type.FuelEnergy}, {$rb.Type.BurnTime})
        Fuel / min = {$rb.FuelPerMin} {$rb.Type.FuelName}/min
        Bonus      = {$rb.Type.NeighborPercent}% ({$rb.Type.NeighborPower})
        Dimensions = {$rb.Width}x{$rb.Height} ({$rb.Links} links)
        Tot. Power = {$rb.OutputPower}
    
    {$rb.Pumps}x Offshore Pump(s)
    
    {$rb.Exchangers}x Exchangers:
        Output Heat = {$rb.OutputPower}
        Water / sec = {$rb.WaterPerSecond}
    
    {$rb.Turbines}x Turbines:
        Energy      = {$rb.ElectricalPower}
        Steam / sec = {$rb.SteamPerSecond}
    
    {$rb.Tanks}x Water Tanks:
        Capacity = {$rb.TankCapacity * $rb.Tanks} ({$rb.SteamBuffer})
        Duration = {$rb.BufferDuration.TimeSpan}
    """

    ## The rendering above is for a reader; the block itself is for a pipeline, so
    ## `reactor-block.tosh calc Nuclear | get OutputPower` works.
    $rb
}
