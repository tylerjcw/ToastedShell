#!/bin/tosh
# Reactor block calculator for Factorio 2.0.77 + Plutonium Energy 1.8.1
#
# The same calculator as `reactor-block.tosh`, with the form written as markup rather
# than built with `new`. Everything outside the form is identical, on purpose: the two
# files exist to be read side by side.
#
# Values verified against prototype Lua source:
#   base/prototypes/entity/entities.lua   (reactor, exchanger, turbine)
#   base/prototypes/item.lua              (uranium-fuel-cell)
#   PlutoniumEnergy/prototypes/entity/entities.lua  (MOX, breeder reactors)
#   PlutoniumEnergy/prototypes/item/items.lua       (fuel cells)
# ── Fuel types (GJ per cell from prototype fuel_value fields) ──────────
module Fuel {
    enum Mox: int {
        Energy = 3
    }

    enum Uranium: int {
        Energy = 8
    }

    enum Breeder: int {
        Energy = 10
    }

    enum Plutonium: int {
        Energy = 20
    }
}

# ── Reactor type definition ────────────────────────────────────────────
class Reactor(name: string, heat: power, percent: double, fuel) {
    shy fixed prop _fuel               = $fuel
    fixed prop Name           : string       = $name
    fixed prop Heat           : power        = $heat
    fixed prop NeighborPercent: double       = $percent
    fixed prop FuelName       : string       => $this._fuel.Name
    fixed prop FuelEnergy     : energy       => $this._fuel.Energy.UnderlyingValue * 1`GJ
    fixed prop NeighborPower  : power        => ($this.NeighborPercent / 100) * $this.Heat
    fixed prop BurnTime       : timequantity => $this.FuelEnergy / $this.Heat

    shared prop Uranium   : Reactor => new Reactor("Nuclear",   40`MW, 100, Fuel.Uranium  )
    shared prop Plutonium : Reactor => new Reactor("Nuclear",   40`MW, 100, Fuel.Plutonium)
    shared prop Mox       : Reactor => new Reactor("MOX",       20`MW, 150, Fuel.Mox      )
    shared prop Breeder   : Reactor => new Reactor("Breeder",   20`MW, 50,  Fuel.Breeder  )
}

# ── Reactor block calculator ──────────────────────────────────────────
class ReactorBlock(reactorType: Reactor, width: int = 2, height: int = 2, bufferDuration: timequantity = 300`s, tankCapacity: volume = 25000`L) {
    prop Width         : int          = $width
    prop Height        : int          = $height
    prop BufferDuration: timequantity = $bufferDuration
    prop Type          : Reactor      = $reactorType
    prop TankCapacity  : volume       = $tankCapacity

    # ── Thermal ────────────────────────────────────────────────────────
    # Each adjacency link adds the neighbor bonus to BOTH reactors.
    prop ReactorCount: int   => $this.Width * $this.Height
    prop Links       : int   => ($this.Width - 1) * $this.Height + ($this.Height - 1) * $this.Width
    prop OutputPower : power => $this.ReactorCount * $this.Type.Heat + 2 * $this.Type.NeighborPower * $this.Links

    # ── Infrastructure ─────────────────────────────────────────────────
    # 10 MW per heat exchanger, 5.82 MW per steam turbine (500°C steam)
    # each pump moves 1200 water/sec, each exchanger needs 10.3 water/sec
    prop Exchangers     : int   => Math.Ceiling($this.OutputPower / 10`MW)
    prop Turbines       : int   => Math.Ceiling($this.OutputPower / 5.82`MW)
    prop Pumps          : int   => Math.Ceiling($this.WaterPerSecond / 1200`L/s)
    prop ElectricalPower: power => $this.Turbines * 5.82`MW

    # ── Steam buffer ──────────────────────────────────────────────────
    # Each heat exchanger produces ~103 steam/sec
    prop WaterPerSecond: flowrate => $this.Exchangers * 10.3`L/s
    prop SteamPerSecond: flowrate => $this.Exchangers * 103`L/s
    prop SteamBuffer   : volume   => $this.SteamPerSecond * $this.BufferDuration
    prop Tanks         : int      => Math.Ceiling($this.SteamBuffer / $this.TankCapacity)

    # ── Fuel logistics ────────────────────────────────────────────────
    prop BurnTime  : timequantity => $this.Type.BurnTime
    prop FuelPerMin: double       => (60`s / $this.BurnTime) * $this.ReactorCount
}

## Nothing is imported. A markup tree names widgets by what they are — `Field`, `List`,
## `Box` — rather than by CLR type, so there is no namespace to bring in and no prefix to
## repeat. `using Tosh.Tui.Widgets` is only wanted by a script that also reaches for the
## types directly.

## @summary The right-hand pane of the form: the block as the numbers currently stand.
## @remarks
##   A pull binding. The form hands it every field's current value and it returns what to
##   show, so there is nothing to wire up and nothing to keep in step — editing a field
##   redraws the screen, and redrawing calls this again.
##
##   It is also the one place in the script that runs on half-typed input, so every field
##   is read defensively: a width of "" is a number the user is in the middle of writing,
##   not a mistake worth an error message.
func Preview(values) {
    try {
        var w = Whole($values.Width,    1)
        var h = Whole($values.Height,   1)
        var s = Whole($values.Seconds,  1)
        var c = Whole($values.Capacity, 1)

        var reactor = eval $"Reactor.{$values.ReactorType}"
        var rb = new ReactorBlock($reactor, $w, $h, $s * 1`s, $c * 1`L)

        return $"""
            {$rb.ReactorCount}x {$rb.Type.Name} ({$rb.Type.Heat})
                Dimensions  {$rb.Width}x{$rb.Height}, {$rb.Links} links
                Bonus       {$rb.Type.NeighborPercent}% ({$rb.Type.NeighborPower})
                Fuel        {$rb.FuelPerMin} {$rb.Type.FuelName}/min

            Power
                Heat        {$rb.OutputPower}
                Electrical  {$rb.ElectricalPower}

            Plumbing
                {$rb.Pumps}x offshore pump(s)
                {$rb.Exchangers}x exchangers, {$rb.WaterPerSecond}
                {$rb.Turbines}x turbines, {$rb.SteamPerSecond}
                {$rb.Tanks}x tanks, {$rb.BufferDuration.TimeSpan}
            """
    } catch (e) {
        return "..."
    }
}

## @summary Reads a form field as a whole number, tolerating what half-typed input looks like.
func Whole(value, fallback: int) -> int {
    var text = $"{$value}"
    var trimmed = $text.Trim()

    if ($trimmed == "") {
        return $fallback
    }

    if (not ($trimmed =~ "^[0-9]+$")) {
        return $fallback
    }

    var parsed = $trimmed as int

    if ($parsed < 1) {
        return $fallback
    }

    return $parsed
}

## @summary Calculates the statistics of a Factorio Reactor Block
## @param=ReactorType Valid types: Nuclear/Uranium, Plutonium, MOX, or Breeder
## @param=Width Number of reactors wide
## @param=Height Number of reactors high
## @param=Seconds Number of seconds the steam buffer should last
## @param=Capacity Capacity of the steam tanks
subcommand calc {
    ## @summary Valid types: Nuclear/Uranium, Plutonium, MOX, or Breeder. Prompts when omitted.
    arg ReactorType: string = ""

    ## @summary Number of reactors wide
    arg Width      : int    = 2

    ## @summary Number of reactors high
    arg Height     : int    = 2

    ## @summary Number of seconds the steam buffer should last
    arg Seconds    : int    = 300

    ## @summary Capacity of the steam tanks
    arg Capacity   : int    = 25000

    if ($ReactorType =~ "^[0-9]+$") {
        $Capacity    = $Seconds
        $Seconds     = $Height
        $Height      = $Width
        $Width       = $ReactorType as int
        $ReactorType = ""
    }

    if ($ReactorType == "") {
        var cancelled = false

        tui run {|
            Form = [ {|
                Row = [
                    {|
                        Title = "Inputs",
                        Size  = "2*",
                        Box = [
                            {| List  = ["Uranium", "Plutonium", "MOX", "Breeder"], Id = "ReactorType" |},
                            {| Field = "Wide",     Id = "Width",    Value = $"{$Width}"    |},
                            {| Field = "High",     Id = "Height",   Value = $"{$Height}"   |},
                            {| Field = "Seconds",  Id = "Seconds",  Value = $"{$Seconds}"  |},
                            {| Field = "Capacity", Id = "Capacity", Value = $"{$Capacity}" |}
                        ]
                    |},
                    {|
                        Title = "Block",
                        Size = "3*",
                        Box = [
                            {| Text = &Preview |}
                        ]
                    |}
                ]
            |} ],

            Title = "Reactor Block",

            OnSubmit = func(form) {
                $ReactorType = $"{$form.Values.ReactorType}"
                $Width       = Whole($form.Values.Width,    2)
                $Height      = Whole($form.Values.Height,   2)
                $Seconds     = Whole($form.Values.Seconds,  300)
                $Capacity    = Whole($form.Values.Capacity, 25000)
            },

            OnCancel = func() { $cancelled = true }
        |}

        if ($cancelled) {
            throw (new Error("No reactor type chosen"))
        }
    }

    var reactor = eval $"Reactor.{$ReactorType}"
    return new ReactorBlock($reactor, $Width, $Height, $Seconds * 1`s, $Capacity * 1`L)
}
