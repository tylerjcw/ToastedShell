  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tosh.Core\Tosh.Core.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Language\Tosh.Language.csproj" />
  </ItemGroup>

</Project>
