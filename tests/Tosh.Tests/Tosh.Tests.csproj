<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Caps test parallelism at 8. This was added believing parallelism drove the
      suite's memory; measurement disproved that — 32 threads peak at 3,737 MB and 8
      at 3,860 MB, indistinguishable, with identical wall time. It is kept for a
      different and weaker reason: the two tests that have flaked in this programme
      failed only under parallel load, and a lower, fixed thread count makes runs
      more comparable to each other. See TS-P2-38 and TS-P2-39.
    -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tosh.Cli\Tosh.Cli.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Compiler.IR\Tosh.Compiler.IR.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Language\Tosh.Language.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Runtime\Tosh.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Stdlib\Tosh.Stdlib.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Tui\Tosh.Tui.csproj" />
    <ProjectReference Include="..\..\src\Tosh.LanguageServices\Tosh.LanguageServices.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Client\Tosh.Client.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Lsp\Tosh.Lsp.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Mcp\Tosh.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Compiler\Tosh.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Crumb\Tosh.Crumb.csproj" />
    <ProjectReference Include="..\..\src\Tosh.Tome\Tosh.Tome.csproj" />
  </ItemGroup>

</Project>
