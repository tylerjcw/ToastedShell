<Project>

  <!--
    Shared properties for all projects in the Tosh solution.
    Imported automatically by MSBuild from the repo root.
  -->

  <PropertyGroup>
    <RepoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Tosh.slnx'))\</RepoRoot>
    <ArtifactsRoot>$(RepoRoot)artifacts\</ArtifactsRoot>
  </PropertyGroup>

  <!--
    CalVer versioning: YY.MM.Publish#.DotNetMajor
    Internal/assembly: 26.4.2.10    (four-part numeric)
    Display:           26.4-2-10    (dashes between publish# and .NET major)

    The publish number auto-increments on each `dotnet publish` of Tosh.Cli
    via the IncrementToshPublishNumber target in Directory.Build.targets.
    State is tracked in .tosh-publish-state at the repo root. The format is
        YY.M:N[:D]
    where YY.M is the calendar key (year.month), N is the publish counter
    that resets when the calendar key rolls over, and D is the optional
    .NET SDK major (defaults to ToshDotNetMajor below if absent).
    When the calendar month changes, the publish number resets to 1.
    `scripts/build.tosh version` (with the dotnet flag) writes the third field.
  -->
  <PropertyGroup>
    <ToshCalYear>$([System.DateTime]::UtcNow.ToString('yy'))</ToshCalYear>
    <ToshCalMonth>$([System.DateTime]::UtcNow.Month)</ToshCalMonth>
    <ToshDotNetMajor>10</ToshDotNetMajor>

    <!-- Read publish state from .tosh-publish-state ("YY.M:N[:D]" format) -->
    <_ToshPubStateFile>$(MSBuildThisFileDirectory).tosh-publish-state</_ToshPubStateFile>
    <_ToshPubRaw Condition="Exists('$(_ToshPubStateFile)')">$([System.IO.File]::ReadAllText('$(_ToshPubStateFile)').Trim())</_ToshPubRaw>
    <_ToshPubColonIdx Condition="'$(_ToshPubRaw)' != ''">$(_ToshPubRaw.IndexOf(':'))</_ToshPubColonIdx>
    <_ToshPubStoredKey Condition="'$(_ToshPubColonIdx)' != '' and '$(_ToshPubColonIdx)' != '-1'">$(_ToshPubRaw.Remove($(_ToshPubColonIdx)))</_ToshPubStoredKey>
    <_ToshPubAfterColon Condition="'$(_ToshPubColonIdx)' != '' and '$(_ToshPubColonIdx)' != '-1'">$([MSBuild]::Add($(_ToshPubColonIdx), 1))</_ToshPubAfterColon>
    <_ToshPubTail Condition="'$(_ToshPubAfterColon)' != ''">$(_ToshPubRaw.Substring($(_ToshPubAfterColon)))</_ToshPubTail>
    <!-- Tail may be either "N" (legacy) or "N:D" (current). -->
    <_ToshPubTailColonIdx Condition="'$(_ToshPubTail)' != ''">$(_ToshPubTail.IndexOf(':'))</_ToshPubTailColonIdx>
    <_ToshPubStoredNum Condition="'$(_ToshPubTailColonIdx)' == '-1'">$(_ToshPubTail)</_ToshPubStoredNum>
    <_ToshPubStoredNum Condition="'$(_ToshPubTailColonIdx)' != '' and '$(_ToshPubTailColonIdx)' != '-1'">$(_ToshPubTail.Remove($(_ToshPubTailColonIdx)))</_ToshPubStoredNum>
    <_ToshPubStoredDotnet Condition="'$(_ToshPubTailColonIdx)' != '' and '$(_ToshPubTailColonIdx)' != '-1'">$(_ToshPubTail.Substring($([MSBuild]::Add($(_ToshPubTailColonIdx), 1))))</_ToshPubStoredDotnet>
    <ToshDotNetMajor Condition="'$(_ToshPubStoredDotnet)' != ''">$(_ToshPubStoredDotnet)</ToshDotNetMajor>
    <_ToshCurrentCalKey>$(ToshCalYear).$(ToshCalMonth)</_ToshCurrentCalKey>

    <!-- Use stored number if same month, otherwise reset to 1 -->
    <ToshPublishNumber Condition="'$(_ToshPubStoredKey)' == '$(_ToshCurrentCalKey)' and '$(_ToshPubStoredNum)' != ''">$(_ToshPubStoredNum)</ToshPublishNumber>
    <ToshPublishNumber Condition="'$(ToshPublishNumber)' == ''">1</ToshPublishNumber>

    <AssemblyVersion>$(ToshCalYear).$(ToshCalMonth).$(ToshPublishNumber).$(ToshDotNetMajor)</AssemblyVersion>
    <FileVersion>$(ToshCalYear).$(ToshCalMonth).$(ToshPublishNumber).$(ToshDotNetMajor)</FileVersion>
    <InformationalVersion>$(ToshCalYear).$(ToshCalMonth)-$(ToshPublishNumber)-$(ToshDotNetMajor)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>$(ToshCalYear).$(ToshCalMonth).$(ToshPublishNumber).$(ToshDotNetMajor)</Version>
  </PropertyGroup>

  <!-- Redirect test results into artifacts/test-results/ so they don't accumulate next to test sources. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' or '$(IsPackable)' == 'false'">
    <VSTestResultsDirectory>$(ArtifactsRoot)test-results\</VSTestResultsDirectory>
  </PropertyGroup>

</Project>
