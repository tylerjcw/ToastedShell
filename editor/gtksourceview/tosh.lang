    </context>

    <context id="flags" style-ref="flag">
      <match>(^|\s)(--?[A-Za-z][A-Za-z0-9-]*)\b</match>
      <include>
        <context sub-pattern="2" style-ref="flag"/>
      </include>
    </context>

    <context id="quantities" style-ref="number">
      <match>(?&lt;![A-Za-z0-9_])[+-]?(?:[0-9][0-9_]*(?:\.(?:[0-9][0-9_]*)?)?|\.[0-9][0-9_]*)(?:[eE][+-]?[0-9][0-9_]*)?(?:`[A-Za-z°μΩ1][A-Za-z0-9°μΩ^/*·-]*|°[A-Za-z0-9°μΩ^/*·-]*)</match>
    </context>

    <context id="unit-conversion-target">
      <match>(\bas)(\s+)(`[A-Za-z°μΩ1][A-Za-z0-9°μΩ^/*·-]*)</match>
      <include>
        <context sub-pattern="1" style-ref="keyword"/>
        <context sub-pattern="3" style-ref="number"/>
      </include>
    </context>

    <context id="numbers" style-ref="number">
      <match>\b(?:0[xX][0-9A-Fa-f][0-9A-Fa-f_]*|0[bB][01][01_]*|0[oO][0-7][0-7_]*|[0-9][0-9_]*(?:\.[0-9][0-9_]*)?(?:ns|us|ms|s|m|h|d|w|mo|y|b|kb|mb|gb|tb|pb)?|[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?:Z|[+-][0-9]{2}:[0-9]{2})?)?)\b</match>
    </context>

    <!-- Longest-first, and that ordering is load-bearing twice over: `...`
         before `..` or the spread operator is read as a range followed by a
         dot, and `**` before `*` or a power is read as two multiplications.

         The bare arithmetic operators were absent entirely, so `+`, `-`, `*`
         and `/` were scoped by nothing — 1,298 of them in the user's
         libraries. This context sits after `builtins`, `flags` and `numbers`
         in the main include list, so a hyphen inside `read-file` or a long
         flag has already been consumed by the time it is reached. -->
    <context id="operators" style-ref="operator">
      <match>=&gt;|\.\.\.|\.\.|\*\*=|//=|\?\?=|&amp;&amp;|\|{1,2}|!~|=~|not-in|!=|&gt;=|&lt;=|==|&gt;&gt;|&lt;&lt;&lt;|\+=|-=|\*=|/=|%=|\*\*|//|\?\?|\?\.|[-+*/%&gt;&lt;]=?|=(?!=)|\?</match>
    </context>

    <!-- The `::` path operator (TOAST-0090): a name reached inside a type — enum
         member, union variant, static member, nested type. The counterpart of
         dotted member access, which reaches a member of a value. -->
    <context id="static-path">
      <match>\b(\%{identifier})(::)(\%{identifier})?</match>
      <include>
        <context sub-pattern="1" style-ref="type"/>
        <context sub-pattern="2" style-ref="operator"/>
        <context sub-pattern="3" style-ref="constant"/>
      </include>
    </context>

    <!-- The places a bare type name appears without a `:` or `->` in front of
         it, which is all `type-annotation` knew: after `new`, after a `cast`,
         and on the right of `is` and `as`. `%{type-name}` already spans dots
         and angle brackets, so `new list&lt;ToastLib.Math.Point2D&lt;double&gt;&gt;()`
         is one name rather than five unscoped pieces.

         A lookbehind rather than a capture, so `new` keeps the keyword colour
         and `cast` keeps the builtin one instead of both being restyled here.
         Each alternative is a fixed width, which is what a lookbehind requires.

         Included before `qualified-segment`: both start at the same character
         for a dotted name, and GtkSourceView breaks that tie by include order.
    -->
    <!-- `read-buffer byte $pixel` — the first argument of the native
         memory builtins is a type, not a bareword, 55 times in the user's
         libraries. A lookbehind rather than a capture, so each command keeps
         the builtin colour the command rules already gave it. -->
    <context id="buffer-type-argument">
      <match>(?&lt;=\bnative-alloc |\bread-buffer |\bwrite-buffer |\bnative-read |\bnative-write |\bsize-of |\bnative-sizeof |\boffset-of |\bnative-offsetof )(\%{type-name})</match>
      <include>
        <context sub-pattern="1" style-ref="type"/>
      </include>
    </context>

    <context id="type-position">
      <match>(?&lt;=\bnew |\bis |\bas |\bcast )(\%{type-name})</match>
      <include>
        <context sub-pattern="1" style-ref="type"/>
      </include>
    </context>

    <!-- A command reached through a dotted path: `ToastLib.Tests.CheckNear $r`.
         The qualifier is a namespace and the final name is the command, so the
         two are styled differently.

         It has to be included *before* `qualified-segment`, not after. Both
         start at the same character, GtkSourceView breaks that tie by include
         order, and the segment rule would otherwise take `ToastLib` alone and
         leave the command it qualifies unstyled — which is what happened to
         every call in the test suite. -->
    <context id="qualified-command">
      <match>(?:^|(?&lt;=[\|;\{\(])(?&lt;!\{\|)|(?&lt;=\s=))\s*\%{not-keyword}((?:\%{identifier}\.)+)(\%{command-name})(?=\s|$|\()</match>
      <include>
        <context sub-pattern="1" style-ref="type"/>
        <context sub-pattern="2" style-ref="function"/>
      </include>
    </context>

    <!-- A segment of a dotted qualified name: the `ToastLib`, `Math` and
         `Geometry` of `ToastLib.Math.Geometry.Rectangle`, and the `System` of
         `System.Math.Round`. Every one of them was scoped by nothing, 1,900
         times in the user's libraries, while the `.` between them was already
         punctuation.

         Only a segment that is *followed* by a dot is claimed, so the final
         name in the chain is left to the contexts that know whether it is a
         call. A variable is unaffected: `variable` is included earlier and
         consumes the `$` with its name, so the `this` of `$this.Name` is never
         offered here. -->
    <context id="qualified-segment">
      <match>\b(\%{identifier})(?=\.)</match>
      <include>
        <context sub-pattern="1" style-ref="type"/>
      </include>
    </context>

    <!-- The name on the *right* of a dot, which `qualified-segment` beside this
         deliberately leaves alone: it claims only a segment with a dot after it,
         so the last name in every chain was scoped by nothing. That is the
         `Drawing` of `using System.Drawing`, the `GeometryEpsilon` of
         `ToastLib.Math.GeometryEpsilon`, and the second and later calls of
         `$body.Replace(…).Replace(…)` — `variable` consumes `$body.Replace`
         whole, and the chain continues past a closing paren it cannot span.

         Included after `qualified-segment`, which starts at the same character
         for a mid-chain name: GtkSourceView breaks that tie by include order,
         so a name with a dot after it stays a type and only the final one
         becomes a member. -->
    <!-- `extends Error`, `uses Polygonal, Shape2D, Enclosing, Transformable`.
         A region rather than a match, because the clause names a *list* and one
         regex can take only the first of it — every base type and trait in the
         corpus was uncoloured.

         The end declines `where`, `{`, and another clause keyword, because all
         three appear on one line: `fulfills IPoint<T> uses Componentwise where
         T: Numeric`. `end-at-line-end` is the backstop, so a clause that meets
         none of them cannot run away down the file.

         Included before `keywords`, which matches `extends` at the same
         character and would otherwise win the tie and leave the region shut. -->
    <context id="inheritance-clause" end-at-line-end="true">
      <start>\b(extends|fulfills|implements|uses)\b</start>
      <end>(?=\{|\b(?:where|extends|fulfills|implements|uses)\b)</end>
      <include>
        <context sub-pattern="1" where="start" style-ref="keyword"/>
        <!-- A base constructor takes arguments: `extends Error($message)`. -->
        <context ref="interpolated-string"/>
        <context ref="double-quoted-string"/>
        <context ref="single-quoted-string"/>
        <context ref="variable"/>
        <context style-ref="type">
          <match>[A-Za-z_][A-Za-z0-9_.-]*(?:&lt;[^&lt;&gt;]*&gt;)?</match>
        </context>
        <context ref="punctuation"/>
      </include>
    </context>

    <context id="member-access">
      <match>(?&lt;=\.)(\%{identifier})\b</match>
      <include>
        <context sub-pattern="1" style-ref="variable"/>
      </include>
    </context>

    <context id="static-path-segment">
      <match>(::)(\%{identifier})?</match>
      <include>
        <context sub-pattern="1" style-ref="operator"/>
        <context sub-pattern="2" style-ref="constant"/>
      </include>
    </context>

    <context id="collection-delimiters" style-ref="punctuation">
      <match>\{[|:%]|[|:%]\}</match>
    </context>

    <context id="punctuation" style-ref="punctuation">
      <match>[\{\}\[\]\(\),.;:]</match>
    </context>

    <context id="command-position">
      <!-- The `\s*` belongs outside the alternation. Inside it, only the
           `| ; {` branch allowed leading space and `^` demanded column zero, so
           a user-defined command on an indented line — which is most of them —
           matched nothing and was styled as nothing. Builtins hid the bug:
           their context is a keyword list that matches anywhere, so `writeline`
           looked right while `CheckNear` beside it did not. -->
      <match>(?:^|(?&lt;=[\|;\{\(])(?&lt;!\{\|)|(?&lt;=\s=))\s*\%{not-keyword}(\%{command-name})(?=\s|$|\()</match>
      <include>
        <context sub-pattern="1" style-ref="function"/>
      </include>
    </context>

    <context id="tosh" class="no-spell-check">
      <include>
        <context ref="def:shebang"/>
        <context ref="block-comment"/>
        <context ref="doc-comment"/>
        <context ref="line-comment"/>
        <context ref="interpolated-string"/>
        <context ref="ansi-c-string"/>
        <context ref="double-quoted-string"/>
        <context ref="single-quoted-string"/>
        <context ref="command-substitution"/>
        <context ref="operator-signature"/>
        <context ref="function-signature"/>
        <context ref="anonymous-signature"/>
        <context ref="declaration-signature"/>
        <context ref="function-definition"/>
        <context ref="subcommand-definition"/>
        <context ref="type-definition"/>
        <context ref="variable-declaration"/>
        <context ref="bare-require-path"/>
        <context ref="function-reference"/>
        <context ref="loop-variable"/>
        <context ref="catch-binding"/>
        <context ref="collection-key"/>
        <context ref="parameter-name"/>
        <context ref="type-annotation"/>
        <context ref="variable"/>
        <context ref="pipeline-variable"/>
        <context ref="constants"/>
        <context ref="unit-conversion-target"/>
        <context ref="static-path"/>
        <context ref="static-path-segment"/>
        <context ref="buffer-type-argument"/>
        <context ref="type-position"/>
        <context ref="qualified-command"/>
        <context ref="qualified-segment"/>
        <context ref="member-access"/>
        <context ref="inheritance-clause"/>
        <context ref="modifiers"/>
        <context ref="keywords"/>
        <context ref="builtins"/>
        <context ref="flags"/>
        <context ref="quantities"/>
        <context ref="numbers"/>
        <context ref="collection-delimiters"/>
        <context ref="operators"/>
        <context ref="punctuation"/>
        <context ref="command-position"/>
      </include>
    </context>
  </definitions>
