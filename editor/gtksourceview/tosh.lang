<?xml version="1.0" encoding="UTF-8"?>
<language id="tosh" name="TōSh" version="2.0" _section="Script">
  <metadata>
    <property name="mimetypes">text/x-tosh</property>
    <property name="globs">*.tosh</property>
    <property name="line-comment-start">#</property>
  </metadata>

  <styles>
    <style id="comment"           name="Comment"             map-to="def:comment"/>
    <style id="doc-comment"       name="Documentation"       map-to="def:doc-comment"/>
    <style id="shebang"           name="Shebang"             map-to="def:shebang"/>
    <style id="string"            name="String"              map-to="def:string"/>
    <style id="escape"            name="Escape"              map-to="def:special-char"/>
    <style id="interpolation"     name="Interpolation"       map-to="def:preprocessor"/>
    <style id="keyword"           name="Keyword"             map-to="def:keyword"/>
    <style id="modifier"          name="Modifier"            map-to="def:keyword"/>
    <style id="function"          name="Function"            map-to="def:function"/>
    <style id="type"              name="Type"                map-to="def:type"/>
    <style id="builtin"           name="Built-in Command"    map-to="def:builtin"/>
    <style id="variable"          name="Variable"            map-to="def:identifier"/>
    <style id="pipeline-variable" name="Pipeline Variable"   map-to="def:identifier"/>
    <style id="constant"          name="Constant"            map-to="def:special-constant"/>
    <style id="number"            name="Number"              map-to="def:number"/>
    <style id="operator"          name="Operator"            map-to="def:operator"/>
    <style id="flag"              name="Flag"                map-to="def:preprocessor"/>
    <style id="punctuation"       name="Punctuation"         map-to="def:operator"/>
  </styles>

  <definitions>
    <define-regex id="identifier">[A-Za-z_][A-Za-z0-9_]*</define-regex>
    <define-regex id="command-name">[A-Za-z_][A-Za-z0-9_-]*</define-regex>
    <define-regex id="type-name">[A-Za-z_][A-Za-z0-9_.&lt;&gt;?]*</define-regex>

    <context id="doc-comment" style-ref="doc-comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>##</start>
      <include>
        <context style-ref="type">
          <match>@(?:param|returns|example|see)\b</match>
        </context>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>#</start>
      <include>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="interpolation-braces" style-ref="interpolation">
      <start>\$\{|\{</start>
      <end>\}</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="interpolation"/>
        <context sub-pattern="0" where="end" style-ref="interpolation"/>
        <context ref="tosh"/>
      </include>
    </context>

    <context id="interpolated-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>\$"</start>
      <end>"</end>
      <include>
        <context style-ref="escape">
          <match>\\(?:[\\&quot;'nrtabefv0]|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{1,4})|\{\{|\}\}</match>
        </context>
        <context ref="variable"/>
        <context ref="interpolation-braces"/>
      </include>
    </context>

    <context id="ansi-c-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>\$'</start>
      <end>'</end>
      <include>
        <context style-ref="escape">
          <match>\\(?:[\\&quot;'abefnrtv0]|[eE]|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{1,4}|0[0-7]{1,3})</match>
        </context>
      </include>
    </context>

    <context id="double-quoted-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>"</start>
      <end>"</end>
      <include>
        <context style-ref="escape">
          <match>\\(?:[\\&quot;'nrtabefv0]|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{1,4})</match>
        </context>
      </include>
    </context>

    <context id="single-quoted-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>'</start>
      <end>'</end>
    </context>

    <context id="command-substitution" style-ref="interpolation">
      <start>\$\(|&lt;\(</start>
      <end>\)</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="interpolation"/>
        <context sub-pattern="0" where="end" style-ref="interpolation"/>
        <context ref="tosh"/>
      </include>
    </context>

    <context id="function-definition">
      <match extended="true">
        \b(?:(shy|global|export)\s+)?(func)\s+(\%{command-name})\s*(?=\(|=&gt;)
      </match>
      <include>
        <context sub-pattern="1" style-ref="modifier"/>
        <context sub-pattern="2" style-ref="keyword"/>
        <context sub-pattern="3" style-ref="function"/>
      </include>
    </context>

    <context id="type-definition">
      <match extended="true">
        \b(?:(shy|global|export)\s+)?(class|module|enum|record|struct|interface|trait|union)\s+(\%{command-name})\b
      </match>
      <include>
        <context sub-pattern="1" style-ref="modifier"/>
        <context sub-pattern="2" style-ref="keyword"/>
        <context sub-pattern="3" style-ref="type"/>
      </include>
    </context>

    <context id="variable-declaration">
      <match extended="true">
        \b(?:(shy|global|export)\s+)?(var|alloc)\s+(\%{identifier})\b
      </match>
      <include>
        <context sub-pattern="1" style-ref="modifier"/>
        <context sub-pattern="2" style-ref="keyword"/>
        <context sub-pattern="3" style-ref="variable"/>
      </include>
    </context>

    <context id="type-annotation">
      <match>(:|-&gt;)\s*(\%{type-name})</match>
      <include>
        <context sub-pattern="1" style-ref="punctuation"/>
        <context sub-pattern="2" style-ref="type"/>
      </include>
    </context>

    <context id="variable" style-ref="variable">
      <match>\$\%{identifier}(?:\.\%{identifier})*</match>
    </context>

    <context id="pipeline-variable" style-ref="pipeline-variable">
      <match>\b_(?:\.\%{identifier}(?:\.\%{identifier})*)?\b</match>
    </context>

    <context id="constants" style-ref="constant">
      <keyword>true</keyword>
      <keyword>false</keyword>
      <keyword>null</keyword>
    </context>

    <context id="keywords" style-ref="keyword">
      <keyword>if</keyword>
      <keyword>else</keyword>
      <keyword>for</keyword>
      <keyword>in</keyword>
      <keyword>while</keyword>
      <keyword>until</keyword>
      <keyword>break</keyword>
      <keyword>continue</keyword>
      <keyword>return</keyword>
      <keyword>throw</keyword>
      <keyword>try</keyword>
      <keyword>catch</keyword>
      <keyword>finally</keyword>
      <keyword>switch</keyword>
      <keyword>case</keyword>
      <keyword>default</keyword>
      <keyword>match</keyword>
      <keyword>defer</keyword>
      <keyword>yield</keyword>
      <keyword>unless</keyword>
      <keyword>func</keyword>
      <keyword>var</keyword>
      <keyword>const</keyword>
      <keyword>alloc</keyword>
      <keyword>class</keyword>
      <keyword>module</keyword>
      <keyword>enum</keyword>
      <keyword>record</keyword>
      <keyword>struct</keyword>
      <keyword>interface</keyword>
      <keyword>trait</keyword>
      <keyword>union</keyword>
      <keyword>rune</keyword>
      <keyword>event</keyword>
      <keyword>prop</keyword>
      <keyword>using</keyword>
      <keyword>require</keyword>
      <keyword>native</keyword>
      <keyword>bind</keyword>
      <keyword>from</keyword>
      <keyword>as</keyword>
      <keyword>out</keyword>
      <keyword>ref</keyword>
      <keyword>callconv</keyword>
      <keyword>global</keyword>
      <keyword>export</keyword>
      <keyword>new</keyword>
      <keyword>nameof</keyword>
      <keyword>name-of</keyword>
      <keyword>let</keyword>
      <keyword>pick</keyword>
      <keyword>quote</keyword>
      <keyword>and</keyword>
      <keyword>or</keyword>
      <keyword>not</keyword>
      <keyword>is</keyword>
      <keyword>is-not</keyword>
      <keyword>is-in</keyword>
      <keyword>is-not-in</keyword>
      <keyword>not-in</keyword>
      <keyword>contains</keyword>
      <keyword>starts-with</keyword>
      <keyword>ends-with</keyword>
      <keyword>handles</keyword>
      <keyword>when</keyword>
      <keyword>priority</keyword>
      <keyword>once</keyword>
      <keyword>where</keyword>
      <keyword>extends</keyword>
      <keyword>fulfills</keyword>
      <keyword>implements</keyword>
      <keyword>uses</keyword>
    </context>

    <context id="modifiers" style-ref="modifier">
      <keyword>shy</keyword>
      <keyword>private</keyword>
      <keyword>proud</keyword>
      <keyword>public</keyword>
      <keyword>guarded</keyword>
      <keyword>protected</keyword>
      <keyword>local</keyword>
      <keyword>sealed</keyword>
      <keyword>hollow</keyword>
      <keyword>abstract</keyword>
      <keyword>partial</keyword>
      <keyword>overrule</keyword>
      <keyword>override</keyword>
      <keyword>static</keyword>
      <keyword>shared</keyword>
      <keyword>hermit</keyword>
      <keyword>strict</keyword>
      <keyword>fluid</keyword>
      <keyword>leaky</keyword>
      <keyword>lazy</keyword>
      <keyword>fixed</keyword>
      <keyword>readonly</keyword>
      <keyword>vital</keyword>
      <keyword>required</keyword>
      <keyword>fading</keyword>
      <keyword>obsolete</keyword>
      <keyword>raw</keyword>
    </context>

    <context id="builtins" style-ref="builtin">
      <keyword>append-file</keyword>
      <keyword>apropos</keyword>
      <keyword>assert</keyword>
      <keyword>basename</keyword>
      <keyword>bg</keyword>
      <keyword>call</keyword>
      <keyword>cat</keyword>
      <keyword>cd</keyword>
      <keyword>chmod</keyword>
      <keyword>chown</keyword>
      <keyword>clear</keyword>
      <keyword>collect</keyword>
      <keyword>config</keyword>
      <keyword>constructors</keyword>
      <keyword>count</keyword>
      <keyword>cp</keyword>
      <keyword>date</keyword>
      <keyword>describe-type</keyword>
      <keyword>df</keyword>
      <keyword>dirname</keyword>
      <keyword>distinct</keyword>
      <keyword>du</keyword>
      <keyword>each</keyword>
      <keyword>echo</keyword>
      <keyword>env</keyword>
      <keyword>exec</keyword>
      <keyword>exists</keyword>
      <keyword>exit</keyword>
      <keyword>export</keyword>
      <keyword>fg</keyword>
      <keyword>filter</keyword>
      <keyword>find</keyword>
      <keyword>findmnt</keyword>
      <keyword>first</keyword>
      <keyword>flat-map</keyword>
      <keyword>flatten</keyword>
      <keyword>free</keyword>
      <keyword>from</keyword>
      <keyword>get</keyword>
      <keyword>get-methods</keyword>
      <keyword>glob</keyword>
      <keyword>grep</keyword>
      <keyword>group-by</keyword>
      <keyword>head</keyword>
      <keyword>help</keyword>
      <keyword>history</keyword>
      <keyword>hostname</keyword>
      <keyword>http</keyword>
      <keyword>id</keyword>
      <keyword>ignore</keyword>
      <keyword>inspect</keyword>
      <keyword>ip</keyword>
      <keyword>is-dir</keyword>
      <keyword>is-file</keyword>
      <keyword>is-link</keyword>
      <keyword>jobs</keyword>
      <keyword>join-lines</keyword>
      <keyword>journalctl</keyword>
      <keyword>kill</keyword>
      <keyword>last</keyword>
      <keyword>lines</keyword>
      <keyword>ln</keyword>
      <keyword>ls</keyword>
      <keyword>lsblk</keyword>
      <keyword>lscpu</keyword>
      <keyword>map</keyword>
      <keyword>max</keyword>
      <keyword>members</keyword>
      <keyword>methods</keyword>
      <keyword>min</keyword>
      <keyword>mkdir</keyword>
      <keyword>mv</keyword>
      <keyword>open-file</keyword>
      <keyword>parse</keyword>
      <keyword>partition</keyword>
      <keyword>ping</keyword>
      <keyword>ps</keyword>
      <keyword>pwd</keyword>
      <keyword>read-file</keyword>
      <keyword>read-lines</keyword>
      <keyword>readlink</keyword>
      <keyword>realpath</keyword>
      <keyword>reduce</keyword>
      <keyword>rename</keyword>
      <keyword>replace</keyword>
      <keyword>reverse</keyword>
      <keyword>rm</keyword>
      <keyword>scan</keyword>
      <keyword>signal</keyword>
      <keyword>sleep</keyword>
      <keyword>sort</keyword>
      <keyword>split</keyword>
      <keyword>stat</keyword>
      <keyword>sum</keyword>
      <keyword>systemctl</keyword>
      <keyword>tail</keyword>
      <keyword>tee</keyword>
      <keyword>time</keyword>
      <keyword>timespan</keyword>
      <keyword>to</keyword>
      <keyword>touch</keyword>
      <keyword>tr</keyword>
      <keyword>tree</keyword>
      <keyword>type-of</keyword>
      <keyword>types</keyword>
      <keyword>uname</keyword>
      <keyword>uniq</keyword>
      <keyword>unset</keyword>
      <keyword>uptime</keyword>
      <keyword>vars</keyword>
      <keyword>view</keyword>
      <keyword>wait-for</keyword>
      <keyword>wc</keyword>
      <keyword>where</keyword>
      <keyword>which</keyword>
      <keyword>whoami</keyword>
      <keyword>write-file</keyword>
      <keyword>writeline</keyword>
      <keyword>xargs</keyword>
      <keyword>zip</keyword>
    </context>

    <context id="flags" style-ref="flag">
      <match>(^|\s)(--?[A-Za-z][A-Za-z0-9-]*)\b</match>
      <include>
        <context sub-pattern="2" style-ref="flag"/>
      </include>
    </context>

    <context id="numbers" style-ref="number">
      <match>\b(?:0[xX][0-9A-Fa-f][0-9A-Fa-f_]*|0[bB][01][01_]*|0[oO][0-7][0-7_]*|[0-9][0-9_]*(?:\.[0-9][0-9_]*)?(?:ns|us|ms|s|m|h|d|w|mo|y|b|kb|mb|gb|tb|pb)?|[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?:Z|[+-][0-9]{2}:[0-9]{2})?)?)\b</match>
    </context>

    <context id="operators" style-ref="operator">
      <match>=&gt;|\.\.|\.\.\.|\|{1,2}|!~|=~|not-in|!=|&gt;=|&lt;=|==|&gt;&gt;|&lt;&lt;&lt;|\+=|-=|\*=|/=|%=|[%&gt;&lt;]=?|=(?!=)|\?</match>
    </context>

    <context id="collection-delimiters" style-ref="punctuation">
      <match>\{[|:%]|[|:%]\}</match>
    </context>

    <context id="punctuation" style-ref="punctuation">
      <match>[\{\}\[\]\(\),.;:]</match>
    </context>

    <context id="command-position">
      <match>(^|[\|;\{]\s*)(\%{command-name})(?=\s|$|\()</match>
      <include>
        <context sub-pattern="2" style-ref="function"/>
      </include>
    </context>

    <context id="tosh" class="no-spell-check">
      <include>
        <context ref="def:shebang"/>
        <context ref="doc-comment"/>
        <context ref="line-comment"/>
        <context ref="interpolated-string"/>
        <context ref="ansi-c-string"/>
        <context ref="double-quoted-string"/>
        <context ref="single-quoted-string"/>
        <context ref="command-substitution"/>
        <context ref="function-definition"/>
        <context ref="type-definition"/>
        <context ref="variable-declaration"/>
        <context ref="type-annotation"/>
        <context ref="variable"/>
        <context ref="pipeline-variable"/>
        <context ref="constants"/>
        <context ref="modifiers"/>
        <context ref="keywords"/>
        <context ref="builtins"/>
        <context ref="flags"/>
        <context ref="numbers"/>
        <context ref="collection-delimiters"/>
        <context ref="operators"/>
        <context ref="punctuation"/>
        <context ref="command-position"/>
      </include>
    </context>
  </definitions>
</language>
