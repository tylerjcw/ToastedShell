<?xml version="1.0" encoding="UTF-8"?>
<language id="tosh" name="TōSh" version="2.0" _section="Script">
  <metadata>
    <property name="mimetypes">text/x-tosh</property>
    <property name="globs">*.tosh</property>
    <!-- Trailing space is required: a lone '#' glued to a word is a bareword
         character, not a comment opener, so toggling must emit "# ". -->
    <property name="line-comment-start"># </property>
  </metadata>

  <styles>
    <style id="comment"           name="Comment"             map-to="def:comment"/>
    <style id="doc-comment"       name="Documentation"       map-to="def:doc-comment"/>
    <style id="shebang"           name="Shebang"             map-to="def:shebang"/>
    <style id="string"            name="String"              map-to="def:string"/>
    <style id="escape"            name="Escape"              map-to="def:special-char"/>
    <style id="interpolation"     name="Interpolation"       map-to="def:preprocessor"/>
    <style id="keyword"           name="Keyword"             map-to="def:keyword"/>
    <style id="modifier"          name="Modifier"            map-to="def:keyword"/>
    <style id="function"          name="Function"            map-to="def:function"/>
    <style id="type"              name="Type"                map-to="def:type"/>
    <style id="builtin"           name="Built-in Command"    map-to="def:builtin"/>
    <style id="variable"          name="Variable"            map-to="def:identifier"/>
    <style id="pipeline-variable" name="Pipeline Variable"   map-to="def:identifier"/>
    <style id="constant"          name="Constant"            map-to="def:special-constant"/>
    <style id="number"            name="Number"              map-to="def:number"/>
    <style id="operator"          name="Operator"            map-to="def:operator"/>
    <style id="flag"              name="Flag"                map-to="def:preprocessor"/>
    <style id="punctuation"       name="Punctuation"         map-to="def:operator"/>
  </styles>

  <!-- `-` counts as a word character when matching the keyword lists below.
       Without it `type` matched inside `type-of` and `read` inside
       `read-buffer`, leaving the tail of every hyphenated command unscoped and
       its hyphen coloured as arithmetic. -->
  <keyword-char-class>[A-Za-z0-9_-]</keyword-char-class>

  <definitions>
    <define-regex id="identifier">[A-Za-z_][A-Za-z0-9_]*</define-regex>
    <define-regex id="command-name">[A-Za-z_][A-Za-z0-9_-]*</define-regex>
    <!-- Full modifier run that may precede a declaration keyword. Kept in step
         with MODIFIERS in the VS Code grammar generator. -->
    <define-regex id="modifiers">shy|private|proud|public|guarded|protected|local|global|export|sealed|hollow|abstract|partial|overrule|override|static|shared|hermit|strict|fluid|leaky|lazy|fixed|readonly|vital|required|fading|obsolete|raw|eager|hidden</define-regex>
    <!-- The words a command position must decline. Without it, widening
         `command-position` to allow indentation made it start at the line
         beginning, which is earlier than `variable-declaration` starts at
         its keyword — and GtkSourceView resolves a tie by earliest start,
         not by include order. So an indented `var x = 1` styled `var` as a
         function call and left `x` bare.

         Longest-first, so `is-in` is declined whole rather than as `is`.
         Generated from the keyword and modifier lists below; keep in step
         with them. -->
    <define-regex id="not-keyword">(?!(?:starts-with|implements|subcommand|ends-with|interface|is-not-in|protected|abstract|callback|callconv|contains|continue|fulfills|obsolete|override|overrule|priority|readonly|required|default|extends|finally|guarded|handles|name-of|partial|private|require|coerce|export|extend|fading|global|hermit|hollow|is-not|module|nameof|native|not-in|public|record|return|sealed|shared|static|strict|struct|subcmd|switch|unless|alloc|break|catch|class|const|defer|event|false|fixed|flags|fluid|is-in|leaky|local|match|proud|quote|throw|trait|union|until|using|vital|where|while|yield|band|bind|bnot|bxor|case|else|enum|flag|from|func|lazy|null|once|pick|prop|rune|true|type|uses|when|and|arg|bor|for|get|has|let|new|not|out|raw|ref|set|shl|shr|shy|try|var|as|if|in|is|or|_)\b(?!-))</define-regex>
    <define-regex id="type-name">[A-Za-z_][A-Za-z0-9_.&lt;&gt;?]*</define-regex>

    <!-- ##{ ... }## block comment. Must precede the doc-comment context,
         which would otherwise claim the opening ## and stop at the line end. -->
    <context id="block-comment" style-ref="comment" class="comment" class-disabled="no-spell-check">
      <start>##\{</start>
      <end>\}##</end>
      <include>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="doc-comment" style-ref="doc-comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>##</start>
      <include>
        <context style-ref="type">
          <match>@(?:summary|remarks|param=|typeparam=|returns|value|example|deprecated|seealso|see|since|exception|throws|para)\b</match>
        </context>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <!-- A lone '#' opens a comment only when it stands alone as a word: at the
         start of a word, and followed by whitespace or the end of the line.
         Otherwise it is a bareword character, so #ff0000, issue#42 and C# are
         left unhighlighted as ordinary text. -->
    <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>(?&lt;![^\s])#(?=[\s]|$)</start>
      <include>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="interpolation-braces" style-ref="interpolation">
      <start>\$\{|\{</start>
      <end>\}</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="interpolation"/>
        <context sub-pattern="0" where="end" style-ref="interpolation"/>
        <context ref="tosh"/>
      </include>
    </context>

    <context id="interpolated-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>\$"</start>
      <end>"</end>
      <include>
        <context style-ref="escape">
          <match>\\(?:[\\&quot;'nrtabefv0]|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{1,4})|\{\{|\}\}</match>
        </context>
        <context ref="variable"/>
        <context ref="interpolation-braces"/>
      </include>
    </context>

    <context id="ansi-c-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>\$'</start>
      <end>'</end>
      <include>
        <context style-ref="escape">
          <match>\\(?:[\\&quot;'abefnrtv0]|[eE]|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{1,4}|0[0-7]{1,3})</match>
        </context>
      </include>
    </context>

    <context id="double-quoted-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>"</start>
      <end>"</end>
      <include>
        <context style-ref="escape">
          <match>\\(?:[\\&quot;'nrtabefv0]|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{1,4})</match>
        </context>
      </include>
    </context>

    <context id="single-quoted-string" style-ref="string" class="string" class-disabled="no-spell-check">
      <start>'</start>
      <end>'</end>
    </context>

    <context id="command-substitution" style-ref="interpolation">
      <start>\$\(|&lt;\(</start>
      <end>\)</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="interpolation"/>
        <context sub-pattern="0" where="end" style-ref="interpolation"/>
        <context ref="tosh"/>
      </include>
    </context>

    <!-- ── Parameter lists, as regions ──────────────────────────────────────

         Untyped parameters and loop variables were the whole of what this
         grammar still left uncoloured: `func f(other)`, `struct Snapshot(root,
         files, options, now)`, `func (win) { … }`. A regex cannot reach them,
         because from a regex alone `(o)` in a signature and `(greet)` in an
         expression are the same shape — which is exactly what `parameter-name`
         says about itself, and why it demands a colon it can key on.

         So the declarations open a region at their `(` and close it at the
         matching `)`, and inside one every bareword is a parameter. The region
         spans lines on purpose: a `record` with one field per line is the
         common shape in the user's libraries.

         `nested-parens` is what makes "matching" true. A parameter whose own
         type is a function — `cb: func(int) -> int` — would otherwise close the
         signature at its inner paren and leak parameter colouring into the
         body. The comment and string contexts are included for the same
         reason: a parenthesis inside either must not count.
    -->
    <context id="signature-parameter">
      <match>(?:^|(?&lt;=\()|(?&lt;=,)|(?&lt;=\bout\s)|(?&lt;=\bref\s))(\s*)(\%{not-keyword}\%{command-name}\??)</match>
      <include>
        <context sub-pattern="2" style-ref="variable"/>
      </include>
    </context>

    <context id="nested-parens">
      <start>\(</start>
      <end>\)</end>
      <include>
        <context sub-pattern="0" where="start" style-ref="punctuation"/>
        <context sub-pattern="0" where="end" style-ref="punctuation"/>
        <context ref="signature-body"/>
      </include>
    </context>

    <context id="signature-body">
      <include>
        <context ref="block-comment"/>
        <context ref="doc-comment"/>
        <context ref="line-comment"/>
        <context ref="interpolated-string"/>
        <context ref="ansi-c-string"/>
        <context ref="double-quoted-string"/>
        <context ref="single-quoted-string"/>
        <context ref="nested-parens"/>
        <context ref="type-annotation"/>
        <context ref="parameter-name"/>
        <context ref="signature-parameter"/>
        <context ref="variable"/>
        <context ref="constants"/>
        <context ref="modifiers"/>
        <context ref="keywords"/>
        <context ref="quantities"/>
        <context ref="numbers"/>
        <context ref="collection-delimiters"/>
        <context ref="operators"/>
        <context ref="signature-punctuation"/>
      </include>
    </context>

    <!-- The signature's own punctuation, which is the general rule minus the
         parentheses. GtkSourceView offers a position to the contained contexts
         before it tries the region's `end`, so the general rule — which matches
         `)` — consumed the closing paren and the signature never closed. It ran
         to the end of the file, and every declaration below it was styled as if
         it were a parameter list.

         `(` is left out for the same reason in reverse: it belongs to
         `nested-parens`, which is what makes `cb: func(int) -> int` work. -->
    <context id="signature-punctuation" style-ref="punctuation">
      <match>[\{\}\[\],.;:]</match>
    </context>

    <!-- Operator overloads: func +(o), func ==(o), func [](i). The name is
         punctuation, so function-definition's identifier pattern never matches
         these. `[]` is the indexer, which the alternation used to omit. -->
    <context id="operator-signature">
      <start extended="true">
        \b(func)\s*(\[\]|\*\*|==|!=|&lt;=|&gt;=|=~|!~|//|\+|-|\*|/|%|&lt;|&gt;)\s*(\()
      </start>
      <end>\)</end>
      <include>
        <context sub-pattern="1" where="start" style-ref="keyword"/>
        <context sub-pattern="2" where="start" style-ref="function"/>
        <context sub-pattern="3" where="start" style-ref="punctuation"/>
        <context sub-pattern="0" where="end" style-ref="punctuation"/>
        <context ref="signature-body"/>
      </include>
    </context>

    <context id="function-signature">
      <start extended="true">
        \b(func)\s+(\%{command-name})\s*((?:&lt;[^&lt;&gt;()]*&gt;)?)\s*(\()
      </start>
      <end>\)</end>
      <include>
        <context sub-pattern="1" where="start" style-ref="keyword"/>
        <context sub-pattern="2" where="start" style-ref="function"/>
        <context sub-pattern="3" where="start" style-ref="type"/>
        <context sub-pattern="4" where="start" style-ref="punctuation"/>
        <context sub-pattern="0" where="end" style-ref="punctuation"/>
        <context ref="signature-body"/>
      </include>
    </context>

    <!-- A lambda: `func (win) { … }`, which is how every GTK and SDL callback in
         the user's libraries is written. The named form wants an identifier
         after the keyword and matched none of them. -->
    <context id="anonymous-signature">
      <start>\b(func)\s*(\()</start>
      <end>\)</end>
      <include>
        <context sub-pattern="1" where="start" style-ref="keyword"/>
        <context sub-pattern="2" where="start" style-ref="punctuation"/>
        <context sub-pattern="0" where="end" style-ref="punctuation"/>
        <context ref="signature-body"/>
      </include>
    </context>

    <!-- A primary constructor is a parameter list too: `struct WorkspaceSnapshot
         (root, files, options, now)`, `raw callback Comparator(a: ptr) -> int`. -->
    <context id="declaration-signature">
      <start extended="true">
        \b(class|module|enum|record|struct|interface|trait|union|rune|event|type|callback)
        \s+(\%{command-name})\s*((?:&lt;[^&lt;&gt;()]*&gt;)?)\s*(\()
      </start>
      <end>\)</end>
      <include>
        <context sub-pattern="1" where="start" style-ref="keyword"/>
        <context sub-pattern="2" where="start" style-ref="type"/>
        <context sub-pattern="3" where="start" style-ref="type"/>
        <context sub-pattern="4" where="start" style-ref="punctuation"/>
        <context sub-pattern="0" where="end" style-ref="punctuation"/>
        <context ref="signature-body"/>
      </include>
    </context>

    <!-- The paren-less forms, after the regions above: `func f => 1`, a name at
         end of line, `enum Color`, `module Graphics`. -->
    <context id="function-definition">
      <match extended="true">
        \b(func)\s+(\%{command-name})\s*(?=&lt;|=&gt;|$)
      </match>
      <include>
        <context sub-pattern="1" style-ref="keyword"/>
        <context sub-pattern="2" style-ref="function"/>
      </include>
    </context>

    <context id="subcommand-definition">
      <match extended="true">
        \b(?:(eager|hidden|hollow|vital)\s+)*(subcommand|subcmd)\s+(\%{command-name})\b
      </match>
      <include>
        <context sub-pattern="1" style-ref="modifier"/>
        <context sub-pattern="2" style-ref="keyword"/>
        <context sub-pattern="3" style-ref="function"/>
      </include>
    </context>

    <context id="type-definition">
      <match extended="true">
        \b(class|module|enum|record|struct|interface|trait|union|rune|event|type|callback)\s+(\%{command-name})\b
      </match>
      <include>
        <context sub-pattern="1" style-ref="keyword"/>
        <context sub-pattern="2" style-ref="type"/>
      </include>
    </context>

    <context id="variable-declaration">
      <match extended="true">
        \b(var|const|alloc|prop)\s+(\%{identifier})\b
      </match>
      <include>
        <context sub-pattern="1" style-ref="keyword"/>
        <context sub-pattern="2" style-ref="variable"/>
      </include>
    </context>

    <!-- The name on the left of a `:` — a parameter that declares its type, and
         a record or dict key, which have the same shape. `type-annotation`
         beside this styles what is on the *right* of the colon and left every
         name in front of one uncoloured: in a `bind native` block, the whole
         signature was types and punctuation with the parameter names bare.

         The lookahead declines `::`, which is the static-path operator, and
         `:=`. Untyped parameters are not reached — `func f(other)` has no colon
         to key on, and telling that from a call needs a signature region rather
         than a wider regex, which is deliberately left for that work. -->
    <!-- `catch (e)` binds a variable. `parameter-name` cannot claim it — there
         is no colon — and the general identifier rules do not reach inside the
         parentheses, so every error handler had its binding uncoloured. -->
    <!-- `require ./Graphics/Sdl.tosh` takes an unquoted path. It is a literal
         in every sense the quoted form is, and the `.tosh` at the end of it was
         the largest unscoped token left in the corpus. -->
    <context id="bare-require-path">
      <match>(?&lt;=\brequire )([.~/][^\s&quot;&apos;]*)</match>
      <include>
        <context sub-pattern="1" style-ref="string"/>
      </include>
    </context>

    <!-- `&greet`, `&$this.OnSave`, and the trailing `&` that backgrounds a
         pipeline. The grammar had no rule for `&` in any of its forms, so the
         operator was uncoloured in every handler the library passes.

         The name is optional: the parser requires it to be adjacent (a space
         makes the `&` a background operator instead), and after `&$this.OnSave`
         the variable rules already know what follows. The lookarounds keep the
         two halves of `&&` out of it, which the operator alternation above now
         claims as one token. -->
    <context id="function-reference">
      <match>(?&lt;![A-Za-z0-9_&amp;])(&amp;)(?!&amp;)(\%{command-name})?</match>
      <include>
        <context sub-pattern="1" style-ref="operator"/>
        <context sub-pattern="2" style-ref="function"/>
      </include>
    </context>

    <!-- `for p in $parts` binds a variable, and nothing claimed it: the
         parameter rule wants a following colon and the keyword list takes only
         the `for`. The same gap as `catch (e)`, and the same fix. -->
    <context id="loop-variable">
      <match>\b(for)\s+(\%{not-keyword}\%{command-name})(?=\s+in\b)</match>
      <include>
        <context sub-pattern="1" style-ref="keyword"/>
        <context sub-pattern="2" style-ref="variable"/>
      </include>
    </context>

    <context id="catch-binding">
      <match>\b(catch)\s*(\()\s*(\%{identifier})\s*(\))</match>
      <include>
        <context sub-pattern="1" style-ref="keyword"/>
        <context sub-pattern="2" style-ref="punctuation"/>
        <context sub-pattern="3" style-ref="variable"/>
        <context sub-pattern="4" style-ref="punctuation"/>
      </include>
    </context>

    <!-- A record, dict or named-argument key: the name on the left of a single
         `=`. Until the `{|` guard above, the first key in a literal was styled
         as a command call, which is how three keys of one kind ended up three
         colours; now they are all keys.

         A bare name cannot be assigned to in TōSh — an assignment target needs
         its `$`, and the `variable` context claims that earlier — so an
         identifier in front of a lone `=` is a key or a named argument. -->
    <context id="collection-key">
      <match>\b(\%{identifier})\s*(?==(?!=))</match>
      <include>
        <context sub-pattern="1" style-ref="variable"/>
      </include>
    </context>

    <context id="parameter-name">
      <match>\b(\%{identifier})\s*(?=:(?![:=]))</match>
      <include>
        <context sub-pattern="1" style-ref="variable"/>
      </include>
    </context>

    <context id="type-annotation">
      <match>(:|-&gt;)\s*(\%{type-name})</match>
      <include>
        <context sub-pattern="1" style-ref="punctuation"/>
        <context sub-pattern="2" style-ref="type"/>
      </include>
    </context>

    <context id="variable" style-ref="variable">
      <match>\$\%{identifier}(?:\.\%{identifier})*</match>
    </context>

    <context id="pipeline-variable" style-ref="pipeline-variable">
      <match>\b_(?:\.\%{identifier}(?:\.\%{identifier})*)?\b</match>
    </context>

    <context id="constants" style-ref="constant">
      <keyword>true</keyword>
      <keyword>false</keyword>
      <keyword>null</keyword>
    </context>

    <context id="keywords" style-ref="keyword">
      <keyword>if</keyword>
      <keyword>else</keyword>
      <keyword>for</keyword>
      <keyword>in</keyword>
      <keyword>while</keyword>
      <keyword>until</keyword>
      <keyword>break</keyword>
      <keyword>continue</keyword>
      <keyword>return</keyword>
      <keyword>throw</keyword>
      <keyword>try</keyword>
      <keyword>catch</keyword>
      <keyword>finally</keyword>
      <keyword>switch</keyword>
      <keyword>case</keyword>
      <keyword>default</keyword>
      <keyword>match</keyword>
      <keyword>defer</keyword>
      <keyword>yield</keyword>
      <keyword>unless</keyword>
      <keyword>func</keyword>
      <keyword>var</keyword>
      <keyword>const</keyword>
      <keyword>alloc</keyword>
      <keyword>class</keyword>
      <keyword>module</keyword>
      <keyword>enum</keyword>
      <keyword>record</keyword>
      <keyword>struct</keyword>
      <keyword>interface</keyword>
      <keyword>trait</keyword>
      <keyword>callback</keyword>
      <keyword>union</keyword>
      <keyword>rune</keyword>
      <keyword>event</keyword>
      <keyword>prop</keyword>
      <keyword>using</keyword>
      <keyword>require</keyword>
      <keyword>native</keyword>
      <keyword>bind</keyword>
      <keyword>from</keyword>
      <keyword>as</keyword>
      <keyword>out</keyword>
      <keyword>ref</keyword>
      <keyword>callconv</keyword>
      <keyword>global</keyword>
      <keyword>export</keyword>
      <keyword>new</keyword>
      <keyword>nameof</keyword>
      <keyword>name-of</keyword>
      <keyword>let</keyword>
      <keyword>pick</keyword>
      <keyword>quote</keyword>
      <keyword>get</keyword>
      <keyword>set</keyword>
      <keyword>type</keyword>
      <keyword>coerce</keyword>
      <keyword>subcommand</keyword>
      <keyword>subcmd</keyword>
      <keyword>flag</keyword>
      <keyword>arg</keyword>
      <keyword>and</keyword>
      <keyword>or</keyword>
      <keyword>not</keyword>
      <keyword>is</keyword>
      <keyword>is-not</keyword>
      <keyword>is-in</keyword>
      <keyword>is-not-in</keyword>
      <keyword>not-in</keyword>
      <keyword>contains</keyword>
      <keyword>starts-with</keyword>
      <keyword>ends-with</keyword>
      <keyword>band</keyword>
      <keyword>bor</keyword>
      <keyword>bxor</keyword>
      <keyword>bnot</keyword>
      <keyword>shl</keyword>
      <keyword>shr</keyword>
      <keyword>has</keyword>
      <keyword>handles</keyword>
      <keyword>when</keyword>
      <keyword>priority</keyword>
      <keyword>once</keyword>
      <keyword>where</keyword>
      <keyword>extend</keyword>
      <keyword>extends</keyword>
      <keyword>fulfills</keyword>
      <keyword>implements</keyword>
      <keyword>uses</keyword>
    </context>

    <context id="modifiers" style-ref="modifier">
      <keyword>shy</keyword>
      <keyword>private</keyword>
      <keyword>proud</keyword>
      <keyword>public</keyword>
      <keyword>guarded</keyword>
      <keyword>protected</keyword>
      <keyword>local</keyword>
      <keyword>sealed</keyword>
      <keyword>hollow</keyword>
      <keyword>abstract</keyword>
      <keyword>partial</keyword>
      <keyword>flags</keyword>
      <keyword>overrule</keyword>
      <keyword>override</keyword>
      <keyword>static</keyword>
      <keyword>shared</keyword>
      <keyword>hermit</keyword>
      <keyword>strict</keyword>
      <keyword>fluid</keyword>
      <keyword>leaky</keyword>
      <keyword>lazy</keyword>
      <keyword>fixed</keyword>
      <keyword>readonly</keyword>
      <keyword>vital</keyword>
      <keyword>required</keyword>
      <keyword>fading</keyword>
      <keyword>obsolete</keyword>
      <keyword>raw</keyword>
    </context>

    <context id="builtins" style-ref="builtin">
      <keyword>all</keyword>
      <keyword>alloc</keyword>
      <keyword>any</keyword>
      <keyword>append-file</keyword>
      <keyword>apropos</keyword>
      <keyword>as-file</keyword>
      <keyword>as</keyword>
      <keyword>assert</keyword>
      <keyword>async</keyword>
      <keyword>attempt</keyword>
      <keyword>average</keyword>
      <keyword>avg</keyword>
      <keyword>await</keyword>
      <keyword>back</keyword>
      <keyword>bar</keyword>
      <keyword>basename</keyword>
      <keyword>benchmark</keyword>
      <keyword>bg</keyword>
      <keyword>call-method</keyword>
      <keyword>call</keyword>
      <keyword>cartesian-product</keyword>
      <keyword>cast</keyword>
      <keyword>cat</keyword>
      <keyword>cd</keyword>
      <keyword>chain</keyword>
      <keyword>channel-close</keyword>
      <keyword>channel-recv</keyword>
      <keyword>channel-select</keyword>
      <keyword>channel-send</keyword>
      <keyword>channel</keyword>
      <keyword>chmod</keyword>
      <keyword>chown</keyword>
      <keyword>chunk</keyword>
      <keyword>clear</keyword>
      <keyword>clone</keyword>
      <keyword>close</keyword>
      <keyword>collect</keyword>
