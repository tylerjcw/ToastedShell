{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ToastedShell",
  "scopeName": "source.tosh",
  "patterns": [
    { "include": "#comment" },
    { "include": "#interpolated-string" },
    { "include": "#ansi-c-string" },
    { "include": "#double-quoted-string" },
    { "include": "#single-quoted-string" },
    { "include": "#command-substitution" },
    { "include": "#process-substitution" },
    { "include": "#class-definition" },
    { "include": "#module-definition" },
    { "include": "#enum-definition" },
    { "include": "#record-definition" },
    { "include": "#function-definition" },
    { "include": "#control-flow" },
    { "include": "#constants" },
    { "include": "#type-annotations" },
    { "include": "#variable-declaration" },
    { "include": "#variable-reference" },
    { "include": "#pipeline-underscore" },
    { "include": "#builtin-commands" },
    { "include": "#command-position" },
    { "include": "#operators" },
    { "include": "#pipe" },
    { "include": "#numeric" },
    { "include": "#flags" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.tosh"
    },

    "interpolated-string": {
      "name": "string.quoted.double.interpolated.tosh",
      "begin": "\\$\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.tosh" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.tosh" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tosh",
          "match": "\\\\(?:[\\\\\"'nrtabefv0]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4})"
        },
        {
          "name": "meta.interpolation.tosh",
          "begin": "(?<!\\{)\\{(?!\\{)",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.tosh" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.tosh" }
          },
          "contentName": "source.tosh.embedded",
          "patterns": [
            { "include": "source.tosh" }
          ]
        },
        {
          "name": "constant.character.escape.tosh",
          "match": "\\{\\{|\\}\\}"
        }
      ]
    },

    "ansi-c-string": {
      "name": "string.quoted.single.ansi-c.tosh",
      "begin": "\\$'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.tosh" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.tosh" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tosh",
          "match": "\\\\(?:[\\\\\"'abefnrtv0]|[eE]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4}|0[0-7]{1,3})"
        }
      ]
    },

    "double-quoted-string": {
      "name": "string.quoted.double.tosh",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.tosh" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.tosh" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tosh",
          "match": "\\\\(?:[\\\\\"'nrtabefv0]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4})"
        }
      ]
    },

    "single-quoted-string": {
      "name": "string.quoted.single.tosh",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.tosh" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.tosh" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tosh",
          "match": "\\\\(?:[\\\\\"'nrt])"
        }
      ]
    },

    "command-substitution": {
      "name": "meta.command-substitution.tosh",
      "begin": "\\$\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.tosh" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.tosh" }
      },
      "patterns": [
        { "include": "source.tosh" }
      ]
    },

    "process-substitution": {
      "name": "meta.process-substitution.input.tosh",
      "begin": "<\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.tosh" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.tosh" }
      },
      "patterns": [
        { "include": "source.tosh" }
      ]
    },

    "class-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(class)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.tosh" },
        "2": { "name": "keyword.control.tosh" },
        "3": { "name": "entity.name.type.class.tosh" }
      }
    },

    "module-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(module)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.tosh" },
        "2": { "name": "keyword.control.tosh" },
        "3": { "name": "entity.name.namespace.tosh" }
      }
    },

    "enum-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(enum)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.tosh" },
        "2": { "name": "keyword.control.tosh" },
        "3": { "name": "entity.name.type.enum.tosh" }
      }
    },

    "record-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(record)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.tosh" },
        "2": { "name": "keyword.control.tosh" },
        "3": { "name": "entity.name.type.record.tosh" }
      }
    },

    "function-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(func)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(?=\\(|=>)",
      "captures": {
        "1": { "name": "storage.modifier.tosh" },
        "2": { "name": "keyword.control.tosh" },
        "3": { "name": "entity.name.function.tosh" }
      }
    },

    "control-flow": {
      "match": "\\b(if|else|for|in|while|until|break|continue|return|throw|try|catch|finally|switch|case|default|match|func|var|alloc|class|module|enum|record|prop|shy|static|using|require|native|bind|from|as|out|ref|callconv|global|export|new|nameof|name-of|and|or|not|is|is-not|not-in)\\b",
      "name": "keyword.control.tosh"
    },

    "constants": {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.tosh"
    },

    "type-annotations": {
      "patterns": [
        {
          "comment": "Parameter type annotation:  name: Type  or  name?: Type",
          "match": "(?<=[a-zA-Z0-9_?])\\s*(:)\\s*([A-Za-z_][a-zA-Z0-9_.<>?]*)",
          "captures": {
            "1": { "name": "punctuation.separator.type.tosh" },
            "2": { "name": "entity.name.type.tosh" }
          }
        },
        {
          "comment": "Return type annotation:  -> Type",
          "match": "(->)\\s*([A-Za-z_][a-zA-Z0-9_.<>?]*)",
          "captures": {
            "1": { "name": "punctuation.separator.return-type.tosh" },
            "2": { "name": "entity.name.type.tosh" }
          }
        },
        {
          "comment": "Typed variable declaration:  Type name = ...",
          "match": "^\\s*([A-Z][a-zA-Z0-9_.<>]+)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==)",
          "captures": {
            "1": { "name": "entity.name.type.tosh" },
            "2": { "name": "variable.other.tosh" }
          }
        }
      ]
    },

    "variable-declaration": {
      "match": "\\b(?:(shy|global|export)\\s+)?(var|alloc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==|$)",
      "captures": {
        "1": { "name": "storage.modifier.tosh" },
        "2": { "name": "keyword.control.tosh" },
        "3": { "name": "variable.other.tosh" }
      }
    },

    "variable-reference": {
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.readwrite.tosh"
    },

    "pipeline-underscore": {
      "patterns": [
        {
          "comment": "_.Member access on current pipeline item",
          "match": "\\b(_)(\\.)[a-zA-Z_][a-zA-Z0-9_.()]*",
          "captures": {
            "1": { "name": "variable.language.pipeline-item.tosh" },
            "2": { "name": "punctuation.accessor.tosh" }
          }
        },
        {
          "comment": "Bare _ as current pipeline item",
          "match": "\\b_\\b",
          "name": "variable.language.pipeline-item.tosh"
        }
      ]
    },

    "builtin-commands": {
      "comment": "Tosh built-in commands — highlighted in command position",
          "match": "(?:^|(?<=\\|)\\s*|(?<=;)\\s*|(?<=\\{)\\s*)\\b(help|apropos|exit|clear|history|history-search|view|echo|write|writeline|pwd|cd|uname|hostname|whoami|id|ls|df|mounts|du|usage|disk-usage|free|uptime|stat|findmnt|find|readlink|realpath|dirname|basename|seq|sleep|ping|ip|lsblk|lscpu|lsfd|lsipc|ps|jobs|wait-for|kill|signal|env|which|whence|cat|read-file|read-lines|write-file|append-file|read-bytes|write-bytes|open-file|close|read-from|read-line-from|read-to-end|write-to|write-line-to|flush|seek|position|length|copy-to|head|tail|wc|uniq|cut|tr|grep|glob|from-json|from-csv|from-tsv|from-xml|parse|mkdir|mkdir-temp|tempfile|touch|rm|cp|mv|chmod|chown|ln|get|rename|inspect|where|each|first|last|skip|sort|sort-by|reverse|count|flatten|distinct|group-by|take-while|skip-while|tee|sum|average|avg|min|max|summarize|summary|date|timespan|to-json|to-csv|as-file|split|join-lines|replace|match|template|hash|exists|is-file|is-dir|is-link|type-of|describe-type|members|methods|constructors|types|load-assembly|read-buffer|write-buffer|size-of|offset-of|native-alloc|native-free|native-read|native-write|native-sizeof|native-offsetof|cast|new|call|export|forget|unset|xargs|source|has-prop|has-method|get-props|get-methods|get-prop|set-prop|del-prop|call-method|clone|nameof|name-of)\\b",
      "captures": {
        "1": { "name": "support.function.builtin.tosh" }
      }
    },

    "command-position": {
      "patterns": [
        {
          "comment": "Command at start of line (user functions, external commands)",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_-]*)(?=\\s|$|\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tosh" }
          }
        },
        {
          "comment": "Command after pipe",
          "match": "(?<=\\|)\\s*([a-zA-Z_][a-zA-Z0-9_-]*)(?=\\s|$|\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tosh" }
          }
        },
        {
          "comment": "Command after semicolon or opening brace",
          "match": "(?<=[;{])\\s*([a-zA-Z_][a-zA-Z0-9_-]*)(?=\\s|$|\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tosh" }
          }
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "match": "\\.\\.",
          "name": "keyword.operator.range.tosh"
        },
        {
          "match": "!~|=~|not-in|!=|>=|<=|==",
          "name": "keyword.operator.comparison.tosh"
        },
        {
          "match": ">>|<<<",
          "name": "keyword.operator.redirect.tosh"
        },
        {
          "match": "\\+=|-=|\\*=|/=|%=|[%><]",
          "name": "keyword.operator.tosh"
        },
        {
          "match": "(?<=\\s)\\?(?=\\s)|(?<=\\s):(?=\\s)",
          "name": "keyword.operator.conditional.tosh"
        },
        {
          "match": "=(?!=)",
          "name": "keyword.operator.assignment.tosh"
        }
      ]
    },

    "pipe": {
      "match": "\\|(?!\\|)",
      "name": "keyword.operator.pipe.tosh"
    },

    "numeric": {
      "patterns": [
        {
          "comment": "Storage sizes: 1kb, 512mb, etc.",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:b|kb|mb|gb|tb|pb)\\b",
          "name": "constant.numeric.size.tosh"
        },
        {
          "comment": "Temporal shorthand: 7d, 30m, 2h, 1w2d4h, 1mo, etc.",
          "match": "\\b(?:[0-9]+(?:\\.[0-9]+)?(?:ns|us|ms|s|m|h|d|w|mo|y|da|c|ka|Ma|Ga|Ta))+\\b",
          "name": "constant.numeric.duration.tosh"
        },
        {
          "comment": "ISO-like date literal",
          "match": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?:Z|[+-][0-9]{2}:[0-9]{2})?)?\\b",
          "name": "constant.numeric.datetime.tosh"
        },
        {
          "comment": "Float",
          "match": "\\b[0-9]+\\.[0-9]+\\b",
          "name": "constant.numeric.float.tosh"
        },
        {
          "comment": "Integer",
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.integer.tosh"
        }
      ]
    },

    "flags": {
      "patterns": [
        {
          "match": "\\s(--[a-zA-Z][a-zA-Z0-9-]*)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.flag.long.tosh" }
          }
        },
        {
          "match": "\\s(-[a-zA-Z][a-zA-Z0-9]*)\\b",
          "captures": {
            "1": { "name": "entity.other.attribute-name.flag.short.tosh" }
          }
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.section.block.tosh"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.section.brackets.tosh"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.tosh"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.tosh"
        },
        {
          "match": ",",
          "name": "punctuation.separator.tosh"
        }
      ]
    }
  }
}
