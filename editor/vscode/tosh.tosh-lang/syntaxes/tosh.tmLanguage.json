{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ToastedShell",
  "scopeName": "source.tosh",
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#doc-comment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#interpolated-string"
    },
    {
      "include": "#ansi-c-string"
    },
    {
      "include": "#double-quoted-string"
    },
    {
      "include": "#single-quoted-string"
    },
    {
      "include": "#command-substitution"
    },
    {
      "include": "#process-substitution"
    },
    {
      "include": "#class-definition"
    },
    {
      "include": "#module-definition"
    },
    {
      "include": "#enum-definition"
    },
    {
      "include": "#record-definition"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#control-flow"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#type-annotations"
    },
    {
      "include": "#variable-declaration"
    },
    {
      "include": "#spread-operator"
    },
    {
      "include": "#caret-escape"
    },
    {
      "include": "#variable-reference"
    },
    {
      "include": "#pipeline-underscore"
    },
    {
      "include": "#builtin-commands"
    },
    {
      "include": "#command-position"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#pipe"
    },
    {
      "include": "#numeric"
    },
    {
      "include": "#flags"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "shebang": {
      "match": "^#!.*$",
      "name": "comment.line.shebang.tosh"
    },
    "doc-comment": {
      "patterns": [
        {
          "comment": "Doc comment with @param=name tag",
          "name": "comment.line.documentation.tosh",
          "match": "(##)\\s*(@param=)([a-zA-Z_][a-zA-Z0-9_]*)(.*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.documentation.tosh"
            },
            "2": {
              "name": "storage.type.annotation.tosh"
            },
            "3": {
              "name": "variable.parameter.tosh"
            }
          }
        },
        {
          "comment": "Doc comment with @tag",
          "name": "comment.line.documentation.tosh",
          "match": "(##)\\s*(@(?:param|returns|example|see))\\b(.*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.documentation.tosh"
            },
            "2": {
              "name": "storage.type.annotation.tosh"
            }
          }
        },
        {
          "comment": "Plain doc comment",
          "name": "comment.line.documentation.tosh",
          "match": "##.*$"
        }
      ]
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.tosh"
    },
    "interpolated-string": {
      "name": "string.quoted.double.interpolated.tosh",
      "begin": "\\$\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tosh"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tosh"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tosh",
          "match": "\\\\(?:[\\\\\"'nrtabefv0]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4})"
        },
        {
          "comment": "Dollar-brace interpolation: ${expr}",
          "name": "meta.interpolation.tosh",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.tosh"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.tosh"
            }
          },
          "contentName": "source.tosh.embedded",
          "patterns": [
            {
              "include": "source.tosh"
            }
          ]
        },
        {
          "comment": "Bare brace interpolation: {expr}",
          "name": "meta.interpolation.tosh",
          "begin": "(?<!\\{)\\{(?!\\{)",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.tosh"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.tosh"
            }
          },
          "contentName": "source.tosh.embedded",
          "patterns": [
            {
              "include": "source.tosh"
            }
          ]
        },
        {
          "comment": "Bare variable interpolation: $name or $env.HOME",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*",
          "name": "variable.other.readwrite.tosh"
        },
        {
          "name": "constant.character.escape.tosh",
          "match": "\\{\\{|\\}\\}"
        }
      ]
    },
    "ansi-c-string": {
      "name": "string.quoted.single.ansi-c.tosh",
      "begin": "\\$'",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tosh"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tosh"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tosh",
          "match": "\\\\(?:[\\\\\"'abefnrtv0]|[eE]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4}|0[0-7]{1,3})"
        }
      ]
    },
    "double-quoted-string": {
      "name": "string.quoted.double.tosh",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tosh"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tosh"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tosh",
          "match": "\\\\(?:[\\\\\"'nrtabefv0]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4})"
        }
      ]
    },
    "single-quoted-string": {
      "comment": "Single-quoted strings are literal — no escape sequences or interpolation",
      "name": "string.quoted.single.tosh",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tosh"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tosh"
        }
      }
    },
    "command-substitution": {
      "name": "meta.command-substitution.tosh",
      "begin": "\\$\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.tosh"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.tosh"
        }
      },
      "patterns": [
        {
          "include": "source.tosh"
        }
      ]
    },
    "process-substitution": {
      "name": "meta.process-substitution.input.tosh",
      "begin": "<\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.tosh"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.tosh"
        }
      },
      "patterns": [
        {
          "include": "source.tosh"
        }
      ]
    },
    "class-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(class)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.tosh"
        },
        "2": {
          "name": "keyword.control.tosh"
        },
        "3": {
          "name": "entity.name.type.class.tosh"
        }
      }
    },
    "module-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(module)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.tosh"
        },
        "2": {
          "name": "keyword.control.tosh"
        },
        "3": {
          "name": "entity.name.namespace.tosh"
        }
      }
    },
    "enum-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(enum)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.tosh"
        },
        "2": {
          "name": "keyword.control.tosh"
        },
        "3": {
          "name": "entity.name.type.enum.tosh"
        }
      }
    },
    "record-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(record)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.tosh"
        },
        "2": {
          "name": "keyword.control.tosh"
        },
        "3": {
          "name": "entity.name.type.record.tosh"
        }
      }
    },
    "function-definition": {
      "match": "\\b(?:(shy|global|export)\\s+)?(func)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(?=\\(|=>)",
      "captures": {
        "1": {
          "name": "storage.modifier.tosh"
        },
        "2": {
          "name": "keyword.control.tosh"
        },
        "3": {
          "name": "entity.name.function.tosh"
        }
      }
    },
    "control-flow": {
      "match": "\\b(if|else|for|in|while|until|break|continue|return|throw|try|catch|finally|switch|case|default|match|func|var|alloc|class|module|enum|record|prop|shy|static|using|require|native|bind|from|as|out|ref|callconv|global|export|new|nameof|name-of|and|or|not|is|is-not|not-in|handles|when)\\b",
      "name": "keyword.control.tosh"
    },
    "constants": {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.tosh"
    },
    "type-annotations": {
      "patterns": [
        {
          "comment": "Parameter type annotation:  name: Type  or  name?: Type",
          "match": "(?<=[a-zA-Z0-9_?])\\s*(:)\\s*([A-Za-z_][a-zA-Z0-9_.<>?]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.tosh"
            },
            "2": {
              "name": "entity.name.type.tosh"
            }
          }
        },
        {
          "comment": "Return type annotation:  -> Type",
          "match": "(->)\\s*([A-Za-z_][a-zA-Z0-9_.<>?]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.return-type.tosh"
            },
            "2": {
              "name": "entity.name.type.tosh"
            }
          }
        },
        {
          "comment": "Typed variable declaration:  Type name = ...",
          "match": "^\\s*([A-Z][a-zA-Z0-9_.<>]+)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==)",
          "captures": {
            "1": {
              "name": "entity.name.type.tosh"
            },
            "2": {
              "name": "variable.other.tosh"
            }
          }
        }
      ]
    },
    "variable-declaration": {
      "match": "\\b(?:(shy|global|export)\\s+)?(var|alloc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==|$)",
      "captures": {
        "1": {
          "name": "storage.modifier.tosh"
        },
        "2": {
          "name": "keyword.control.tosh"
        },
        "3": {
          "name": "variable.other.tosh"
        }
      }
    },
    "spread-operator": {
      "comment": "Spread / splat operator: ...$args",
      "match": "(\\.\\.\\.)(\\$[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
      "captures": {
        "1": {
          "name": "keyword.operator.spread.tosh"
        },
        "2": {
          "name": "variable.other.readwrite.tosh"
        }
      }
    },
    "caret-escape": {
      "comment": "Force external command: ^command",
      "match": "(\\^)(?=[a-zA-Z_$\\/])",
      "captures": {
        "1": {
          "name": "keyword.operator.caret-escape.tosh"
        }
      }
    },
    "variable-reference": {
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*",
      "name": "variable.other.readwrite.tosh"
    },
    "pipeline-underscore": {
      "patterns": [
        {
          "comment": "_.Member access on current pipeline item",
          "match": "\\b(_)(\\.)[a-zA-Z_][a-zA-Z0-9_.()]*",
          "captures": {
            "1": {
              "name": "variable.language.pipeline-item.tosh"
            },
            "2": {
              "name": "punctuation.accessor.tosh"
            }
          }
        },
        {
          "comment": "Bare _ as current pipeline item",
          "match": "\\b_\\b",
          "name": "variable.language.pipeline-item.tosh"
        }
      ]
    },
    "builtin-commands": {
      "comment": "Tosh built-in commands — highlighted in command position",
      "match": "(?:^|(?<=\\|)\\s*|(?<=;)\\s*|(?<=\\{)\\s*)\\b(all|alloc|any|append-file|apropos|as-file|assert|avg|back|basename|bg|call|call-method|cast|cat|cd|chmod|chown|chunk|clear|clone|close|collect|compose|config|constructors|converge|copy-to|count|cp|curry|cut|date|del-prop|describe-type|df|dirname|dirs|distinct|du|each|echo|env|events|exec|exists|exit|export|fg|filter|find|find-index|findmnt|first|flat-map|flatten|flush|forward|free|frequencies|from|get|get-methods|get-prop|get-props|glob|grep|group-by|group-while|guid|has-method|has-prop|hash|head|help|history|history-search|hostname|hostnamectl|http|id|ignore|inspect|interleave|invoke|ip|is-dir|is-file|is-link|iterate|jobs|join-lines|journalctl|kill|last|length|lines|ln|load-assembly|loginctl|ls|lsblk|lscpu|lsfd|lsipc|map|match|max|members|methods|min|mkdir|mkdir-temp|mv|native-free|native-read|native-write|networkctl|new|none|offset-of|open-file|parse|partial|partition|pick|ping|position|prompt-dir|prompt-duration|prompt-exit|prompt-git|prompt-history|prompt-jobs|prompt-newline|prompt-text|prompt-time|prompt-userhost|ps|pwd|raise|raw|read-bytes|read-file|read-from|read-line|read-line-from|read-lines|read-to-end|readlink|realpath|reduce|rename|replace|reverse|rm|scan|seek|select|seq|set-prop|signal|size-of|skip|skip-until|skip-while|sleep|sort|split|stat|styled|sum|summary|systemctl|tail|take-until|take-while|tee|tempfile|template|time|timespan|to|touch|tr|transpose|tree|tui|type-of|types|ulimit|umask|uname|unfold|uniq|unset|uptime|vars|view|wait-for|wc|where|which|whoami|window|write|write-bytes|write-file|write-line-to|write-to|writeline|xargs|zip)\\b",
      "captures": {
        "1": {
          "name": "support.function.builtin.tosh"
        }
      }
    },
    "command-position": {
      "patterns": [
        {
          "comment": "Command at start of line (user functions, external commands)",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_-]*)(?=\\s|$|\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.tosh"
            }
          }
        },
        {
          "comment": "Command after pipe",
          "match": "(?<=\\|)\\s*([a-zA-Z_][a-zA-Z0-9_-]*)(?=\\s|$|\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.tosh"
            }
          }
        },
        {
          "comment": "Command after semicolon or opening brace",
          "match": "(?<=[;{])\\s*([a-zA-Z_][a-zA-Z0-9_-]*)(?=\\s|$|\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.tosh"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Match arm arrow: pattern => result",
          "match": "=>",
          "name": "keyword.operator.arrow.tosh"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.range.tosh"
        },
        {
          "match": "!~|=~|not-in|!=|>=|<=|==",
          "name": "keyword.operator.comparison.tosh"
        },
        {
          "match": ">>|<<<",
          "name": "keyword.operator.redirect.tosh"
        },
        {
          "match": "\\+=|-=|\\*=|/=|%=|[%><]",
          "name": "keyword.operator.tosh"
        },
        {
          "match": "(?<=\\s)\\?(?=\\s)|(?<=\\s):(?=\\s)",
          "name": "keyword.operator.conditional.tosh"
        },
        {
          "match": "=(?!=|>)",
          "name": "keyword.operator.assignment.tosh"
        }
      ]
    },
    "pipe": {
      "match": "\\|(?!\\|)",
      "name": "keyword.operator.pipe.tosh"
    },
    "numeric": {
      "patterns": [
        {
          "comment": "Storage sizes: 1kb, 512mb, etc. (with optional _ separators)",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:b|kb|mb|gb|tb|pb)\\b",
          "name": "constant.numeric.size.tosh"
        },
        {
          "comment": "Temporal shorthand: 7d, 30m, 2h, 1w2d4h, 1mo, etc. (with optional _ separators)",
          "match": "\\b(?:[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:ns|us|ms|s|m|h|d|w|mo|y|da|c|ka|Ma|Ga|Ta))+\\b",
          "name": "constant.numeric.duration.tosh"
        },
        {
          "comment": "ISO-like date literal",
          "match": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?:Z|[+-][0-9]{2}:[0-9]{2})?)?\\b",
          "name": "constant.numeric.datetime.tosh"
        },
        {
          "comment": "Hexadecimal integer: 0xFF, 0x1A_2B",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b",
          "name": "constant.numeric.hex.tosh"
        },
        {
          "comment": "Binary integer: 0b1010, 0b1111_0000",
          "match": "\\b0[bB][01][01_]*\\b",
          "name": "constant.numeric.binary.tosh"
        },
        {
          "comment": "Octal integer: 0o77, 0o755",
          "match": "\\b0[oO][0-7][0-7_]*\\b",
          "name": "constant.numeric.octal.tosh"
        },
        {
          "comment": "Float (with optional _ separators)",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b",
          "name": "constant.numeric.float.tosh"
        },
        {
          "comment": "Integer (with optional _ separators)",
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.integer.tosh"
        }
      ]
    },
    "flags": {
      "patterns": [
        {
          "match": "\\s(--[a-zA-Z][a-zA-Z0-9-]*)\\b",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.flag.long.tosh"
            }
          }
        },
        {
          "match": "\\s(-[a-zA-Z][a-zA-Z0-9]*)\\b",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.flag.short.tosh"
            }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.section.block.tosh"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.section.brackets.tosh"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.tosh"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.tosh"
        },
        {
          "match": ",",
          "name": "punctuation.separator.tosh"
        }
      ]
    }
  }
}