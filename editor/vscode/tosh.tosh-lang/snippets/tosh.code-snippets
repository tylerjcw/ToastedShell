{
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Define a TōSh function"
  },
  "Function Wrapper": {
    "prefix": "func=>",
    "body": [
      "func ${1:name} => ${2:command}"
    ],
    "description": "Define a simple command-wrapper function"
  },
  "Exported Function": {
    "prefix": "export-func",
    "body": [
      "export func ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Define a function exported from a required module"
  },
  "Variable": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value}"
    ],
    "description": "Declare a variable"
  },
  "Config Set": {
    "prefix": "config-set",
    "body": [
      "config set ${1:prompt.name-text} ${2:toast}"
    ],
    "description": "Set a TōSh runtime configuration value"
  },
  "Config Variable": {
    "prefix": "config-var",
    "body": [
      "$tosh.Config.${1:Prompt}.${2:NameText} = ${3:\"toast\"}"
    ],
    "description": "Mutate the live TōSh configuration object"
  },
  "Theme Variable": {
    "prefix": "theme-var",
    "body": [
      "$tosh.Config.Theme.${1:Syntax}.${2:Keyword}.${3:Foreground} = ${4:\"bright-magenta\"}"
    ],
    "description": "Customize the live TōSh theme object"
  },
  "Config Init": {
    "prefix": "config-init",
    "body": [
      "config init${1:}"
    ],
    "description": "Scaffold a TōSh config directory"
  },
  "Config Reload": {
    "prefix": "config-reload",
    "body": [
      "config reload"
    ],
    "description": "Replay config.tosh, profile.tosh, and autoload files in the current session"
  },
  "View Permissions": {
    "prefix": "view-perms",
    "body": [
      "view permissions ${1:both}"
    ],
    "description": "Set Unix permission rendering mode for the current session"
  },
  "View Attributes": {
    "prefix": "view-attrs",
    "body": [
      "view attributes ${1:hex}"
    ],
    "description": "Set file-attribute rendering mode for the current session"
  },
  "Allocated Variable": {
    "prefix": "varalloc",
    "body": [
      "var ${1:name}"
    ],
    "description": "Declare an allocated variable without an initial value"
  },
  "Alloc Native Buffer": {
    "prefix": "alloc",
    "body": [
      "alloc ${1:buffer} = ${2:256}"
    ],
    "description": "Allocate a native buffer by byte count or interop type"
  },
  "Write Buffer": {
    "prefix": "write-buffer",
    "body": [
      "write-buffer ${1:$buffer} ${2:\"toast\"}"
    ],
    "description": "Write text, bytes, or a struct-layout value into native memory"
  },
  "Read Buffer": {
    "prefix": "read-buffer",
    "body": [
      "read-buffer ${1:cstring} ${2:$buffer}"
    ],
    "description": "Read a cstring, byte range, or struct-layout value from native memory"
  },
  "Record Literal": {
    "prefix": "record-literal",
    "body": [
      "var ${1:name} = {|",
      "\t${2:field} = ${3:value}",
      "|}"
    ],
    "description": "Anonymous record literal — {| ... |}"
  },
  "Dictionary Literal": {
    "prefix": "dict-literal",
    "body": [
      "var ${1:name} = {% ${2:\"key\"} => ${3:value} %}"
    ],
    "description": "Dictionary literal with arbitrary keys — {% ... %}"
  },
  "Set Literal": {
    "prefix": "set-literal",
    "body": [
      "var ${1:name} = {: ${2:1}, ${3:2} :}"
    ],
    "description": "Set literal — {: ... :}"
  },
  "Generic List": {
    "prefix": "newlist",
    "body": [
      "var ${1:name} = new list<${2:string}>(${3})"
    ],
    "description": "Construct a typed TōSh list"
  },
  "Generic Dictionary": {
    "prefix": "newdict",
    "body": [
      "var ${1:name} = new dict<${2:string}, ${3:int}>(${4:key}, ${5:value})"
    ],
    "description": "Construct a typed TōSh dictionary"
  },
  "Generic Array": {
    "prefix": "newarray",
    "body": [
      "var ${1:name} = new array<${2:int}>(${3})"
    ],
    "description": "Construct a typed TōSh array"
  },
  "Require Module": {
    "prefix": "require",
    "body": [
      "require ${1:\"./module.tosh\"}"
    ],
    "description": "Require a TōSh module, DLL, or project"
  },
  "Require Native Library": {
    "prefix": "require-native",
    "body": [
      "require native ${1:\"libc.so.6\"} as ${2:LibC}"
    ],
    "description": "Load a native shared library into a named TōSh module"
  },
  "Bind Native Functions": {
    "prefix": "bind-native",
    "body": [
      "bind ${1:LibC} {",
      "\tfunc ${2:abs}(${3:int}) -> ${4:int}",
      "}"
    ],
    "description": "Bind native exports onto a required native library module"
  },
  "Bind Native Out Struct": {
    "prefix": "bind-native-out",
    "body": [
      "bind ${1:LibC} {",
      "\tfunc ${2:time}(out ${3:value}: ${4:long}) -> ${5:long}",
      "}"
    ],
    "description": "Bind a native export with an output parameter"
  },
  "Using Alias": {
    "prefix": "using",
    "body": [
      "using ${1:System.IO} = ${2:IO}"
    ],
    "description": "Import a CLR namespace with an alias"
  },
  "If Else": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If / else block"
  },
  "Ternary": {
    "prefix": "ternary",
    "body": [
      "var ${1:name} = (${2:condition}) ? ${3:whenTrue} : ${4:whenFalse}"
    ],
    "description": "Conditional ternary expression"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match (${1:value}) {",
      "\t${2:pattern} => ${3:result}",
      "\tdefault => ${4:fallback}",
      "}"
    ],
    "description": "Expression-style match with ordered arms"
  },
  "Try Catch Finally": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:err}) {",
      "\t$3",
      "} finally {",
      "\t$0",
      "}"
    ],
    "description": "Try / catch / finally block"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in (${2:source}) {",
      "\t$0",
      "}"
    ],
    "description": "For loop"
  },
  "Where Block": {
    "prefix": "where",
    "body": [
      "where {",
      "\t$0",
      "}"
    ],
    "description": "Where predicate block"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "\tcase ${2:match} {",
      "\t\t$3",
      "\t}",
      "\tdefault {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Switch statement"
  },
  "Class with Props": {
    "prefix": "class",
    "body": [
      "${1|shy,global,export|} class ${2:Name} {",
      "\tprop ${3:Field}: ${4:string}",
      "",
      "\tfunc new(${5:field}: ${4:string}) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Define a class with a property and constructor"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Member1}",
      "\t${3:Member2}",
      "\t$0",
      "}"
    ],
    "description": "Define an enum with members"
  },
  "Record Definition": {
    "prefix": "record-type",
    "body": [
      "record ${1:Name}(${2:field}: ${3:string})"
    ],
    "description": "Define a named record type"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Until Loop": {
    "prefix": "until",
    "body": [
      "until (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "Until loop"
  },
  "Each Block": {
    "prefix": "each",
    "body": [
      "each {",
      "\t$0",
      "}"
    ],
    "description": "Each iterator block"
  },
  "Pipeline Filter Transform": {
    "prefix": "pipe-filter",
    "body": [
      "| where { ${1:_.Property} ${2|==,!=,>,<,>=,<=|} ${3:value} } | each { $0 }"
    ],
    "description": "Pipeline with where filter and each transform"
  },
  "Pipeline Sort Take": {
    "prefix": "pipe-sort",
    "body": [
      "| sort ${1:Property} | first ${2:10}"
    ],
    "description": "Pipeline with sort and take first N"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:IName} {",
      "\tfunc ${2:method-name}(${3})${4: -> ${5:Type}}",
      "\t$0",
      "}"
    ],
    "description": "Define an interface"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}(${2:fields}) {",
      "\t$0",
      "}"
    ],
    "description": "Define a value-type struct"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Define a trait"
  },
  "Union": {
    "prefix": "union",
    "body": [
      "union ${1:Name} {",
      "\tcase ${2:Variant}",
      "\t$0",
      "}"
    ],
    "description": "Define a tagged union"
  },
  "Rune": {
    "prefix": "rune",
    "body": [
      "rune ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Define a rune (parse-time macro)"
  },
  "Event": {
    "prefix": "event",
    "body": [
      "event ${1:name}"
    ],
    "description": "Declare an event"
  },
  "Generic Class": {
    "prefix": "class<T>",
    "body": [
      "class ${1:Name}<${2:T}>(${3:initial}: ${2:T}) where ${2:T}: ${4:Numeric} {",
      "\tprop value: ${2:T} = \\$${3:initial}",
      "\t$0",
      "}"
    ],
    "description": "Generic class with type-parameter constraint"
  },
  "Generic Function": {
    "prefix": "func<T>",
    "body": [
      "func ${1:name}<${2:T}>(${3:x}: ${2:T}) -> ${2:T}",
      "\twhere ${2:T}: ${4:Numeric}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Generic function with constraint clause"
  },
  "Defer Block": {
    "prefix": "defer",
    "body": [
      "defer {",
      "\t$0",
      "}"
    ],
    "description": "Schedule a block for scope-exit cleanup"
  },
  "Fat-Arrow Method": {
    "prefix": "method=>",
    "body": [
      "func ${1:name}(${2}) => ${3:expression}"
    ],
    "description": "One-liner fat-arrow method body"
  },
  "Class Fulfills Interface": {
    "prefix": "class-fulfills",
    "body": [
      "class ${1:Name}(${2}) fulfills ${3:IShape} {",
      "\toverrule func ${4:method}(${5}) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Class that fulfills an interface"
  },
  "Class Extends": {
    "prefix": "class-extends",
    "body": [
      "class ${1:Derived}(${2}) extends ${3:Base} {",
      "\t$0",
      "}"
    ],
    "description": "Class with base-class inheritance"
  },
  "Const": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value}"
    ],
    "description": "Declare a constant"
  },
  "Yield": {
    "prefix": "yield",
    "body": [
      "yield ${1:value}"
    ],
    "description": "Emit a value from a generator function"
  },
  "Doc Comment": {
    "prefix": "doc",
    "body": [
      "## ${1:Summary of what this does.}",
      "## @param=${2:name} ${3:What it is for.}",
      "## @returns ${4:What comes back.}"
    ],
    "description": "Doc comment block above a declaration"
  },
  "Doc Comment with Example": {
    "prefix": "doc-example",
    "body": [
      "## ${1:Summary of what this does.}",
      "## @param=${2:name} ${3:What it is for.}",
      "## @returns ${4:What comes back.}",
      "## @example",
      "##   ${5:usage here}",
      "## @since ${6:26.7}"
    ],
    "description": "Doc comment with a worked example and @since"
  },
  "Block Comment": {
    "prefix": "comment-block",
    "body": [
      "##{",
      "${1:Notes that span lines.}",
      "}##"
    ],
    "description": "Multi-line block comment — ##{ ... }##"
  },
  "Module": {
    "prefix": "module",
    "body": [
      "module ${1:Name} {",
      "\texport func ${2:name}(${3}) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Define a named module with an exported function"
  },
  "Subcommand": {
    "prefix": "subcommand",
    "body": [
      "subcommand ${1:name} {",
      "\targ  ${2:target}: ${3:string}",
      "\tflag ${4:dry-run}: bool = false",
      "\t$0",
      "}"
    ],
    "description": "Declare a subcommand with a positional arg and a flag"
  },
  "Refinement Type": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = ${2:int} where (${3:_ > 0})"
    ],
    "description": "Refinement type constrained by a predicate"
  },
  "Refinement Type Block": {
    "prefix": "type-block",
    "body": [
      "type ${1:Name} = ${2:string} {",
      "\twhere ${3:_ != \"\"}",
      "\tcoerce ${4:\"fallback\"}",
      "}"
    ],
    "description": "Block-form refinement type with a coerce fallback"
  },
  "Property with Accessors": {
    "prefix": "prop-get-set",
    "body": [
      "prop ${1:Name}: ${2:string} {",
      "\tget { return $${3:_backing} }",
      "\tset { $${3:_backing} = $value }",
      "}"
    ],
    "description": "Property with explicit getter and setter"
  },
  "Event Handler": {
    "prefix": "handles",
    "body": [
      "func ${1:on-event}(${2:event}) handles ${3:EventName} {",
      "\t$0",
      "}"
    ],
    "description": "Register a method as an event handler"
  },
  "Comprehension": {
    "prefix": "comprehension",
    "body": [
      "[$${1:x} <| for ${1:x} in ${2:1..10} where ${3:($$1 % 2) == 0}]"
    ],
    "description": "List comprehension — body first, then <| and clauses"
  },
  "Match Arms": {
    "prefix": "match-arms",
    "body": [
      "match ($${1:value}) {",
      "\t${2:pattern} => ${3:result}",
      "\t${4:other} when ${5:guard} => ${6:result}",
      "\tdefault => ${7:fallback}",
      "}"
    ],
    "description": "Match expression with a guarded arm"
  },
  "Async / Await": {
    "prefix": "async",
    "body": [
      "var ${1:handle} = async { $0 }",
      "await $${1:handle}"
    ],
    "description": "Start work in the background and await it"
  },
  "Channel": {
    "prefix": "channel",
    "body": [
      "var ${1:ch} = channel",
      "channel-send $${1:ch} ${2:value}",
      "channel-close $${1:ch}",
      "channel-recv $${1:ch}"
    ],
    "description": "Create, send on, close and drain a channel"
  },
  "Redirect Output": {
    "prefix": "redirect",
    "body": [
      "${1:command} out> ${2:./out.txt}"
    ],
    "description": "Named-stream redirection (out>, err>, o+e>)"
  },
  "Region": {
    "prefix": "region",
    "body": [
      "# region ${1:Name}",
      "$0",
      "# endregion"
    ],
    "description": "Foldable region marker"
  }
}